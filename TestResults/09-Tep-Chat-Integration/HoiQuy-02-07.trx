22 aria-label=\u0022\u0110\u01B0\u1EDDng d\u1EABn\u0022\u003E\r\n        \u003Col\u003E\r\n                \u003Cli\u003E\u003Ca href=\u0022/\u0022\u003ETrang ch\u1EE7\u003C/a\u003E\u003C/li\u003E\r\n                \u003Cli\u003E\u003Cspan aria-current=\u0022page\u0022\u003ET\u0026#xEC;m ki\u0026#x1EBF;m\u003C/span\u003E\u003C/li\u003E\r\n        \u003C/ol\u003E\r\n    \u003C/nav\u003E\r\n    \u003C/div\u003E\r\n    \u003Cdiv class=\u0022header-actions\u0022\u003E\r\n        \u003Ca data-modal href=\u0022/Home/ThongBao\u0022 class=\u0022notification\u0022 aria-label=\u0022Th\u00F4ng b\u00E1o\u0022\u003E\r\n            \u003Cimg src=\u0022/images/ui/bell.svg\u0022 alt=\u0022\u0022\u003E\r\n            \u003Cspan class=\u0022notification-label\u0022\u003ETh\u00F4ng b\u00E1o\u003C/span\u003E\r\n            \u003Cb id=\u0022notification-badge\u0022 hidden=\u0022hidden\u0022 aria-label=\u00220 th\u00F4ng b\u00E1o ch\u01B0a \u0111\u1ECDc\u0022\u003E0\u003C/b\u003E\r\n        \u003C/a\u003E\r\n        \u003Cform action=\u0022/TaiKhoan/DangXuat\u0022 method=\u0022post\u0022 class=\u0022logout-form\u0022\u003E\r\n            \u003Cinput name=\u0022__RequestVerificationToken\u0022 type=\u0022hidden\u0022 value=\u0022[redacted]\u0022 /\u003E\r\n            \u003Cbutton class=\u0022btn btn-outline-primary\u0022 type=\u0022submit\u0022\u003E\u0110\u0103ng xu\u1EA5t\u003C/button\u003E\r\n        \u003C/form\u003E\r\n    \u003C/div\u003E\r\n\u003C/header\u003E\u003Cmain class=\u0022container-fluid\u0022\u003E\r\n\u003Cdiv class=\u0022notification-rail\u0022 data-notification-rail hidden=\u0022hidden\u0022\u003E\r\n    \u003Cdiv class=\u0022notification-message\u0022 data-notification hidden=\u0022hidden\u0022\u003E\r\n        \u003Cspan class=\u0022notification-text\u0022 role=\u0022status\u0022 aria-live=\u0022polite\u0022 aria-atomic=\u0022true\u0022 data-notification-text\u003E\u003C/span\u003E\r\n        \u003Cbutton type=\u0022button\u0022 class=\u0022notification-close\u0022 data-notification-close aria-label=\u0022\u0110\u00F3ng th\u00F4ng b\u00E1o\u0022\u003E\u00D7\u003C/button\u003E\r\n    \u003C/div\u003E\r\n\u003C/div\u003E\r\n\r\n\r\n\r\n\u003Cdiv id=\u0022search-content\u0022 data-ajax-page=\u0022search\u0022\u003E\u003Ch1\u003ET\u0026#xEC;m gia s\u0026#x1B0;\u003C/h1\u003E\u003Cp\u003EM\u0026#x1ED7;i gia s\u0026#x1B0; c\u0026#xF3; m\u0026#x1ED9;t h\u0026#x1ED3; s\u0026#x1A1;, nhi\u0026#x1EC1;u m\u0026#xF4;n v\u0026#xE0; m\u0026#x1EE9;c ph\u0026#xED; ri\u0026#xEA;ng.\u003C/p\u003E\r\n\u003Cform method=\u0022get\u0022 id=\u0022search-filters\u0022\u003E\u003Cdiv class=\u0022searchbox search-keyword\u0022\u003E\u003Cinput class=\u0022form-control\u0022 name=\u0022TuKhoa\u0022 maxlength=\u0022100\u0022 value=\u0022IT0203IT_c275c8f5db9b4cc285b6132f6f2870db\u0022 aria-label=\u0022T\u1EEB kh\u00F3a\u0022 placeholder=\u0022T\u00EAn, m\u00F4n h\u1ECDc ho\u1EB7c chuy\u00EAn m\u00F4n\u0022\u003E\u003Cbutton class=\u0022btn btn-primary\u0022\u003ET\u00ECm ki\u1EBFm\u003C/button\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022card search-filter-panel\u0022\u003E\u003Cdiv class=\u0022search-basic-grid\u0022\u003E\u003Clabel\u003EM\u00F4n h\u1ECDc\u003Cselect class=\u0022form-select\u0022 name=\u0022MonHocId\u0022\u003E\u003Coption value=\u0022\u0022\u003ET\u1EA5t c\u1EA3 m\u00F4n\u003C/option\u003E\u003Coption value=\u00227\u0022\u003E\u0026#x110;\u0026#x1ECB;a L\u0026#xFD;\u003C/option\u003E\u003Coption value=\u00229\u0022\u003EGDCD\u003C/option\u003E\u003Coption value=\u00225\u0022\u003EH\u0026#xF3;a H\u0026#x1ECD;c\u003C/option\u003E\u003Coption value=\u00226\u0022\u003EL\u0026#x1ECB;ch S\u0026#x1EED;\u003C/option\u003E\u003Coption value=\u00222\u0022\u003ENg\u0026#x1EEF; V\u0026#x103;n\u003C/option\u003E\u003Coption value=\u00228\u0022\u003ESinh h\u0026#x1ECD;c\u003C/option\u003E\u003Coption value=\u00223\u0022\u003ETi\u0026#x1EBF;ng Anh\u003C/option\u003E\u003Coption value=\u00221\u0022\u003ETo\u0026#xE1;n H\u0026#x1ECD;c\u003C/option\u
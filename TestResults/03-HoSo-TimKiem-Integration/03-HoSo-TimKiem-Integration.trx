1\u0022\u003E\u003C/label\u003E\u003Clabel\u003E\u0110\u01A1n v\u1ECB h\u1ECDc ph\u00ED\u003Cselect class=\u0022form-select\u0022 name=\u0022DonViHocPhi\u0022\u003E\u003Coption value=\u0022VND/Gio\u0022 selected=\u0022selected\u0022\u003EVND / gi\u1EDD\u003C/option\u003E\u003Coption value=\u0022VND/Buoi\u0022\u003EVND / bu\u1ED5i\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\r\n\u003Clabel\u003ETr\u00ECnh \u0111\u1ED9\u003Cinput class=\u0022form-control\u0022 name=\u0022TrinhDo\u0022 maxlength=\u0022256\u0022\u003E\u003C/label\u003E\u003C/div\u003E\u003C/details\u003E\u003Cdiv class=\u0022actions\u0022\u003E\u003Cbutton class=\u0022btn btn-primary\u0022\u003E\u00C1p d\u1EE5ng b\u1ED9 l\u1ECDc\u003C/button\u003E\u003Ca class=\u0022btn btn-outline-primary\u0022 href=\u0022/TimKiem/TimKiem\u0022\u003EX\u00F3a b\u1ED9 l\u1ECDc\u003C/a\u003E\u003C/div\u003E\u003C/div\u003E\u003C/form\u003E\r\n\u003Cdiv class=\u0022search-results-toolbar\u0022\u003E\u003Ch2\u003E1 gia s\u0026#x1B0;\u003C/h2\u003E\u003Clabel\u003ES\u1EAFp x\u1EBFp\u003Cselect class=\u0022form-select\u0022 name=\u0022SapXep\u0022 form=\u0022search-filters\u0022 data-search-sort\u003E\u003Coption value=\u0022MoiNhat\u0022 selected=\u0022selected\u0022\u003EM\u0026#x1EDB;i nh\u0026#x1EA5;t\u003C/option\u003E\u003Coption value=\u0022Ten\u0022\u003ET\u0026#xEA;n\u003C/option\u003E\u003Coption value=\u0022HocPhiTang\u0022\u003EH\u0026#x1ECD;c ph\u0026#xED; t\u0026#x103;ng\u003C/option\u003E\u003Coption value=\u0022HocPhiGiam\u0022\u003EH\u0026#x1ECD;c ph\u0026#xED; gi\u0026#x1EA3;m\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\u003C/div\u003E\r\n\u003Cnav class=\u0022active-filters\u0022 aria-label=\u0022B\u1ED9 l\u1ECDc \u0111ang \u00E1p d\u1EE5ng\u0022\u003E\r\n \u003Ca href=\u0022/TimKiem/TimKiem/Tim?MonHocId=206\u0022 aria-label=\u0022B\u1ECF b\u1ED9 l\u1ECDc IT0203IT_75cffe72cb1d478b9b4f09cb118c8bf9\u0022\u003EIT0203IT_75cffe72cb1d478b9b4f09cb118c8bf9 \u003Cspan aria-hidden=\u0022true\u0
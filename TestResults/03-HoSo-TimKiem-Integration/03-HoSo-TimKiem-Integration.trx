ion value=\u0022\u0022\u003ET\u1EA5t c\u1EA3\u003C/option\u003E\u003Coption value=\u0022TrucTuyen\u0022\u003ETr\u1EF1c tuy\u1EBFn\u003C/option\u003E\u003Coption value=\u0022TrucTiep\u0022\u003ETr\u1EF1c ti\u1EBFp\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\u003Clabel\u003EKhu v\u1EF1c\u003Cinput class=\u0022form-control\u0022 name=\u0022KhuVuc\u0022 maxlength=\u0022256\u0022\u003E\u003C/label\u003E\u003C/div\u003E\r\n\u003Cdetails class=\u0022search-advanced\u0022\u003E\u003Csummary\u003EB\u1ED9 l\u1ECDc n\u00E2ng cao\u003C/summary\u003E\u003Cdiv class=\u0022search-advanced-grid\u0022\u003E\u003Clabel\u003EH\u1ECDc ph\u00ED t\u1ED1i \u0111a (VND)\u003Cinput class=\u0022form-control\u0022 type=\u0022number\u0022 name=\u0022HocPhiToiDa\u0022 min=\u00220\u0022 step=\u00220.01\u0022\u003E\u003C/label\u003E\u003Clabel\u003E\u0110\u01A1n v\u1ECB h\u1ECDc ph\u00ED\u003Cselect class=\u0022form-select\u0022 name=\u0022DonViHocPhi\u0022\u003E\u003Coption value=\u0022VND/Gio\u0022 selected=\u0022selected\u0022\u003EVND / gi\u1EDD\u003C/option\u003E\u003Coption value=\u0022VND/Buoi\u0022\u003EVND / bu\u1ED5i\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\r\n\u003Clabel\u003ETr\u00ECnh \u0111\u1ED9\u003Cinput class=\u0022form-control\u0022 name=\u0022TrinhDo\u0022 maxlength=\u0022256\u0022\u003E\u003C/label\u003E\u003C/div\u003E\u003C/details\u003E\u003Cdiv class=\u0022actions\u0022\u003E\u003Cbutton class=\u0022btn btn-primary\u0022\u003E\u00C1p d\u1EE5ng b\u1ED9 l\u1ECDc\u003C/button\u003E\u003Ca class=\u0022btn btn-outline-primary\u0022 href=\u0022/TimKiem/TimKiem\u0022\u003EX\u00F3a b\u1ED9 l\u1ECDc\u003C/a\u003E\u003C/div\u003E\u003C/div\u003E\u003C/form\u003E\r\n\u003Cdiv class=\u0022search-results-toolbar\u0022\u003E\u003Ch2\u003E23 gia s\u0026#x1B0;\u003C/h2\u003E\u003Clabel\u003ES\u1EAFp x\u1EBFp\u003Cselect class=\u0022form-select\u0022 name=\u0022SapXep\u0022 form=\u0022search-filters\u0022 data-search-sort\u003E\u003Coption value=\u0022MoiNhat\u0
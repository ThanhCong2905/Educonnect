0022\u003E\r\n            \u003Cinput name=\u0022__RequestVerificationToken\u0022 type=\u0022hidden\u0022 value=\u0022[redacted]\u0022 /\u003E\r\n            \u003Cbutton class=\u0022btn btn-outline-primary\u0022 type=\u0022submit\u0022\u003E\u0110\u0103ng xu\u1EA5t\u003C/button\u003E\r\n        \u003C/form\u003E\r\n    \u003C/div\u003E\r\n\u003C/header\u003E\u003Cmain class=\u0022container-fluid\u0022\u003E\r\n\u003Cdiv class=\u0022notification-rail\u0022 data-notification-rail hidden=\u0022hidden\u0022\u003E\r\n    \u003Cdiv class=\u0022notification-message\u0022 data-notification hidden=\u0022hidden\u0022\u003E\r\n        \u003Cspan class=\u0022notification-text\u0022 role=\u0022status\u0022 aria-live=\u0022polite\u0022 aria-atomic=\u0022true\u0022 data-notification-text\u003E\u003C/span\u003E\r\n        \u003Cbutton type=\u0022button\u0022 class=\u0022notification-close\u0022 data-notification-close aria-label=\u0022\u0110\u00F3ng th\u00F4ng b\u00E1o\u0022\u003E\u00D7\u003C/button\u003E\r\n    \u003C/div\u003E\r\n\u003C/div\u003E\r\n\r\n\r\n\r\n\u003Cdiv id=\u0022search-content\u0022 data-ajax-page=\u0022search\u0022\u003E\u003Ch1\u003ET\u0026#xEC;m gia s\u0026#x1B0;\u003C/h1\u003E\u003Cp\u003EM\u0026#x1ED7;i gia s\u0026#x1B0; c\u0026#xF3; m\u0026#x1ED9;t h\u0026#x1ED3; s\u0026#x1A1;, nhi\u0026#x1EC1;u m\u0026#xF4;n v\u0026#xE0; m\u0026#x1EE9;c ph\u0026#xED; ri\u0026#xEA;ng.\u003C/p\u003E\r\n\u003Cform method=\u0022get\u0022 id=\u0022search-filters\u0022\u003E\u003Cdiv class=\u0022searchbox search-keyword\u0022\u003E\u003Cinput class=\u0022form-control\u0022 name=\u0022TuKhoa\u0022 maxlength=\u0022100\u0022 value=\u0022IT0203IT_ff42b32dc9a54e7d96ba162af23d8220\u0022 aria-label=\u0022T\u1EEB kh\u00F3a\u0022 placeholder=\u0022T\u00EAn, m\u00F4n h\u1ECDc ho\u1EB7c chuy\u00EAn m\u00F4n\u0022\u003E\u003Cbutton class=\u0022btn btn-primary\u0022\u003ET\u00ECm ki\u1EBFm\u003C/button\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022card search-filter-panel\u0022\u003E\u003Cdiv class=\u0022search-basic-grid\u0022\u003E\u003Clabel\u003EM\u00F4n h\u1ECDc\u003Cselect class=\u0022form-select\u0022 name=\u0022MonHocId\u0022\u003E\u003Coption value=\u0022\u0022\u003ET\u1EA5t c\u1EA3 m\u00F4n\u003C/option\u003E\u003Coption value=\u00227\u0022\u003E\u0026#x110;\u0026#x1ECB;a L\u0026#xFD;\u003C/option\u003E\u003Coption value=\u00229\u0022\u003EGDCD\u003C/option\u003E\u003Coption value=\u00225\u0022\u003EH\u0026#xF3;a H\u0026#x1ECD;c\u003C/option\u003E\u003Coption value=\u00226\u0022\u003EL\u0026#x1ECB;ch S\u0026#x1EED;\u003C/option\u003E\u003Coption value=\u00222\u0022\u003ENg\u0026#x1EEF; V\u0026#x103;n\u003C/option\u003E\u003Coption value=\u00228\u0022\u003ESinh h\u0026#x1ECD;c\u003C/option\u003E\u003Coption value=\u00223\u0022\u003ETi\u0026#x1EBF;ng Anh\u003C/option\u003E\u003Coption value=\u00221\u0022\u003ETo\u0026#xE1;n H\u0026#x1ECD;c\u003C/option\u003E\u003Coption value=\u00224\u0022\u003EV\u0026#x1EAD;t L\u0026#xFD;\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\u003Clabel\u003EPh\u0026#x1EA1;m vi d\u0026#x1EA1;y\u003Cinput class=\u0022form-control\u0022 name=\u0022KhoiLop\u0022 maxlength=\u0022256\u0022 placeholder=\u0022L\u1EDBp 10\u0022\u003E\u003C/label\u003E\u003Clabel\u003EH\u00ECnh th\u1EE9c\u003Cselect class=\u0022form-select\u0022 name=\u0022HinhThucHoc\u0022\u003E\u003Coption value=\u0022\u0022\u003ET\u1EA5t c\u1EA3\u003C/option\u003E\u003Coption value=\u0022TrucTuyen\u0022\u003ETr\u1EF1c tuy\u1EBFn\u003C/option\u003E\u003Coption value=\u0022TrucTiep\u0022\u003ETr\u1EF1c ti\u1EBFp\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\u003Clabel\u003EKhu v\u1EF1c\u003Cinput class=\u0022form-control\u0022 name=\u0022KhuVuc\u0022 maxlength=\u0022256\u0022\u003E\u003C/label\u003E\u003C/div\u003E\r\n\u003Cdetails class=\u0022search-advanced\u0022\u003E\u003Csummary\u003EB\u1ED9 l\u1ECDc n\u00E2ng cao\u003C/summary\u003E\u003Cdiv class=\u0022search-advanced-grid\u0022\u003E\u003Clabel\u003EH\u1ECDc ph\u00ED t\u1ED1i \u0111a (VND)\u003Cinput class=\u0022form-control\u0022 type=\u0022number\u0022 name=\u0022HocPhiToiDa\u0022 min=\u00220\u0022 step=\u00220.01\u0022\u003E\u003C/label\u003E\u003Clabel\u003E\u0110\u01A1n v\u1ECB h\u1ECDc ph\u00ED\u003Cselect class=\u0022form-select\u0022 name=\u0022DonViHocPhi\u0022\u003E\u003Coption value=\u0022VND/Gio\u0022 selected=\u0022selected\u0022\u003EVND / gi\u1EDD\u003C/option\u003E\u003Coption value=\u0022VND/Buoi\u0022\u003EVND / bu\u1ED5i\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\r\n\u003Clabel\u003ETr\u00ECnh \u0111\u1ED9\u003Cinput class=\u0022form-control\u0022 name=\u0022TrinhDo\u0022 maxlength=\u0022256\u0022\u003E\u003C/label\u003E\u003C/div\u003E\u003C/details\u003E\u003Cdiv class=\u0022actions\u0022\u003E\u003Cbutton class=\u0022btn btn-primary\u0022\u003E\u00C1p d\u1EE5ng b\u1ED9 l\u1ECDc\u003C/button\u003E\u003Ca class=\u0022btn btn-outline-primary\u0022 href=\u0022/TimKiem/TimKiem\u0022\u003EX\u00F3a b\u1ED9 l\u1ECDc\u003C/a\u003E\u003C/div\u003E\u003C/div\u003E\u003C/form\u003E\r\n\u003Cdiv class=\u0022search-results-toolbar\u0022\u003E\u003Ch2\u003E1 gia s\u0026#x1B0;\u003C/h2\u003E\u003Clabel\u003ES\u1EAFp x\u1EBFp\u003Cselect class=\u0022form-select\u0022 name=\u0022SapXep\u0022 form=\u0022search-filters\u0022 data-search-sort\u003E\u003Coption value=\u0022MoiNhat\u0022 selected=\u0022selected\u0022\u003EM\u0026#x1EDB;i nh\u0026#x1EA5;t\u003C/option\u003E\u003Coption value=\u0022Ten\u0022\u003ET\u0026#xEA;n\u003C/option\u003E\u003Coption value=\u0022HocPhiTang\u0022\u003EH\u0026#x1ECD;c ph\u0026#xED; t\u0026#x103;ng\u003C/option\u003E\u003Coption value=\u0022HocPhiGiam\u0022\u003EH\u0026#x1ECD;c ph\u0026#xED; gi\u0026#x1EA3;m\u003C/option\u003E\u003C/select\u003E\u003C/label\u003E\u003C/div\u003E\r\n\u003Cnav class=\u0022active-filters\u0022 aria-label=\u0022B\u1ED9 l\u1ECDc \u0111ang \u00E1p d\u1EE5ng\u0022\u003E\r\n \u003Ca href=\u0022/TimKiem/TimKiem/Tim?MonHocId=200\u0022 aria-label=\u0022B\u1ECF b\u1ED9 l\u1ECDc IT0203IT_ff42b32dc9a54e7d96ba162af23d8220\u0022\u003EIT0203IT_ff42b32dc9a54e7d96ba162af23d8220 \u003Cspan aria-hidden=\u0022true\u0022\u003E\u00D7\u003C/span\u003E\u003C/a\u003E\r\n \u003Ca href=\u0022/TimKiem/TimKiem/Tim?TuKhoa=IT0203IT_ff42b32dc9a54e7d96ba162af23d8220\u0022 aria-label=\u0022B\u1ECF b\u1ED9 l\u1ECDc M\u0026#xF4;n \u0026#x111;\u0026#xE3; ch\u0026#x1ECD;n\u0022\u003EM\u0026#xF4;n \u0026#x111;\u0026#xE3; ch\u0026#x1ECD;n \u003Cspan aria-hidden=\u0022true\u0022\u003E\u00D7\u003C/span\u003E\u003C/a\u003E\r\n\u003C/nav\u003E\u003Cform id=\u0022compare-form\u0022 method=\u0022get\u0022 class=\u0022compare-bar\u0022 hidden aria-label=\u0022So s\u00E1nh l\u1EF1a ch\u1ECDn\u0022 data-compare-noun=\u0022h\u0026#x1ED3; s\u0026#x1A1;\u0022 action=\u0022/TimKiem/TimKiem/SoSanh\u0022\u003E\r\n    \u003Cp id=\u0022compare-status\u0022 role=\u0022status\u0022 aria-live=\u0022polite\u0022 aria-atomic=\u0022true\u0022\u003E\u0110\u00E3 ch\u1ECDn \u003Cstrong data-compare-count\u003E0/3\u003C/strong\u003E h\u0026#x1ED3; s\u0026#x1A1;\u003C/p\u003E\r\n    \u003Cdiv class=\u0022compare-bar-actions\u0022\u003E\r\n        \u003Cbutton type=\u0022button\u0022 class=\u0022btn compare-clear\u0022 data-compare-clear\u003EB\u1ECF ch\u1ECDn\u003C/button\u003E\r\n        \u003Cbutton type=\u0022submit\u0022 class=\u0022btn btn-primary compare-submit\u0022\u003ESo s\u00E1nh \u003Csvg aria-hidden=\u0022true\u0022 width=\u002222\u0022 height=\u002222\u0022 viewBox=\u00220 0 24 24\u0022 fill=\u0022none\u0022 stroke=\u0022currentColor\u0022 stroke-width=\u00221.7\u0022 stroke-linecap=\u0022round\u0022\u003E\u003Cpath d=\u0022M7 3v18M17 3v18M3 8h8M13 16h8\u0022/\u003E\u003Cpath d=\u0022M5 6h4v4H5zM15 14h4v4h-4z\u0022 fill=\u0022currentColor\u0022 stroke=\u0022none\u0022/\u003E\u003C/svg\u003E\u003C/button\u003E\r\n    \u003C/div\u003E\r\n\u003C/form\u003E\r\n\u003Cdiv class=\u0022cards\u0022\u003E\u003Carticle class=\u0022card candidate\u0022 data-candidate-id=\u002229fbfd2f-a5bb-49ed-9abf-6021c7d706ca\u0022\u003E\r\n    \u003Cdiv class=\u0022person\u0022\u003E\r\n        \u003Cspan class=\u0022avatar\u0022\u003EI\u003C/span\u003E\r\n        \u003Cdiv\u003E\r\n            \u003Ch3\u003E\r\n \u003Ca href=\u0022/NhuCau/HoSoGiaSu/ChiTiet?maHoSo=29fbfd2f-a5bb-49ed-9abf-6021c7d706ca\u0022\u003EIT0203IT_ff42b32dc9a54e7d96ba162af23d8220 GS-A\u003C/a\u003E             \u003C/h3\u003E\r\n            \u003Csmall\u003E\u0026#x110;\u0026#x1EA1;i h\u0026#x1ECD;c\u003C/small\u003E\r\n        \u003C/div\u003E\r\n    \u003C/div\u003E\r\n        \u003Cdiv class=\u0022chips\u0022\u003E\r\n            \u003Cspan\u003ETr\u0026#x1EF1;c tuy\u0026#x1EBF;n\u003C/span\u003E\r\n \u003Cspan\u003ETh\u0026#x1EE7; \u0026#x110;\u0026#x1EE9;c\u003C/span\u003E         \u003C/div\u003E\r\n        \u003Cdl class=\u0022candidate-professional\u0022\u003E\r\n            \u003Cdiv\u003E\u003Cdt\u003EChuy\u00EAn m\u00F4n\u003C/dt\u003E\u003Cdd title=\u0022IT0203IT_ff42b32dc9a54e7d96ba162af23d8220 To\u0026#xE1;n\u0022\u003EIT0203IT_ff42b32dc9a54e7d96ba162af23d8220 To\u0026#xE1;n\u003C/dd\u003E\u003C/div\u003E\r\n            \u003Cdiv\u003E\u003Cdt\u003EKinh nghi\u1EC7m\u003C/dt\u003E\u003Cdd title=\u00223 n\u0026#x103;m\u0022\u003E3 n\u0026#x103;m\u003C/dd\u003E\u003C/div\u003E\r\n        \u003C/dl\u003E\r\n        \u003Cdiv class=\u0022subject-fees\u0022\u003E\r\n                \u003Cdiv class=\u0022subject-fee\u0022\u003E\r\n                    \u003Cdiv\u003E\u003Cstrong\u003ETo\u0026#xE1;n\u003C/strong\u003E\u003Csmall\u003EL\u0026#x1EDB;p 8\u003C/small\u003E\u003C/div\u003E\r\n                    \u003Cspan class=\u0022price\u0022\u003E150.000 \u0026#x111; / gi\u0026#x1EDD;\u003C/span\u003E\r\n                \u003C/div\u003E\r\n        \u003C/div\u003E\r\n    \u003Cdiv class=\u0022actions\u0022\u003E\r\n            \u003Ca class=\u0022btn btn-outline-primary\u0022 href=\u0022/NhuCau/HoSoGiaSu/ChiTiet?maHoSo=29fbfd2f-a5bb-49ed-9abf-6021c7d706ca\u0022\u003EXem chi ti\u1EBFt\u003C/a\u003E\r\n                \u003Clabel class=\u0022check\u0022\u003E\u003Cinput class=\u0022form-check-input\u0022 type=\u0022checkbox\u0022 name=\u0022ids\u0022 value=\u002229fbfd2f-a5bb-49ed-9abf-6021c7d706ca\u0022 form=\u0022compare-form\u0022\u003ESo s\u00E1nh\u003C/label\u003E\r\n    \u003C/div\u003E\r\n\u003C/article\u003E\r\n\u003C/div\u003E\r\n\u003Cnav class=\u0022pagination\u0022 aria-label=\u0022Ph\u00E2n trang\u0022\u003E\u003Cspan\u003ETrang 1 / 1\u003C/span\u003E\u003C/nav\u003E\u003C/div\u003E\r\n\u003C/main\u003E\u003Cfooter\u003E\u003Cstrong\u003EEduConnect\u003C/strong\u003E\u003Cspan\u003EK\u1EBFt n\u1ED1i tri th\u1EE9c, \u0111\u1ED3ng h\u00E0nh c\u00F9ng ti\u1EBFn b\u1ED9.\u003C/span\u003E\u003Cspan\u003E\u00A9 2026 EduConnect\u003C/span\u003E\u003C/footer\u003E\u003C/div\u003E\u003Cdiv class=\u0022modal fade\u0022 id=\u0022workspace-modal\u0022 tabindex=\u0022-1\u0022 aria-labelledby=\u0022workspace-modal-title\u0022 aria-hidden=\u0022true\u0022\u003E\u003Cdiv class=\u0022modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable\u0022\u003E\u003Cdiv class=\u0022modal-content\u0022\u003E\u003Cdiv class=\u0022modal-header\u0022\u003E\u003Ch2 class=\u0022modal-title fs-5\u0022 id=\u0022workspace-modal-title\u0022\u003EChi ti\u1EBFt\u003C/h2\u003E\u003Cbutton type=\u0022button\u0022 class=\u0022btn-close\u0022 data-bs-dismiss=\u0022modal\u0022 aria-label=\u0022\u0110\u00F3ng\u0022\u003E\u003C/button\u003E\u003C/div\u003E\u003Cdiv class=\u0022modal-body\u0022 id=\u0022workspace-content\u0022 aria-live=\u0022polite\u0022\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003Cscript src=\u0022/lib/bootstrap/dist/js/bootstrap.bundle.min.js?v=6zfk2L8R3wCgRbZzpkEi7UYC2bc6fYGIgFfNeqyOWnQ\u0022\u003E\u003C/script\u003E\u003Cscript src=\u0022/js/confirmations.js?v=C7idaV0lebFO5P34ogxOQ6Ipts9mNBpf-AXhGSVojXA\u0022 defer\u003E\u003C/script\u003E\u003Cscript src=\u0022/js/account-profile.js?v=dhQMzGRVKLonrWJMGKXgWVXDGvO0hMyx
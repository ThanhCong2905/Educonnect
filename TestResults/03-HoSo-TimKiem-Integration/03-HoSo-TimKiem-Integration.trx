03Cbutton type=\u0022submit\u0022 class=\u0022btn btn-primary compare-submit\u0022\u003ESo s\u00E1nh \u003Csvg aria-hidden=\u0022true\u0022 width=\u002222\u0022 height=\u002222\u0022 viewBox=\u00220 0 24 24\u0022 fill=\u0022none\u0022 stroke=\u0022currentColor\u0022 stroke-width=\u00221.7\u0022 stroke-linecap=\u0022round\u0022\u003E\u003Cpath d=\u0022M7 3v18M17 3v18M3 8h8M13 16h8\u0022/\u003E\u003Cpath d=\u0022M5 6h4v4H5zM15 14h4v4h-4z\u0022 fill=\u0022currentColor\u0022 stroke=\u0022none\u0022/\u003E\u003C/svg\u003E\u003C/button\u003E\r\n    \u003C/div\u003E\r\n\u003C/form\u003E\r\n\u003Cdiv class=\u0022cards\u0022\u003E\u003Carticle class=\u0022card candidate\u0022 data-candidate-id=\u0022bf7225c5-cf3a-4d93-8e14-1594faa47ff7\u0022\u003E\r\n    \u003Cdiv class=\u0022person\u0022\u003E\r\n        \u003Cspan class=\u0022avatar\u0022\u003EI\u003C/span\u003E\r\n        \u003Cdiv\u003E\r\n            \u003Ch3\u003E\r\n \u003Ca href=\u0022/NhuCau/HoSoGiaSu/ChiTiet?maHoSo=bf7225c5-cf3a-4d93-8e14-1594faa47ff7\u0022\u003EIT0203IT_bca1919228814849ad7efe1883c7a924 Extra19\u003C/a\u003E             \u003C/h3\u003E\r\n            \u003Csmall\u003E\u0026#x110;\u0026#x1EA1;i h\u0026#x1ECD;c\u003C/small\u003E\r\n        \u003C/div\u003E\r\n    \u003C/div\u003E\r\n        \u003Cdiv class=\u0022chips\u0022\u003E\r\n            \u003Cspan\u003ETr\u0026#x1EF1;c tuy\u0026#x1EBF;n\u003C/span\u003E\r\n \u003Cspan\u003EH\u0026#xE0; N\u0026#x1ED9;i\u003C/span\u003E         \u003C/div\u003E\r\n        \u003Cdl class=\u0022candidate-professional\u0022\u003E\r\n            \u003Cdiv\u003E\u003Cdt\u003EChuy\u00EAn m\u00F4n\u003C/dt\u003E\u003Cdd title=\u0022IT0203IT_bca1919228814849ad7efe1883c7a924 To\u0026#xE1;n\u0022\u003EIT0203IT_bca1919228814849ad7efe1883c7a924 To\u0026#xE1;n\u003C/dd\u003E\u003C/div\u003E\r\n            \u003Cdiv\u003E\u003Cdt\u003EKinh nghi\u1EC7m\u003C/dt\u003E\u003Cdd title=\u00223 n\u0026#x103;m\u0022\u003E3 n\u0026#x103;m\u003C/dd\u003E\u003C/div\u003E\r\n        \u0
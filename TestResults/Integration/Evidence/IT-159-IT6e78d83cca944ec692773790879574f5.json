    "body": "\u003C!doctype html\u003E\r\n\u003Chtml lang=\u0022vi\u0022\u003E\r\n\u003Chead\u003E\r\n    \u003Cmeta charset=\u0022utf-8\u0022\u003E\r\n    \u003Cmeta name=\u0022viewport\u0022 content=\u0022width=device-width, initial-scale=1\u0022\u003E\r\n    \u003Ctitle\u003E\u0026#x110;\u0026#x103;ng k\u0026#xFD; t\u0026#xE0;i kho\u0026#x1EA3;n \u00B7 EduConnect\u003C/title\u003E\r\n    \u003Clink rel=\u0022stylesheet\u0022 href=\u0022/lib/bootstrap/dist/css/bootstrap.min.css\u0022\u003E\r\n    \u003Clink rel=\u0022stylesheet\u0022 href=\u0022/css/fonts.css\u0022\u003E\r\n    \u003Clink rel=\u0022stylesheet\u0022 href=\u0022/css/account.css?v=gf4gpE_S9om-UmihjzEsOY31fZj-5-0Oqj9vlwtvSd4\u0022\u003E\r\n    \u003Clink rel=\u0022stylesheet\u0022 href=\u0022/css/notifications.css?v=r2hN5jKsMzzXO-E2YY5ZVVmAm6mogxXxnDo3AUkBeLk\u0022\u003E\r\n\u003C/head\u003E\r\n\u003Cbody class=\u0022account-page\u0022\u003E\r\n    \u003Cheader class=\u0022account-header\u0022\u003E\r\n        \u003Ca class=\u0022account-brand\u0022 href=\u0022/\u0022\u003E\u003Cimg src=\u0022/images/auth/logo.png\u0022 alt=\u0022EduConnect\u0022\u003E\u003C/a\u003E\r\n        \u003Cnav class=\u0022account-nav\u0022 aria-label=\u0022T\u00E0i kho\u1EA3n\u0022\u003E\r\n                \u003Ca href=\u0022/TaiKhoan/DangNhap\u0022\u003E\u0110\u0103ng nh\u1EADp\u003C/a\u003E\r\n                \u003Ca href=\u0022/TaiKhoan/DangKy\u0022 aria-current=\u0022page\u0022\u003E\u0110\u0103ng k\u00FD\u003C/a\u003E\r\n        \u003C/nav\u003E\r\n    \u003C/header\u003E\r\n    \u003Cdiv class=\u0022notification-rail\u0022 data-notification-rail hidden=\u0022hidden\u0022\u003E\r\n    \u003Cdiv class=\u0022notification-message\u0022 data-notification hidden=\u0022hidden\u0022\u003E\r\n        \u003Cspan class=\u0022notification-text\u0022 role=\u0022status\u0022 aria-live=\u0022polite\u0022 aria-atomic=\u0022true\u0022 data-notification-text\u003E\u003C/span\u003E\r\n        \u003Cbutton type=\u0022button\u0022 class=\u
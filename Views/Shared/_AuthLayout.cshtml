<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · EduConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/fonts.css">
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true">
</head>
<body class="account-page">
    <header class="account-header">
        <a class="account-brand" href="/TaiKhoan/DangNhap"><img src="/images/auth/logo.png" alt="EduConnect"></a>
        <nav class="account-nav" aria-label="Tài khoản">
            <a href="/TaiKhoan/DangNhap" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "DangNhap" ? "page" : null)">Đăng nhập</a>
            <a href="/TaiKhoan/DangKy" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "DangKy" ? "page" : null)">Đăng ký</a>
        </nav>
    </header>
    <partial name="_Notifications" />
    <main class="account-container">
        <section class="account-card @(ViewContext.RouteData.Values["action"]?.ToString() == "DangKy" ? "account-card-register" : null)" aria-labelledby="account-title">
            <h1 id="account-title">@ViewData["Title"]</h1>
            @RenderBody()
        </section>
    </main>
    <footer class="account-site-footer">© @DateTime.Now.Year EduConnect</footer>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
    <script src="~/js/account.js" asp-append-version="true" defer></script>
</body>
</html>

@model UngVienViewModel
<div class="need-summary">
    <div class="chips">
        <span>@Model.TenMon</span>
        @if (!string.IsNullOrWhiteSpace(Model.KhoiLop))
        {
            <span>@(int.TryParse(Model.KhoiLop, out _) ? "Lớp " + Model.KhoiLop : Model.KhoiLop)</span>
        }
        <span>@Rules.Label(Model.HinhThucHoc)</span>
    </div>
    <p class="candidate-goal">@Model.MucTieu</p>
    @if (!string.IsNullOrWhiteSpace(Model.KhuVuc)) { <small>@Model.KhuVuc</small> }
    <strong class="price">@Rules.Fee(Model.HocPhiDuKien, Model.DonViHocPhi)</strong>
    <p class="slot-text">@string.Join(" · ", Model.Slots.OrderBy(slot => slot.ThuTrongTuan).ThenBy(slot => slot.GioBatDau).Select(slot => $"{(slot.ThuTrongTuan == 0 ? "CN" : "T" + (slot.ThuTrongTuan + 1))} {slot.GioBatDau:HH:mm}–{slot.GioKetThuc:HH:mm}"))</p>
</div>

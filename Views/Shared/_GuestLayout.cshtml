@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var home = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    var search = ViewContext.RouteData.Values["controller"]?.ToString() == "TimKiem"
        && ViewContext.RouteData.Values["action"]?.ToString() is "Index" or "Tim" or "GiaSu" or "NhuCau";
    var needs = ViewData["SearchType"] as string == "NhuCau";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · EduConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/fonts.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/guest.css" asp-append-version="true">
</head>
<body>
    <button type="button" class="btn mobile-menu" aria-label="Mở menu" aria-expanded="false" aria-controls="navigation">☰</button>
    <aside class="sidebar" id="navigation">
        <a class="brand" href="/"><img src="/images/auth/logo.png" alt="EduConnect"></a>
        <p class="eyebrow">KHÁM PHÁ EDUCONNECT</p>
        <nav aria-label="Điều hướng chính">
            <a href="/" class="@(home ? "selected" : "")"><img src="/images/ui/house-door.svg" alt="">Trang chủ</a>
            <a href="/TimKiem/TimKiem/GiaSu" class="@(!home && !needs ? "selected" : "")"><img src="/images/ui/search.svg" alt="">Tìm gia sư</a>
            <a href="/TimKiem/TimKiem/NhuCau" class="@(!home && needs ? "selected" : "")"><img src="/images/ui/journal-plus.svg" alt="">Tìm nhu cầu học</a>
        </nav>
        <div class="sidebar-bottom"><div class="soft"><strong>Bắt đầu việc học cùng EduConnect</strong><p>Tạo tài khoản để liên hệ và thống nhất lớp học.</p><a class="btn btn-primary" href="/TaiKhoan/DangKy">Đăng ký</a></div></div>
    </aside>
    <div class="shell">
    <header>
        <div class="guest-header-navigation">
        @if (!home)
        {
            <a class="guest-back" href="@(search ? "/" : needs ? "/TimKiem/TimKiem/NhuCau" : "/TimKiem/TimKiem/GiaSu")" data-page-back data-parent-page="false" aria-label="Quay lại" title="Quay lại"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h14" /></svg></a>
        }
        <nav class="breadcrumbs" aria-label="Đường dẫn"><ol>
            @if (!home) { <li><a href="/">Trang chủ</a></li> }
            <li><span aria-current="page">@(home ? "Trang chủ" : ViewData["Title"])</span></li>
        </ol></nav>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-primary" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="@returnUrl">Đăng nhập</a>
            <a class="btn btn-primary" href="/TaiKhoan/DangKy">Đăng ký</a>
        </div>
    </header>
    <main class="container-fluid">
        <partial name="_Notifications" />
        @RenderBody()
    </main>
    <footer><strong>EduConnect</strong><span>Kết nối gia sư và người học.</span><span>© @DateTime.Today.Year EduConnect</span></footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/confirmations.js" asp-append-version="true" defer></script>
    <script src="~/js/account-profile.js" asp-append-version="true" defer></script>
    <script src="~/js/forms.js" asp-append-version="true" defer></script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
    <script src="~/js/navigation.js" asp-append-version="true" defer></script>
    <script src="~/js/ajax-pages.js" asp-append-version="true" defer></script>
    <script src="~/js/areas.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

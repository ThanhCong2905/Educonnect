@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var home = (controller == "Home" && action == "Index") || (controller == "QuanTri" && action == "Index");
    var fallback = controller is "TaiKhoan" or "LienKetTaiKhoan" ? "/TaiKhoan/HoSo"
        : area == "QuanTri" ? "/QuanTri/QuanTri/Index"
        : area == "NhuCau" ? "/NhuCau/NhuCau/Index"
        : area is "HocTap" or "DanhGia" ? "/HocTap/LopHoc/Index" : "/";
    if (action == "Index" && controller != "LienKetTaiKhoan") fallback = "/";
    if (area == "TimKiem")
    {
        fallback = action is "Index" or "Tim" or "GiaSu" or "NhuCau" ? "/"
            : User.Identity?.IsAuthenticated == true ? "/TimKiem/TimKiem/Index"
            : ViewData["SearchType"] as string == "NhuCau" ? "/TimKiem/TimKiem/NhuCau" : "/TimKiem/TimKiem/GiaSu";
    }
    var reportListUrl = ViewData["ReportListUrl"] as string;
    if (controller == "BaoCaoViPham" && (action is "ChiTiet" or "XuLy" or "PhanHoi"))
    {
        fallback = reportListUrl ?? (ViewData["ReportListIsAdmin"] is true
            ? "/QuanTri/BaoCaoViPham/Index?quanTri=true"
            : "/QuanTri/BaoCaoViPham/Index");
    }
    if (area == "QuanTri" && action == "NhuCauChiTiet") fallback = "/QuanTri/QuanTri/NhuCau";
    if (controller == "HoSoGiaSu") fallback = ViewData["PublicProfile"] is true ? "/TimKiem/TimKiem/Index" : "/TaiKhoan/HoSo";
    if (controller == "DoiTac" && ViewContext.RouteData.Values["id"]?.ToString()
        == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
    {
        fallback = "/TaiKhoan/HoSo";
    }
    if (controller == "TaiKhoan" && action == "HoSo") fallback = "/";
    if (string.Equals(Context.Request.Path.Value, fallback, StringComparison.OrdinalIgnoreCase)) fallback = "/";
}
@if (!home)
{
    <a href="@fallback" class="page-back" data-page-back data-page-back-direct="@(reportListUrl != null ? "true" : null)" aria-label="Quay lại" title="Quay lại"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h14" /></svg></a>
}

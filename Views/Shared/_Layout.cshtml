@inject NguoiDungHienTaiService Current
@inject ThongBaoService Notices
@inject TaiKhoanService Accounts
@{
    var me = await Current.HienTaiAsync();
    var unread = await Notices.ChuaDocAsync();
    ViewData["UnreadCount"] = unread;
    var account = await Accounts.LayHoSoAsync(Context);
    var publicProfile = ViewData["PublicProfile"] is true;
    var areaName = publicProfile ? "TimKiem" : ViewContext.RouteData.Values["area"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    var contactPage = areaName == "KetNoi" && actionName == "LienHe";
    var ctrl = publicProfile ? "TimKiem" : ViewContext.RouteData.Values["controller"]?.ToString();
    var pageTitle = ViewData["Title"] as string ?? "";
    var sectionTitle = areaName == "QuanTri" ? (me.LoaiNguoi=="QuanTri"?"Quản trị":"Báo cáo")
        : ctrl == "HoSoGiaSu" ? "Hồ sơ"
        : areaName == "NhuCau" ? "Nhu cầu"
        : areaName == "TimKiem" ? "Tìm kiếm"
        : areaName == "KetNoi" ? "Liên hệ & kết nối" : "Lớp học";
    var sectionController = contactPage ? "KetNoi" : areaName == "QuanTri" ? (me.LoaiNguoi=="QuanTri"?"QuanTri":"BaoCaoViPham")
        : ctrl == "HoSoGiaSu" ? "HoSoGiaSu" : areaName == "HocTap" ? "LopHoc" : areaName;
    var sectionAction = contactPage ? "LienHe" : ctrl == "HoSoGiaSu" ? "Sua" : "Index";
    var sectionUrl = areaName=="DanhGia"?"/HocTap/LopHoc/Index":$"/{areaName}/{sectionController}/{sectionAction}";
    var sectionIsCurrent = actionName == "Index" || pageTitle == sectionTitle
        || string.Equals(Context.Request.Path.Value?.TrimEnd('/'), sectionUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="edu-user" content="@me.Id"><title>@ViewData["Title"] · EduConnect</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true"><link rel="stylesheet" href="~/css/fonts.css"><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><link rel="stylesheet" href="~/css/profile.css" asp-append-version="true"><link rel="stylesheet" href="~/css/classroom.css" asp-append-version="true"><link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true"><link rel="stylesheet" href="~/css/help.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/file-preview.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/search.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/time-picker.css" asp-append-version="true">
<script src="~/js/time-picker.js" asp-append-version="true" defer></script>
<script src="~/js/search-filters.js" asp-append-version="true" defer></script>
<link rel="stylesheet" href="~/css/connections.css" asp-append-version="true">
<script src="~/js/file-preview.js" asp-append-version="true" defer></script>
@if (areaName == "QuanTri" && me.LoaiNguoi == "QuanTri")
{
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
    <script src="~/js/admin-review.js" asp-append-version="true" defer></script>
}
</head>
<body class="@(Context.Request.Headers["Sec-Fetch-Dest"]=="iframe"?"embedded-view":"")"><button type="button" class="btn mobile-menu" aria-label="Mở menu" aria-expanded="false" aria-controls="navigation">☰</button><aside class="sidebar" id="navigation"><a class="brand" href="/"><img src="/images/auth/logo.png" alt="EduConnect"></a><p class="eyebrow">@(me.LoaiNguoi=="QuanTri"?"QUẢN TRỊ HỆ THỐNG":"KHÔNG GIAN HỌC TẬP")</p><nav aria-label="Điều hướng chính">
<partial name="_Navigation" /></nav><div class="sidebar-bottom"><div class="soft"><strong>Cùng tiến bộ mỗi ngày</strong><p>Kết nối đúng người, xây dựng hành trình học phù hợp.</p></div><div class="dropdown dropup"><button class="person account-menu btn w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu tài khoản của @me.HoTen"><partial name="_AnhDaiDien" model="new EduConnect.Mvc.ViewModels.AnhDaiDienViewModel(me.HoTen, account.AnhDaiDienUrl, false)" /><span class="account-menu-label"><strong class="person-name" title="@me.HoTen">@me.HoTen</strong><small>@Rules.Label(me.LoaiNguoi)</small></span></button><ul class="dropdown-menu w-100"><li><a class="dropdown-item" href="/TaiKhoan/HoSo">Trang cá nhân</a></li><li><hr class="dropdown-divider"></li><li><form action="/TaiKhoan/DangXuat" method="post">@Html.AntiForgeryToken()<button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></div></aside>
<div class="shell">
<header>
    <div class="header-navigation"><partial name="_PageBack" />
    <nav class="breadcrumbs" aria-label="Đường dẫn">
        <ol>
            @if (areaName == null && pageTitle == "Trang chủ")
            {
                <li><span aria-current="page">Trang chủ</span></li>
            }
            else
            {
                <li><a href="/">Trang chủ</a></li>
                @if (areaName != null && !sectionIsCurrent)
                {
                    <li><a href="@sectionUrl">@sectionTitle</a></li>
                }
                <li><span aria-current="page">@(string.IsNullOrWhiteSpace(pageTitle) ? sectionTitle : pageTitle)</span></li>
            }
        </ol>
    </nav>
    </div>
    @if (me.LoaiNguoi == "QuanTri" && areaName == "QuanTri" && ctrl == "QuanTri" && actionName is "Index" or "TimNhanh")
    {
        <form class="admin-search" role="search" method="get" asp-area="QuanTri" asp-controller="QuanTri" asp-action="TimNhanh">
            <label class="visually-hidden" for="admin-keyword">Tìm kiếm nhanh</label>
            <input class="form-control" id="admin-keyword" type="search" name="q" required minlength="2" maxlength="100"
                   value="@ViewData["TuKhoa"]" placeholder="Tìm kiếm nhanh…">
            <button type="submit" class="btn btn-outline-primary" aria-label="Tìm kiếm"><img src="/images/ui/search.svg" alt=""></button>
        </form>
    }
</header><main class="container-fluid">
<partial name="_Notifications" />


@RenderBody()</main><partial name="_SiteFooter" /></div><div class="modal fade" id="workspace-modal" tabindex="-1" aria-labelledby="workspace-modal-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="workspace-modal-title">Chi tiết</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="workspace-content" aria-live="polite"></div></div></div></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script><script src="~/js/confirmations.js" asp-append-version="true" defer></script><script src="~/js/account-profile.js" asp-append-version="true" defer></script><script src="~/js/forms.js" asp-append-version="true" defer></script><script src="~/js/scheduling.js" asp-append-version="true" defer></script><script src="~/js/class-calendar.js" asp-append-version="true" defer></script><script src="~/js/app.js" asp-append-version="true" defer></script><script src="~/js/notifications.js" asp-append-version="true" defer></script><script src="~/js/overlays.js" asp-append-version="true" defer></script><script src="~/js/navigation.js" asp-append-version="true" defer></script><script src="~/lib/signalr/signalr.min.js" asp-append-version="true" defer></script><script src="~/js/realtime.js" asp-append-version="true" defer></script><script src="~/js/ajax-pages.js" asp-append-version="true" defer></script><script src="~/js/subject-scope.js" asp-append-version="true" defer></script><script src="~/js/areas.js" asp-append-version="true" defer></script><script src="~/js/tutor-profile.js" asp-append-version="true" defer></script><script src="~/js/form-recovery.js" asp-append-version="true" defer></script><script src="~/js/lesson-record.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

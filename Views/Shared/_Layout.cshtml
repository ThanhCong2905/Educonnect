@inject NguoiDungMauService Current
@inject ThongBaoService Notices
@{ var me=await Current.HienTaiAsync();var unread=await Notices.ChuaDocAsync();var areaName=ViewContext.RouteData.Values["area"]?.ToString();var actionName=ViewContext.RouteData.Values["action"]?.ToString();var contactPage=areaName=="KetNoi"&&actionName=="LienHe";var ctrl=ViewContext.RouteData.Values["controller"]?.ToString(); }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="edu-user" content="@me.Id"><title>@ViewData["Title"] · EduConnect</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true"><link rel="stylesheet" href="~/css/fonts.css"><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"></head>
<body class="@(Context.Request.Headers["Sec-Fetch-Dest"]=="iframe"?"embedded-view":"")"><button type="button" class="btn mobile-menu" aria-label="Mở menu" aria-expanded="false" aria-controls="navigation">☰</button><aside class="sidebar" id="navigation"><a class="brand" href="/"><img src="/images/auth/logo.png" alt="EduConnect"></a><p class="eyebrow">KHÔNG GIAN HỌC TẬP</p><nav aria-label="Điều hướng chính">
@foreach(var item in new[]{("/","Trang chủ","house-door",""),("/TimKiem/TimKiem/Index",me.LoaiNguoi=="GiaSu"?"Tìm người học":"Tìm gia sư","search","TimKiem"),("/NhuCau/NhuCau/Index",me.LoaiNguoi=="GiaSu"?"Nhu cầu nhận lớp":"Nhu cầu của tôi","journal-plus","NhuCau"),("/KetNoi/KetNoi/LienHe","Liên hệ & kết nối","link-45deg","KetNoi"),("/HocTap/LopHoc/Index","Lớp học","collection","HocTap"),("/HocTap/TinNhan/Index","Tin nhắn","chat-dots","chat")}){if((item.Item4=="NhuCau"&&me.LoaiNguoi=="GiaSu")||(me.LoaiNguoi=="QuanTri"&&item.Item4!="")){continue;}<a href="@item.Item1" class="@((item.Item4=="KetNoi"?areaName=="KetNoi":item.Item4=="chat"?ctrl=="TinNhan":item.Item4=="HoSo"?ctrl=="HoSoGiaSu":item.Item4=="NhuCau"?areaName=="NhuCau"&&ctrl!="HoSoGiaSu":item.Item4=="HocTap"?areaName=="HocTap"&&ctrl!="TinNhan":item.Item4==""?areaName==null&&ctrl=="Home":areaName==item.Item4)?"selected":"")"><img src="/images/ui/@(item.Item3).svg" alt="">@item.Item2</a>}
@if(me.LoaiNguoi=="GiaSu"){<a href="/NhuCau/HoSoGiaSu/Sua" class="@(ctrl=="HoSoGiaSu"?"selected":"")"><img src="/images/ui/person-badge.svg" alt="">Hồ sơ của tôi</a>}
@if(me.LoaiNguoi=="QuanTri"){<a href="/QuanTri/HoSo/Index" class="@(areaName=="QuanTri"?"selected":"")">Kiểm duyệt hồ sơ</a>}</nav><div class="sidebar-bottom"><div class="soft"><strong>Cùng tiến bộ mỗi ngày</strong><p>Kết nối đúng người, xây dựng hành trình học phù hợp.</p></div><div class="person"><span class="avatar">@me.HoTen[..1]</span><div><strong>@me.HoTen</strong><small>@Rules.Label(me.LoaiNguoi)</small></div></div></div></aside>
<div class="shell"><header><span>Không gian học tập</span><a data-modal href="/Home/ThongBao" class="notification"><img src="/images/ui/bell.svg" alt="">Thông báo <b id="notification-badge" hidden="@(unread==0)" aria-label="@unread thông báo chưa đọc">@unread</b></a></header><main class="container-fluid">
<nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a>@if(areaName!=null){<span> / </span><a href="/@areaName/@(contactPage?"KetNoi":areaName=="QuanTri"?"HoSo":ctrl=="HoSoGiaSu"?"HoSoGiaSu":areaName=="HocTap"?"LopHoc":areaName)/@(contactPage?"LienHe":ctrl=="HoSoGiaSu"?"Sua":"Index")">@(areaName=="QuanTri"?"Kiểm duyệt":ctrl=="HoSoGiaSu"?"Hồ sơ":areaName=="NhuCau"?"Nhu cầu":areaName=="TimKiem"?"Tìm kiếm":areaName=="KetNoi"?"Liên hệ & kết nối":"Lớp học")</a>}@if((string?)ViewData["Title"]!="Trang chủ"){<span> / @ViewData["Title"]</span>}</nav>
@if(TempData["Success"] is string success){<div class="toast-container position-fixed bottom-0 end-0 p-3"><div class="toast app-toast" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="4500"><div class="toast-body"><span class="toast-mark" aria-hidden="true">✓</span><span>@success</span><button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Đóng thông báo"></button></div></div></div>}
@RenderBody()</main><footer><strong>EduConnect</strong><span>Kết nối tri thức, đồng hành cùng tiến bộ.</span><span>© @DateTime.Today.Year EduConnect</span></footer></div><div class="modal fade" id="workspace-modal" tabindex="-1" aria-labelledby="workspace-modal-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="workspace-modal-title">Chi tiết</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="workspace-content" aria-live="polite"></div></div></div></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script><script src="~/js/forms.js" asp-append-version="true" defer></script><script src="~/js/scheduling.js" asp-append-version="true" defer></script><script src="~/js/app.js" asp-append-version="true" defer></script><script src="~/js/overlays.js" asp-append-version="true" defer></script><script src="~/lib/signalr/signalr.min.js" asp-append-version="true" defer></script><script src="~/js/realtime.js" asp-append-version="true" defer></script><script src="~/js/ajax-pages.js" asp-append-version="true" defer></script><script src="~/js/tutor-profile.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

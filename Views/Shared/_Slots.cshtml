@model List<SlotInput>
<div data-slot-list>@for(int i=0;i<Model.Count;i++){<div class="slot-row"><label>Ngày trong tuần<select class="form-select" name="LichRanh[@i].ThuTrongTuan">@foreach(var d in new[]{1,2,3,4,5,6,0}){<option value="@d" selected="@(Model[i].ThuTrongTuan==d)">@(d==0?"Chủ nhật":"Thứ "+(d+1))</option>}</select></label><label>Giờ bắt đầu<input class="form-control" type="time" name="LichRanh[@i].GioBatDau" value="@Model[i].GioBatDau.ToString("HH:mm")" required></label><label>Giờ kết thúc<input class="form-control" type="time" name="LichRanh[@i].GioKetThuc" value="@Model[i].GioKetThuc.ToString("HH:mm")" required></label><button type="button" class="btn quiet" data-remove-row aria-label="Xóa khung giờ">Xóa</button></div>}</div><button type="button" class="btn btn-outline-primary secondary" data-add-slot>+ Thêm khung giờ</button>

@model UngVienViewModel
@{
    var managedNeed = ViewData["ManagedNeed"] as NhuCauHoc;
    var detailUrl = Model.LoaiNguoi == "GiaSu"
        ? $"/NhuCau/HoSoGiaSu/ChiTiet?maHoSo={Model.Id}"
        : $"/TimKiem/TimKiem/ChiTiet/{Model.Id}";
}
<article class="card candidate" data-candidate-id="@Model.Id">
    @if (managedNeed != null)
    {
        <div class="card-statuses">
            <span class="badge rounded-pill">@Rules.Label(managedNeed.TrangThai)</span>
            @if (ViewData["NeedLinked"] is true)
            {
                <span class="badge rounded-pill badge-linked">Đã kết nối</span>
            }
        </div>
    }
    <div class="person">
        <span class="avatar">@if(Model.AnhDaiDienUrl!=null){<img src="@Model.AnhDaiDienUrl" data-avatar-fallback="@(string.IsNullOrWhiteSpace(Model.HoTen)?"?":System.Globalization.StringInfo.GetNextTextElement(Model.HoTen))" alt="" loading="lazy">}else{@(string.IsNullOrWhiteSpace(Model.HoTen)?"?":System.Globalization.StringInfo.GetNextTextElement(Model.HoTen))}</span>
        <div>
            <h3>
                @if (managedNeed == null) { <a href="@detailUrl">@Model.HoTen</a> }
                else { @Model.HoTen }
            </h3>
            <small>@(Model.TrinhDo ?? Rules.Label(Model.LoaiNguoi))</small>
        </div>
    </div>
    @if (Model.LoaiNguoi == "GiaSu")
    {
        <div class="chips">
            <span>@Rules.Label(Model.HinhThucHoc)</span>
            @if (!string.IsNullOrWhiteSpace(Model.KhuVuc)) { <span>@Model.KhuVuc</span> }
        </div>
        <dl class="candidate-professional">
            <div><dt>Chuyên môn</dt><dd title="@Model.ChuyenMon">@(string.IsNullOrWhiteSpace(Model.ChuyenMon) ? "Chưa cập nhật" : Model.ChuyenMon)</dd></div>
            <div><dt>Kinh nghiệm</dt><dd title="@Model.KinhNghiem">@(string.IsNullOrWhiteSpace(Model.KinhNghiem) ? "Chưa cập nhật" : Model.KinhNghiem)</dd></div>
        </dl>
        <div class="subject-fees">
            @foreach (var subject in Model.MonTheoHoSo)
            {
                <div class="subject-fee">
                    <div><strong>@subject.TenMon</strong><small>@subject.PhamViDay</small></div>
                    <span class="price">@Rules.Fee(subject.HocPhi, subject.DonVi)</span>
                </div>
            }
        </div>
    }
    else
    {
        <partial name="_NeedSummary" model="Model" />
    }
    @if (Model.LyDo.Count > 0) { <p class="match">@string.Join(" · ", Model.LyDo)</p> }
    <div class="actions">
        @if (managedNeed != null)
        {
            @if(managedNeed.TrangThai == "DangMo" && managedNeed.NhacXacNhanLuc != null){<form action="/NhuCau/NhuCau/XacNhanConNhuCau" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@managedNeed.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(managedNeed.RowVersion)"><button class="btn btn-primary">Tôi còn tìm gia sư</button></form>}
            <a data-modal class="btn btn-outline-primary secondary" href="/NhuCau/NhuCau/Sua/@managedNeed.Id">Chỉnh sửa</a>
            @if (managedNeed.TrangThai != "BanNhap")
            {
                <form action="/NhuCau/NhuCau/TrangThai" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@managedNeed.Id">
                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(managedNeed.RowVersion)">
                    <button class="btn @(managedNeed.TrangThai == "DaDong" ? "btn-primary" : "btn-outline-primary")" name="state" value="@(managedNeed.TrangThai == "DaDong" ? "DangMo" : "DaDong")">@(managedNeed.TrangThai == "DaDong" ? "Mở lại" : "Đóng nhu cầu")</button>
                </form>
            }
        }
        else
        {
            <a class="btn btn-outline-primary" href="@detailUrl">Xem chi tiết</a>
            @if (ViewData["Compare"] is true)
            {
                <label class="check"><input class="form-check-input" type="checkbox" name="ids" value="@Model.Id" form="compare-form">So sánh</label>
            }
        }
    </div>
</article>

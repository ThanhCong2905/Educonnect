@model UngVienViewModel
@{
    var managedNeed = ViewData["ManagedNeed"] as NhuCauHoc;
    var moderation = ViewData["ModerationInfo"] as EduConnect.Mvc.Areas.NhuCau.ViewModels.NhuCauKiemDuyetViewModel;
    var detailUrl = Model.LoaiNguoi == "GiaSu"
        ? $"/NhuCau/HoSoGiaSu/ChiTiet?maHoSo={Model.Id}"
        : $"/TimKiem/TimKiem/ChiTiet/{Model.Id}";
}
<article class="card candidate @(Model.LoaiNguoi == "GiaSu" ? "tutor-card" : "")" id="@Model.Id" data-candidate-id="@Model.Id">
    @if (managedNeed != null)
    {
        <div class="card-statuses">
            <span class="badge rounded-pill">@Rules.Label(managedNeed.TrangThai)</span>
            @if(moderation?.DangAn==true){<span class="badge rounded-pill badge-warning">Ẩn khỏi tìm kiếm</span>}
            @if (ViewData["NeedLinked"] is true)
            {
                <span class="badge rounded-pill badge-linked">Đã kết nối</span>
            }
        </div>
    }
    <div class="person">
        <partial name="_AnhDaiDien" model="new EduConnect.Mvc.ViewModels.AnhDaiDienViewModel(Model.HoTen, Model.AnhDaiDienUrl)" />
        <div>
            <h3 class="person-name" title="@Model.HoTen">
                @if (managedNeed == null) { <a href="@detailUrl">@Model.HoTen</a> }
                else { @Model.HoTen }
            </h3>
            <small>@(Model.TrinhDo ?? Rules.Label(Model.LoaiNguoi))@if (Model.LoaiNguoi == "GiaSu" && !string.IsNullOrWhiteSpace(Model.KinhNghiem)){<text> · @Model.KinhNghiem</text>}</small>
        </div>
    </div>
    @if (Model.LoaiNguoi == "GiaSu")
    {
        <div class="chips">
            <span>@Rules.Label(Model.HinhThucHoc)</span>
            @if (!string.IsNullOrWhiteSpace(Model.KhuVuc)) { <span>@string.Join(", ", new[] { Model.PhuongXa, Model.KhuVuc }.Where(value => !string.IsNullOrWhiteSpace(value)))</span> }
        </div>
        <partial name="_DiemDanhGiaThe" model="Model" />
        <div class="subject-fees">
            @foreach (var subject in Model.MonTheoHoSo.Take(3))
            {
                <div class="subject-fee">
                    <div><strong>@subject.TenMon</strong><small>@subject.PhamViDay</small></div>
                    <span class="price">@Rules.Fee(subject.HocPhi, subject.DonVi)</span>
                </div>
            }
            @if (Model.MonTheoHoSo.Count > 3)
            {
                <small class="muted">+ @(Model.MonTheoHoSo.Count - 3) môn trong hồ sơ</small>
            }
        </div>
    }
    else
    {
        @if (User.IsInRole("GiaSu"))
        {
            <partial name="_DiemDanhGiaThe" model="Model" />
        }
        <partial name="_NeedSummary" model="Model" />
    }
    <div class="candidate-relevance">@if (Model.LyDo.Count > 0) { <p class="match">@string.Join(" · ", Model.LyDo)</p> }</div>
    @if(moderation!=null)
    {
        <details class="bg-light rounded-3 p-3 mb-3"><summary>@(moderation.DangAn?"Lý do ẩn nhu cầu":"Nhận xét kiểm duyệt gần nhất")</summary><p class="pre mt-2">@moderation.LyDo</p><small>@Rules.Date(moderation.ThoiDiem)</small>
        @if(moderation.DangAn&&managedNeed!=null&&managedNeed.TrangThai!="BanNhap"){<p class="mt-2">Bạn có thể chỉnh sửa rồi gửi đề nghị để quản trị xem lại.</p><form action="/NhuCau/NhuCau/DeNghiXemLai" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@managedNeed.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(managedNeed.RowVersion)"><button class="btn btn-outline-primary">Đề nghị xem lại</button></form>}
        </details>
    }
    <div class="actions">
        @if (managedNeed != null)
        {
            @if(managedNeed.TrangThai == "DangMo" && managedNeed.NhacXacNhanLuc != null){<form action="/NhuCau/NhuCau/XacNhanConNhuCau" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@managedNeed.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(managedNeed.RowVersion)"><button class="btn btn-primary">Tôi còn tìm gia sư</button></form>}
            <a data-modal class="btn btn-outline-primary secondary" href="/NhuCau/NhuCau/Sua/@managedNeed.Id">Chỉnh sửa</a>
            @if (managedNeed.TrangThai != "BanNhap" && ViewData["NeedLinked"] is not true)
            {
                <form action="/NhuCau/NhuCau/TrangThai" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@managedNeed.Id">
                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(managedNeed.RowVersion)">
                    <button class="btn @(managedNeed.TrangThai == "DaDong" ? "btn-primary" : "btn-outline-primary")" name="state" value="@(managedNeed.TrangThai == "DaDong" ? "DangMo" : "DaDong")">@(managedNeed.TrangThai == "DaDong" ? "Mở lại" : "Đóng nhu cầu")</button>
                </form>
            }
        }
        else
        {
            <a class="btn btn-outline-primary" href="@detailUrl">@(Model.LoaiNguoi == "GiaSu" ? "Xem hồ sơ" : "Xem chi tiết")</a>
            @if (ViewData["Compare"] is true)
            {
                <label class="check"><input class="form-check-input" type="checkbox" name="ids" value="@Model.Id" form="compare-form">So sánh</label>
            }
        }
    </div>
</article>

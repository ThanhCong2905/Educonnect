@model Page<ThongBao>
@{ViewData["Title"]="Thông báo";var unread=(int)ViewBag.Unread;var inModal=Context.Request.Headers["X-Edu-Modal"]=="true";var attrs=new Dictionary<string,object>{{"class","card"}};if(inModal)attrs["data-modal-form"]="";}
<div class="heading"><h1>Thông báo của bạn</h1>
@if(unread>0){<form method="post" action="/Home/DocTatCa" data-mark-all-notices>@Html.AntiForgeryToken()<button class="btn btn-outline-primary">Đánh dấu tất cả đã đọc</button></form>}
</div>
@using(Html.BeginForm("ThongBao","Home",FormMethod.Get,attrs))
{
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label>Tìm thông báo<input name="q" maxlength="100" class="form-control" value="@Context.Request.Query["q"]"></label></div>
        <div class="col-md-3"><label>Trạng thái<select name="state" class="form-select"><option value="">Tất cả</option><option value="ChuaDoc" selected="@(Context.Request.Query["state"]=="ChuaDoc")">Chưa đọc</option><option value="DaDoc" selected="@(Context.Request.Query["state"]=="DaDoc")">Đã đọc</option></select></label></div>
        <div class="col-md-3"><label>Loại thông báo<select name="loai" class="form-select"><option value="">Tất cả</option>@foreach(var t in ThongBaoService.Loai){<option value="@t" selected="@(Context.Request.Query["loai"]==t)">@Rules.Label(t)</option>}</select></label></div>
        <div class="col-md-2"><button class="btn btn-primary">Lọc</button></div>
    </div>
}
<section class="notice-list" id="notification-list" data-ajax-page="notices" aria-label="Danh sách thông báo">
    <p class="muted notice-count">@unread thông báo chưa đọc</p>
    @foreach(var notice in Model.Items)
    {
        var isUnread=notice.DaDocLuc==null;
        <form method="post" action="/Home/Doc" class="notice-item @(isUnread?"notice-unread":"notice-read")">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@notice.Id">
            <div class="notice-top"><span class="notice-read-state"><span class="notice-dot" aria-hidden="true"></span>@(isUnread?"Chưa đọc":"Đã đọc")</span><time datetime="@notice.TaoLuc.ToString("O")">@Rules.Date(notice.TaoLuc)</time></div>
            <h3>@notice.NoiDungTomTat</h3><button class="notice-open" type="submit">Xem chi tiết <span aria-hidden="true">→</span></button>
        </form>
    }
    @if(Model.Items.Count==0){<div class="empty">Chưa có thông báo phù hợp.</div>}
    <partial name="_PhanTrang" model="new EduConnect.Mvc.ViewModels.PhanTrangViewModel(Model.Trang,Model.Total)"/>
</section>

@model List<ThongBao>
@{ViewData["Title"]="Thông báo";}
<h1>Thông báo của bạn</h1><section class="stack" id="notification-list" data-ajax-page="notices">@foreach(var n in Model){<form method="post" action="/Home/Doc" class="card @(n.DaDocLuc==null?"unread":"")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@n.Id"><small>@Rules.Date(n.TaoLuc) · @(n.DaDocLuc==null?"Chưa đọc":"Đã đọc")</small><h3>@n.NoiDungTomTat</h3><button class="btn quiet">Xem chi tiết →</button></form>}@if(Model.Count==0){<div class="empty">Bạn chưa có thông báo.</div>}</section>

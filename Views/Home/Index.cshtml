@model List<UngVienViewModel>
@inject NguoiDungMauService Current
@{ViewData["Title"]="Trang chủ";var me=await Current.HienTaiAsync();var people=await Current.DanhSachAsync();var cs=(List<LopHoc>)ViewBag.Classes;}
<section class="hero"><div><p class="eyebrow">Trang chủ</p><h1>Chào @me.HoTen</h1><p>@(me.LoaiNguoi=="GiaSu"?"Tìm nhu cầu học phù hợp với chuyên môn của bạn.":"Tìm gia sư theo môn học, hình thức và học phí phù hợp.")</p><form action="/TimKiem/TimKiem/Index" method="get" class="searchbox"><input class="form-control" name="TuKhoa" aria-label="Từ khóa tìm kiếm" placeholder="Tên, môn học hoặc mục tiêu"><button class="btn btn-primary">Tìm kiếm</button></form></div></section>
<details class="preview"><summary>Tài khoản · @Rules.Label(me.LoaiNguoi)</summary><form action="/Home/Chon" method="post">@Html.AntiForgeryToken()<label>Chọn tài khoản<select class="form-select" name="id">@foreach(var u in people){<option value="@u.Id" selected="@(u.Id==me.Id)">@Rules.Label(u.LoaiNguoi) · @u.HoTen</option>}</select></label><button class="btn btn-primary">Chuyển vai trò</button></form></details>
<section id="home-updates" data-ajax-page="home"><div class="heading"><h2>Hoạt động của bạn</h2><button class="btn quiet" type="button" data-refresh-home>Cập nhật</button></div><div class="stats"><article><small>Lớp học của bạn</small><strong>@cs.Count</strong></article><article><small>Lớp đang hoạt động</small><strong>@cs.Count(x=>x.TrangThai=="DangHoatDong")</strong></article><article><small>Bước tiếp theo</small><a href="@(me.LoaiNguoi=="GiaSu"?"/NhuCau/HoSoGiaSu/Sua":"/NhuCau/NhuCau/Sua")">@(me.LoaiNguoi=="GiaSu"?"Cập nhật hồ sơ dạy →":"Tạo nhu cầu mới →")</a></article></div>
<div class="heading"><div><h2>@(me.LoaiNguoi=="GiaSu"?"Người học phù hợp":"Gia sư phù hợp")</h2></div><a href="/TimKiem/TimKiem/Index">Xem tất cả →</a></div>

<div class="cards">@foreach(var n in Model){<partial name="_Candidate" model="n"/>}</div>@if(Model.Count==0){<div class="empty">@(me.LoaiNguoi=="GiaSu"?"Chưa có nhu cầu học phù hợp.":"Chưa tìm thấy gia sư phù hợp.")</div>}</section>

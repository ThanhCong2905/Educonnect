@model List<EduConnect.Mvc.Infrastructure.ThuTaiKhoan>
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Hộp thư thử"; }
<p class="text-secondary">Email tạo trên máy Development. Mỗi liên kết đặt lại mật khẩu có hiệu lực trong 30 phút.</p>
@if (Model.Count == 0) { <p>Chưa có thư mới.</p> }
@foreach (var mail in Model)
{
    <article class="account-mail">
        <h2>@mail.TieuDe</h2>
        <p>@mail.Email</p>
        <small>@mail.TaoLuc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small>
        <p>@mail.NoiDung</p>
        <a href="@mail.LienKet" class="btn btn-outline-primary">Đặt lại mật khẩu</a>
    </article>
}

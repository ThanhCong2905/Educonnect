@model EduConnect.Mvc.ViewModels.XacMinhEmailInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Xác minh email"; }
<form asp-action="XacMinhEmail" method="post">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <input asp-for="Id" type="hidden">
    <input asp-for="Ma" type="hidden">
    <button class="btn btn-primary w-100" type="submit">Xác minh email</button>
</form>
<p class="account-footer"><a asp-action="GuiLaiXacMinhEmail">Gửi lại thư xác minh</a></p>

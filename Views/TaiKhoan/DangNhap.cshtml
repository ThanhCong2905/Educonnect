@model EduConnect.Mvc.ViewModels.DangNhapInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<p class="text-secondary">Tiếp tục hành trình học tập của bạn.</p>
<form asp-action="DangNhap" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input asp-for="ReturnUrl" type="hidden">
    <label class="form-label" for="Email">Email</label>
    <input asp-for="Email" class="form-control" autocomplete="username" inputmode="email" required autofocus>
    <span asp-validation-for="Email" class="text-danger"></span>
    <label class="form-label" for="MatKhau">Mật khẩu</label>
    <input asp-for="MatKhau" class="form-control" type="password" value="" autocomplete="current-password" required>
    <span asp-validation-for="MatKhau" class="text-danger"></span>
    <div class="account-forgot"><a asp-action="QuenMatKhau">Quên mật khẩu?</a></div>
    <button class="btn btn-primary w-100" type="submit">Đăng nhập</button>
</form>
<p class="account-footer">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký</a></p>

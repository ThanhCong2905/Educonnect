@model EduConnect.Mvc.Areas.HocTap.ViewModels.GiaoBaiTapViewModel
@{ViewData["Title"]="Giao bài tập";}
<h1>Giao bài tập</h1><form method="post" enctype="multipart/form-data" class="card form-wide"><div asp-validation-summary="All" class="validation"></div><input asp-for="LopHocId" type="hidden"><label>Tên bài tập<input class="form-control" asp-for="TieuDe" required maxlength="256"></label><label>Nội dung<textarea class="form-control" asp-for="NoiDung" required maxlength="10000"></textarea></label><label>Hạn nộp (giờ Việt Nam)<input class="form-control" asp-for="HanNopLuc" type="datetime-local" required></label><label>Tiêu chí chấm<textarea class="form-control" asp-for="TieuChiCham" maxlength="5000"></textarea></label><label>Tệp đính kèm<input class="form-control" asp-for="Files" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.docx"><small>Tối đa 5 tệp · 10 MB/tệp · PDF, JPG, PNG, DOCX</small></label><button class="btn btn-primary">Giao bài tập</button></form>

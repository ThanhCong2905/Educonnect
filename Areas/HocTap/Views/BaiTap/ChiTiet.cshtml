@model BaiTapGiao
@inject NguoiDungHienTaiService Current
@{
    ViewData["Title"] = Model.TieuDe;
    var me = await Current.HienTaiAsync();
    var c = (LopHoc)ViewBag.Class;
    var submissions = (List<BaiTapNop>)ViewBag.Submissions;
    var results = (List<KetQuaChamBai>)ViewBag.Results;
    var files = (List<TepDinhKem>)ViewBag.Files;
    var members = (List<ThanhVienLopHoc>)ViewBag.Members;
    var tutor = me.Id == c.GiaSuId;
    var canSubmit = me.Id == c.BenHocId || members.Any(x => x.TaiKhoanId == me.Id && x.TrangThaiDuyet == "DaDuyet" && x.RoiLopLuc == null && x.MucQuyen == "ChinhSua" && x.ChoPhepNopBai);
    var input = ViewBag.NopInput as EduConnect.Mvc.Areas.HocTap.ViewModels.NopBaiViewModel ?? new() { BaiTapGiaoId = Model.Id };
    var gradeInput = ViewBag.ChamInput as EduConnect.Mvc.Areas.HocTap.ViewModels.ChamBaiViewModel;
}
<div class="heading assignment-heading"><div><span class="muted">Bài tập · @c.TenLop</span><h1>@Model.TieuDe</h1></div>
@if (ViewBag.ScheduleId != null)
{
    <a class="btn btn-outline-primary" asp-controller="LichHoc" asp-action="Buoi" asp-route-id="@ViewBag.ScheduleId">← Buổi học</a>
}
else
{
    <div class="actions"><a class="btn btn-outline-primary" asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.Id" asp-route-tab="lessons">Các buổi học</a>
    @if (tutor && c.TrangThai == "DangHoatDong") { <a class="btn btn-outline-primary" data-modal asp-action="GanBuoi" asp-route-id="@Model.Id">Chọn buổi học</a> }</div>
}
</div>
<div class="assignment-workspace">
<article class="card assignment-content">
    <h2>Đề bài</h2>
    <p class="assignment-deadline"><span>Hạn nộp</span><strong>@Rules.Date(Model.HanNopLuc)</strong></p>
    @if (ViewBag.ScheduleId == null) { <p class="muted">Bài tập này chưa gắn với buổi học.</p> }
    <p class="pre">@Model.NoiDung</p>
    @if (!string.IsNullOrWhiteSpace(Model.TieuChiCham)) { <p>Tiêu chí: @Model.TieuChiCham</p> }
    @foreach (var f in files.Where(x => x.BaiTapGiaoId == Model.Id)) { <partial name="_TepLienKet" model='new EduConnect.Mvc.ViewModels.TepLienKetViewModel(f, "Tai")' /> }
</article>
@if (!tutor && canSubmit && c.TrangThai == "DangHoatDong" && results.Count == 0)
{
    <form method="post" asp-action="Nop" enctype="multipart/form-data" class="card assignment-submit">
        <div asp-validation-summary="All" class="validation"></div>
        <input name="BaiTapGiaoId" value="@Model.Id" type="hidden">
        <input name="MaThaoTac" value="@input.MaThaoTac" type="hidden">
        <h2>Nộp bài tập</h2>
        @if (Model.HanNopLuc < DateTimeOffset.UtcNow) { <p class="alert alert-info notice">Đã qua hạn. Bài vẫn được tiếp nhận và ghi nhận nộp muộn.</p> }
        <label>Nội dung bài làm<textarea class="form-control" name="NoiDung" maxlength="10000">@input.NoiDung</textarea></label>
        <label>Tệp bài làm<input class="form-control" type="file" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.docx"><small>Tối đa 5 tệp, 10 MB/tệp</small></label>
        <button class="btn btn-primary">Nộp bài · lần @(submissions.Count + 1)</button>
    </form>
}
</div>
<section class="assignment-history" aria-labelledby="submission-history-title">
<div class="heading"><h2 id="submission-history-title">Lịch sử nộp bài</h2><span class="muted">@submissions.Count lần nộp</span></div>
@if (submissions.Count == 0)
{
    <div class="empty"><h3>Chưa có bài nộp</h3><p>Bài làm và kết quả chấm sẽ xuất hiện tại đây.</p></div>
}
@foreach (var n in submissions)
{
    var result = results.FirstOrDefault(x => x.BaiTapNopId == n.Id);
    var edited = gradeInput?.BaiTapNopId == n.Id ? gradeInput : null;
    <article class="card submission-card">
        <header class="submission-heading"><div><h3>Lần nộp @n.LanNop</h3><time datetime="@n.NopLuc.ToString("O")">@Rules.Date(n.NopLuc)</time></div>
        <span class="submission-state" data-state="@(n.NopLuc > Model.HanNopLuc ? "late" : "submitted")">@(n.NopLuc > Model.HanNopLuc ? "Nộp muộn" : "Đúng hạn")</span></header>
        <p class="pre">@n.NoiDung</p>
        @foreach (var f in files.Where(x => x.BaiTapNopId == n.Id)) { <partial name="_TepLienKet" model='new EduConnect.Mvc.ViewModels.TepLienKetViewModel(f, "Tai")' /> }
        @if (result != null)
        {
            <div class="submission-result"><div class="submission-score"><span>@(result.Diem == null ? "Kết quả" : "Điểm")</span><strong>@(result.Diem?.ToString("0.##") ?? "Đã nhận xét")</strong>@if (result.Diem != null) { <small>/ 10</small> }</div><p class="pre">@result.NhanXet</p></div>
        }
        @if (tutor && c.TrangThai == "DangHoatDong" && n.Id == submissions.First().Id)
        {
            <details class="assignment-grading" open="@(result == null || edited != null)">
            <summary>@(result == null ? "Chấm bài" : "Chỉnh sửa kết quả")</summary>
            <form method="post" asp-action="Cham">
                <div asp-validation-summary="All" class="validation"></div>
                <input name="BaiTapGiaoId" value="@Model.Id" type="hidden">
                <input name="BaiTapNopId" value="@n.Id" type="hidden">
                <input name="RowVersion" value="@(edited != null ? edited.RowVersion : result == null ? "" : Convert.ToBase64String(result.RowVersion))" type="hidden">
                <label>Điểm<input class="form-control" type="number" name="Diem" value="@((edited != null ? edited.Diem : result?.Diem)?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" max="10" step="0.01"><small>Từ 0 đến 10; có thể chỉ nhận xét.</small></label>
                <label>Nhận xét<textarea class="form-control" name="NhanXet" required maxlength="2000">@(edited != null ? edited.NhanXet : result?.NhanXet)</textarea></label>
                <button class="btn btn-primary">@(result == null ? "Lưu nhận xét và điểm" : "Cập nhật kết quả")</button>
            </form>
            </details>
        }
    </article>
}
</section>

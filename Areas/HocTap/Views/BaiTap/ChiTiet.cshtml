@model BaiTapGiao
@inject NguoiDungMauService Current
@{ViewData["Title"]=Model.TieuDe;var me=await Current.HienTaiAsync();var c=(LopHoc)ViewBag.Class;var submissions=(List<BaiTapNop>)ViewBag.Submissions;var results=(List<KetQuaChamBai>)ViewBag.Results;var files=(List<TepDinhKem>)ViewBag.Files;var tutor=me.Id==c.GiaSuId;}
<h1>@Model.TieuDe</h1><a asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.Id" asp-route-tab="assignments">← Bài tập của lớp</a><article class="card"><p>Hạn nộp: @Rules.Date(Model.HanNopLuc)</p><p class="pre">@Model.NoiDung</p><p>Tiêu chí: @Model.TieuChiCham</p>@foreach(var f in files.Where(x=>x.BaiTapGiaoId==Model.Id)){<a class="file" asp-action="Tai" asp-route-id="@f.Id">↓ @f.TenGoc</a>}</article>
@if(!tutor&&c.TrangThai=="DangHoatDong"&&results.Count==0){<form method="post" asp-action="Nop" enctype="multipart/form-data" class="card"><input name="BaiTapGiaoId" value="@Model.Id" type="hidden"><input name="MaThaoTac" value="@Guid.NewGuid()" type="hidden"><h2>Nộp bài tập</h2>@if(Model.HanNopLuc<DateTimeOffset.UtcNow){<p class="alert alert-info notice">Đã qua hạn. Bài vẫn được tiếp nhận và ghi nhận nộp muộn.</p>}<label>Nội dung bài làm<textarea class="form-control" name="NoiDung" maxlength="10000"></textarea></label><label>Tệp bài làm<input class="form-control" type="file" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.docx"><small>Tối đa 5 tệp, 10 MB/tệp</small></label><button class="btn btn-primary">Nộp bài · lần @(submissions.Count+1)</button></form>}
<h2>Lịch sử nộp bài</h2>@foreach(var n in submissions){var result=results.FirstOrDefault(x=>x.BaiTapNopId==n.Id);<article class="card"><h3>Lần @n.LanNop · @(n.NopLuc>Model.HanNopLuc?"Nộp muộn":"Đã nộp")</h3><small>@Rules.Date(n.NopLuc)</small><p class="pre">@n.NoiDung</p>@foreach(var f in files.Where(x=>x.BaiTapNopId==n.Id)){<a class="file" asp-action="Tai" asp-route-id="@f.Id">↓ @f.TenGoc</a>}@if(result!=null){<div class="alert alert-success notice success"><strong>@(result.Diem==null?"Nhận xét không có điểm":"Điểm: "+result.Diem)</strong><p class="pre">@result.NhanXet</p></div>}@if(tutor&&c.TrangThai=="DangHoatDong"&&n.Id==submissions.First().Id){<form method="post" asp-action="Cham"><input name="BaiTapNopId" value="@n.Id" type="hidden"><input name="RowVersion" value="@(result==null?"":Convert.ToBase64String(result.RowVersion))" type="hidden"><label>Điểm (không bắt buộc, 0–10)<input class="form-control" type="number" name="Diem" value="@result?.Diem" min="0" max="10" step="0.01"></label><label>Nhận xét<textarea class="form-control" name="NhanXet" required maxlength="2000">@result?.NhanXet</textarea></label><button class="btn btn-primary">Lưu nhận xét và điểm</button></form>}</article>}

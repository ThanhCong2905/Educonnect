@model BaiTapGiao
@inject NguoiDungHienTaiService Current
@{
    ViewData["Title"] = Model.TieuDe;
    var me = await Current.HienTaiAsync();
    var c = (LopHoc)ViewBag.Class;
    var submissions = (List<BaiTapNop>)ViewBag.Submissions;
    var results = (List<KetQuaChamBai>)ViewBag.Results;
    var files = (List<TepDinhKem>)ViewBag.Files;
    var members = (List<ThanhVienLopHoc>)ViewBag.Members;
    var tutor = me.Id == c.GiaSuId;
    var canSubmit = me.Id == c.BenHocId || members.Any(x => x.TaiKhoanId == me.Id && x.TrangThaiDuyet == "DaDuyet" && x.RoiLopLuc == null && x.MucQuyen == "ChinhSua");
    var input = ViewBag.NopInput as EduConnect.Mvc.Areas.HocTap.ViewModels.NopBaiViewModel ?? new() { BaiTapGiaoId = Model.Id };
    var gradeInput = ViewBag.ChamInput as EduConnect.Mvc.Areas.HocTap.ViewModels.ChamBaiViewModel;
}
<h1>@Model.TieuDe</h1>
<a asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.Id" asp-route-tab="assignments">← Bài tập của lớp</a>
<article class="card">
    <p>Hạn nộp: @Rules.Date(Model.HanNopLuc)</p>
    <p class="pre">@Model.NoiDung</p>
    @if (!string.IsNullOrWhiteSpace(Model.TieuChiCham)) { <p>Tiêu chí: @Model.TieuChiCham</p> }
    @foreach (var f in files.Where(x => x.BaiTapGiaoId == Model.Id)) { <a class="file" asp-action="Tai" asp-route-id="@f.Id">↓ @f.TenGoc</a> }
</article>
@if (!tutor && canSubmit && c.TrangThai == "DangHoatDong" && results.Count == 0)
{
    <form method="post" asp-action="Nop" enctype="multipart/form-data" class="card">
        <div asp-validation-summary="All" class="validation"></div>
        <input name="BaiTapGiaoId" value="@Model.Id" type="hidden">
        <input name="MaThaoTac" value="@input.MaThaoTac" type="hidden">
        <h2>Nộp bài tập</h2>
        @if (Model.HanNopLuc < DateTimeOffset.UtcNow) { <p class="alert alert-info notice">Đã qua hạn. Bài vẫn được tiếp nhận và ghi nhận nộp muộn.</p> }
        <label>Nội dung bài làm<textarea class="form-control" name="NoiDung" maxlength="10000">@input.NoiDung</textarea></label>
        <label>Tệp bài làm<input class="form-control" type="file" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.docx"><small>Tối đa 5 tệp, 10 MB/tệp</small></label>
        <button class="btn btn-primary">Nộp bài · lần @(submissions.Count + 1)</button>
    </form>
}
<h2>Lịch sử nộp bài</h2>
@foreach (var n in submissions)
{
    var result = results.FirstOrDefault(x => x.BaiTapNopId == n.Id);
    var edited = gradeInput?.BaiTapNopId == n.Id ? gradeInput : null;
    <article class="card">
        <h3>Lần @n.LanNop · @(n.NopLuc > Model.HanNopLuc ? "Nộp muộn" : "Đã nộp")</h3>
        <small>@Rules.Date(n.NopLuc)</small>
        <p class="pre">@n.NoiDung</p>
        @foreach (var f in files.Where(x => x.BaiTapNopId == n.Id)) { <a class="file" asp-action="Tai" asp-route-id="@f.Id">↓ @f.TenGoc</a> }
        @if (result != null)
        {
            <div class="alert alert-success notice success"><strong>@(result.Diem == null ? "Nhận xét không có điểm" : "Điểm: " + result.Diem)</strong><p class="pre">@result.NhanXet</p></div>
        }
        @if (tutor && c.TrangThai == "DangHoatDong" && n.Id == submissions.First().Id)
        {
            <form method="post" asp-action="Cham">
                <div asp-validation-summary="All" class="validation"></div>
                <input name="BaiTapGiaoId" value="@Model.Id" type="hidden">
                <input name="BaiTapNopId" value="@n.Id" type="hidden">
                <input name="RowVersion" value="@(edited != null ? edited.RowVersion : result == null ? "" : Convert.ToBase64String(result.RowVersion))" type="hidden">
                <label>Điểm (không bắt buộc, 0–10)<input class="form-control" type="number" name="Diem" value="@((edited != null ? edited.Diem : result?.Diem)?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" max="10" step="0.01"></label>
                <label>Nhận xét<textarea class="form-control" name="NhanXet" required maxlength="2000">@(edited != null ? edited.NhanXet : result?.NhanXet)</textarea></label>
                <button class="btn btn-primary">@(result == null ? "Lưu nhận xét và điểm" : "Cập nhật kết quả")</button>
            </form>
        }
    </article>
}

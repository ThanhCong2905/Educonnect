@model List<EduConnect.Mvc.Areas.HocTap.ViewModels.LichSuQuyenViewModel>
@{ ViewData["Title"] = "Lịch sử quyền thành viên"; }
<h1>Lịch sử quyền thành viên</h1>
@if (Model.Count == 0)
{
    <p class="empty">Chưa có thay đổi quyền được ghi nhận.</p>
}
else
{
    <div class="stack">
    @foreach (var row in Model)
    {
        var change = row.LichSu;
        <article class="card">
            <div class="heading"><strong>@row.NguoiThucHien</strong><time class="muted">@Rules.Date(change.ThayDoiLuc)</time></div>
            <p>@(change.MucQuyenCu == null ? "Chưa được duyệt" : Rules.Label(change.MucQuyenCu)) → @Rules.Label(change.MucQuyenMoi)</p>
            @if (change.ChoPhepNopBaiCu != change.ChoPhepNopBaiMoi)
            {
                <p class="muted mb-0">@(change.ChoPhepNopBaiMoi ? "Được nộp bài thay" : "Đã tắt quyền nộp bài thay")</p>
            }
        </article>
    }
    </div>
}

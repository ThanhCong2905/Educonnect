@model List<ThanhVienLopHoc>
@inject NguoiDungMauService Current
@{ViewData["Title"]="Thành viên và quyền";var me=await Current.HienTaiAsync();var people=await Current.DanhSachAsync();var c=(LopHoc)ViewBag.Class;}
<h1>Thành viên và quyền</h1><a asp-action="ChiTiet" asp-route-id="@c.Id">← @c.TenLop</a><div class="stack">@foreach(var m in Model){<article class="card"><h3>@people.FirstOrDefault(p=>p.Id==m.TaiKhoanId)?.HoTen</h3><p>@m.TrangThaiDuyet · @m.MucQuyen</p>@if(me.Id==c.GiaSuId&&m.TaiKhoanId!=c.GiaSuId&&m.TaiKhoanId!=c.BenHocId){<form method="post" asp-action="Duyet" class="actions"><input name="id" value="@c.Id" type="hidden"><input name="member" value="@m.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(m.RowVersion)" type="hidden"><label>Quyền<select class="form-select" name="permission"><option value="Xem" selected="@(m.MucQuyen=="Xem")">Xem</option><option value="ChinhSua" selected="@(m.MucQuyen=="ChinhSua")">Chỉnh sửa</option></select></label><button class="btn btn-primary" name="action" value="DaDuyet">Duyệt / Lưu quyền</button><button class="btn btn-primary" name="action" value="TuChoi">Từ chối</button><button class="btn btn-primary" name="action" value="DaRoiLop">Cho rời lớp</button></form>}</article>}</div>@if(me.Id==c.BenHocId&&c.TrangThai=="DangHoatDong"){<form method="post" asp-action="DeNghi" class="card"><input name="id" value="@c.Id" type="hidden"><label>Đề nghị thêm người học / phụ huynh<select class="form-select" name="person">@foreach(var p in people.Where(x=>x.Id!=c.BenHocId&&x.LoaiNguoi!="GiaSu")){<option value="@p.Id">@p.HoTen</option>}</select></label><button class="btn btn-primary">Gửi đề nghị để gia sư duyệt</button></form>}
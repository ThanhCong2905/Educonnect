@model LopHoc
@inject NguoiDungMauService Current
@{ViewData["Title"]=Model.TenLop;var me=await Current.HienTaiAsync();var tutor=me.Id==Model.GiaSuId;var active=Model.TrangThai=="DangHoatDong";var tab=(string)ViewBag.Tab;var schedules=(List<LichHoc>)ViewBag.Schedules;var records=(List<BuoiHoc>)ViewBag.Records;var tasks=(List<BaiTapGiao>)ViewBag.Tasks;}
<div class="heading"><div><span class="badge rounded-pill">@Rules.Label(Model.TrangThai)</span><h1>@Model.TenLop</h1></div><details class="more"><summary aria-label="Tùy chọn lớp">•••</summary><a asp-action="ThanhVien" asp-route-id="@Model.Id">Thành viên và quyền</a>@if(active&&(tutor||me.Id==Model.BenHocId)){<form method="post" asp-action="KetThuc"><input name="id" value="@Model.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden"><button class="btn btn-outline-primary">Xác nhận kết thúc lớp</button></form><form method="post" asp-action="YeuCauHuy"><input name="id" value="@Model.Id" type="hidden"><label>Lý do hủy<textarea class="form-control" name="reason" required maxlength="2000"></textarea></label><button class="btn btn-outline-danger">Gửi yêu cầu hủy</button></form>}</details></div><nav class="tabs" aria-label="Nội dung lớp">@foreach(var t in new[]{("overview","Tổng quan"),("schedule","Lịch học"),("lessons","Buổi học"),("assignments","Bài tập"),("chat","Tin nhắn")}){<a class="@(tab==t.Item1?"selected":"")" asp-action="ChiTiet" asp-route-id="@Model.Id" asp-route-tab="@t.Item1">@t.Item2</a>}</nav>
@if(tab=="overview"){<article class="card"><p class="eyebrow">MỤC TIÊU CỦA LỚP</p><h2>@Model.MucTieu</h2><dl><dt>Người học</dt><dd>@Model.TenNguoiHoc @(Model.TuoiNguoiHoc==null?"":"· "+Model.TuoiNguoiHoc+" tuổi")</dd><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd><dt>Địa điểm</dt><dd>@Model.DiaDiem</dd><dt>Học phí</dt><dd>@Rules.Fee(Model.HocPhi,Model.DonViHocPhi)</dd><dt>Lịch dự kiến</dt><dd>@Model.SoBuoiTuan buổi / tuần · @Model.ThoiLuongPhut phút / buổi</dd><dt>Xác nhận kết thúc</dt><dd>Gia sư: @(Model.GiaSuXacNhanKetThucLuc==null?"Chưa xác nhận":"Đã xác nhận") · Bên học: @(Model.BenHocXacNhanKetThucLuc==null?"Chưa xác nhận":"Đã xác nhận")</dd></dl></article>@foreach(var y in (List<YeuCauHuyKetNoi>)ViewBag.Cancellations){<article class="card"><h3>Yêu cầu hủy · @Rules.Label(y.TrangThai)</h3><p>@y.LyDo</p><small>Hạn phản hồi: @Rules.Date(y.HetHanLuc)</small>@if(y.TrangThai=="ChoPhanHoi"&&y.NguoiGuiId!=me.Id&&(tutor||me.Id==Model.BenHocId)){<form method="post" asp-action="PhanHoiHuy" class="actions"><input name="id" value="@Model.Id" type="hidden"><input name="request" value="@y.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(y.RowVersion)" type="hidden"><button class="btn btn-primary" name="agree" value="true">Đồng ý hủy</button><button class="btn btn-primary" name="agree" value="false">Từ chối</button></form>}</article>}}
else if(tab=="schedule"||tab=="lessons"){<div class="heading"><h2>@(tab=="schedule"?"Lịch học":"Danh sách buổi học")</h2>@if(tutor&&active&&tab=="schedule"){<a data-modal class="btn btn-primary" asp-area="HocTap" asp-controller="LichHoc" asp-action="Them" asp-route-id="@Model.Id">+ Thêm lịch học</a>}</div>@if(tab=="lessons"){<form method="get" class="card form-grid"><input name="tab" value="lessons" type="hidden"><label>Tháng<input class="form-control" name="month" type="month" value="@ViewBag.Month"></label><label>Trạng thái<select class="form-select" name="state">@foreach(var st in new[]{("","Tất cả"),("upcoming","Sắp diễn ra"),("ongoing","Đang diễn ra"),("past","Đã qua giờ, chưa ghi nhận"),("recorded","Đã ghi nhận"),("cancelled","Đã hủy")}){<option value="@st.Item1" selected="@((string?)ViewBag.State==st.Item1)">@st.Item2</option>}</select></label><button class="btn btn-outline-primary secondary">Lọc buổi học</button></form>}<div class="stack">@foreach(var s in schedules){var b=records.FirstOrDefault(x=>x.LichHocId==s.Id);var status=s.TrangThai=="DaHuy"?"Đã hủy":b!=null?"Đã ghi nhận":s.KetThucLuc<=DateTimeOffset.UtcNow?"Đã qua giờ · Chưa ghi nhận":s.BatDauLuc<=DateTimeOffset.UtcNow?"Đang diễn ra":"Sắp diễn ra";<article class="card row"><div><span class="badge rounded-pill">@status</span><h3>@s.TieuDe</h3><p>@Rules.Date(s.BatDauLuc) – @s.KetThucLuc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</p></div><div class="actions"><a class="btn btn-outline-primary secondary" asp-controller="LichHoc" asp-action="Buoi" asp-route-id="@s.Id">Chi tiết buổi học</a>@if(tutor&&active&&s.BatDauLuc>DateTimeOffset.UtcNow&&s.TrangThai!="DaHuy"){<a data-modal asp-controller="LichHoc" asp-action="Sua" asp-route-id="@s.Id">Điều chỉnh / Hủy</a>}</div></article>}@if(schedules.Count==0){<div class="empty">Chưa có lịch học.</div>}</div>}
else if(tab=="assignments"){<div class="heading"><h2>Bài tập của lớp</h2>@if(tutor&&active){<a data-modal class="btn btn-primary" asp-controller="BaiTap" asp-action="Giao" asp-route-id="@Model.Id">+ Giao bài tập</a>}</div><div class="stack">@foreach(var a in tasks){<a class="card" asp-controller="BaiTap" asp-action="ChiTiet" asp-route-id="@a.Id"><h3>@a.TieuDe</h3><p>Hạn nộp: @Rules.Date(a.HanNopLuc)</p></a>}@if(tasks.Count==0){<div class="empty">Chưa có bài tập.</div>}</div>}
else if(tab=="chat"){<article class="card"><h2>Trao đổi trong lớp</h2>@if(ViewBag.Chat!=null){<iframe class="class-chat-frame" title="Tin nhắn trong lớp" src="@Url.Action("Lop","TinNhan",new{id=ViewBag.Chat})"></iframe>}else{<p>Chưa có phòng trò chuyện cho lớp này.</p>}</article>}

@model EduConnect.Mvc.Areas.DanhGia.ViewModels.TienDoViewModel
@using EduConnect.Mvc.ViewModels
<section class="class-progress" aria-labelledby="progress-title">
    <div class="heading"><h2 id="progress-title">Tình hình học tập</h2></div>
    <details class="card progress-filter" open="@(Model.TuNgay.HasValue || Model.DenNgay.HasValue)">
        <summary>Lọc theo thời gian</summary>
        <form method="get" action="/HocTap/LopHoc/ChiTiet/@Model.Lop.Id" class="row g-3 align-items-end mt-1">
            <div class="col-md-5"><label>Từ ngày<input class="form-control" type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")"></label></div>
            <div class="col-md-5"><label>Đến ngày<input class="form-control" type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")"></label></div>
            <div class="col-md-2"><button class="btn btn-primary">Áp dụng</button></div>
        </form>
    </details>
    <div class="progress-overview card">
        <div><span>Buổi đã học</span><strong>@Model.SoBuoiDaHoc</strong><small>@Model.SoBuoiNghi nghỉ · @Model.SoBuoiChuaGhiNhan chưa ghi nhận</small></div>
        <div><span>Bài đã nộp</span><strong>@Model.SoBaiDaNop <small>/ @Model.SoBaiDaGiao</small></strong><small>@Model.SoBaiNopMuon bài nộp muộn</small></div>
        <div><span>Bài đã chấm</span><strong>@Model.SoBaiDaCham</strong><small>Theo lần nộp mới nhất</small></div>
        <div><span>Điểm trung bình</span><strong>@(Model.DiemTrungBinh?.ToString("0.##") ?? "—")</strong><small>@(Model.DiemTrungBinh.HasValue ? "Từ các bài có điểm" : "Chưa có bài được chấm điểm")</small></div>
    </div>
    <div class="row g-4">
        <div class="col-lg-6"><section class="card h-100">
            <div class="heading"><h3>Buổi học gần đây</h3><a class="btn btn-outline-primary btn-sm" href="/HocTap/LopHoc/ChiTiet/@Model.Lop.Id?tab=lessons">Xem các buổi</a></div>
            @foreach(var lesson in Model.Buoi.Take(5))
            {
                <a class="progress-record" href="/HocTap/LichHoc/Buoi/@lesson.LichHocId"><span>@lesson.TieuDe</span><span class="badge rounded-pill">@Rules.Label(lesson.TrangThai)</span></a>
            }
            @if(Model.Buoi.Count == 0){<p class="muted">Chưa có buổi học trong khoảng đã chọn.</p>}
        </section></div>
        <div class="col-lg-6"><section class="card h-100">
            <div class="heading"><h3>Kết quả gần đây</h3><a class="btn btn-outline-primary btn-sm" href="/HocTap/LopHoc/ChiTiet/@Model.Lop.Id?tab=assignments">Xem bài tập</a></div>
            @foreach(var grade in Model.Diem.Take(5))
            {
                <a class="progress-record" href="/HocTap/BaiTap/ChiTiet/@grade.BaiTapId"><span>@grade.TieuDe<small>@Rules.Date(grade.ChamLuc)</small></span><strong>@(grade.Diem?.ToString("0.##") ?? "Đã nhận xét")</strong></a>
            }
            @if(Model.Diem.Count == 0){<p class="muted">Chưa có kết quả chấm trong khoảng đã chọn.</p>}
        </section></div>
    </div>
    <p class="muted mt-3">Tham dự các buổi đã học · Gia sư @Model.GiaSuCoMat/@Model.SoBuoiDaHoc · Bên học @Model.BenHocCoMat/@Model.SoBuoiDaHoc</p>
</section>

@if (Model.Dot.Count > 0 || Model.Phieu.Count > 0)
{
    <details class="card mt-4">
        <summary>Phản hồi đã lưu trước đây</summary>
        @foreach (var period in Model.Dot)
        {
            <article class="card mb-3">
                <div class="heading">
                    <div>
                        <h3>@period.Ten</h3>
                        <small>@Rules.Date(period.TuNgay) – @Rules.Date(period.DenNgay) · Hạn @Rules.Date(period.HanGui)</small>
                    </div>
                    <span class="badge rounded-pill">Chỉ xem</span>
                </div>
                @foreach (var feedback in Model.Phieu.Where(item => item.DotPhanHoiId == period.Id))
                {
                    <section class="border-top pt-3 mt-3">
                        <strong>@Model.HoTen.GetValueOrDefault(feedback.NguoiGuiId, "Thành viên")</strong>
                        <small class="muted"> · @Rules.Date(feedback.GuiLuc)</small>
                        @if (feedback.MucDoHaiLong.HasValue)
                        {
                            <span> · Hài lòng @feedback.MucDoHaiLong/5</span>
                        }
                        <p class="pre">@feedback.NoiDung</p>
                        <a class="btn btn-outline-primary" data-modal href="/DanhGia/DanhGia/LichSu/@feedback.Id">Lịch sử chỉnh sửa</a>
                    </section>
                }
                @if (!Model.Phieu.Any(item => item.DotPhanHoiId == period.Id))
                {
                    <p class="muted mt-3">Chưa có phản hồi.</p>
                }
                @foreach (var decision in Model.QuyetDinh.Where(item => item.DotPhanHoiId == period.Id))
                {
                    <p class="mt-3">@(decision.NguoiQuyetDinhId == Model.Lop.GiaSuId ? "Gia sư" : "Bên học") · @Rules.Label(decision.QuyetDinh) · @decision.GhiChu</p>
                }
            </article>
        }
        <partial name="_PhanTrang" model="new PhanTrangViewModel(Model.Trang, Model.TongDot)" />
        @foreach (var feedback in Model.Phieu.Where(item => item.DotPhanHoiId == null))
        {
            <section class="border-top pt-3 mt-3">
                <h3>@feedback.MocDanhGia</h3>
                <p class="pre">@feedback.NoiDung</p>
            </section>
        }
    </details>
}

@using EduConnect.Mvc.Areas.HocTap.ViewModels
@model LopHoc
@{
    var schedules = (List<LichHoc>)ViewBag.Schedules;
    var records = ((List<BuoiHoc>)ViewBag.Records).ToDictionary(x => x.LichHocId);
}
<form method="get" class="card lesson-filter">
    <input name="tab" value="lessons" type="hidden">
    <div class="row g-3 align-items-end">
        <div class="col-md"><label>Tháng<input class="form-control" name="month" type="month" value="@ViewBag.Month"></label></div>
        <div class="col-md"><label>Trạng thái<select class="form-select" name="state">
            @foreach (var state in new[] { ("", "Tất cả"), ("upcoming", "Sắp diễn ra"), ("ongoing", "Trong giờ học"), ("past", "Qua giờ, chưa ghi nhận"), ("recorded", "Đã ghi nhận"), ("rest", "Đã nghỉ"), ("cancelled", "Đã hủy"), ("replaced", "Đã đổi lịch") })
            {
                <option value="@state.Item1" selected="@((string?)ViewBag.State == state.Item1)">@state.Item2</option>
            }
        </select></label></div>
        <div class="col-md-auto"><button class="btn btn-primary">Lọc buổi học</button></div>
    </div>
</form>
<div class="lesson-list">
    @foreach (var schedule in schedules)
    {
        records.TryGetValue(schedule.Id, out var lesson);
        var status = SuKienLichViewModel.TrangThaiBuoi(schedule, lesson, DateTimeOffset.UtcNow);
        <a class="lesson-list-item" asp-controller="LichHoc" asp-action="Buoi" asp-route-id="@schedule.Id">
            <time datetime="@schedule.BatDauLuc.ToString("O")"><strong>@schedule.BatDauLuc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM")</strong><span>@schedule.BatDauLuc.ToOffset(TimeSpan.FromHours(7)).ToString("yyyy")</span></time>
            <div class="lesson-list-content"><h3>@schedule.TieuDe</h3><p>@schedule.BatDauLuc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm") – @schedule.KetThucLuc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")@(schedule.LaBuoiBu ? " · Buổi học bù" : "")</p></div>
            <span class="badge rounded-pill">@status</span><span class="carousel-control-next-icon" aria-hidden="true"></span>
        </a>
    }
    @if (schedules.Count == 0) { <p class="empty">Chưa có buổi học trong khoảng đã chọn.</p> }
</div>

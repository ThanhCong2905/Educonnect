@model List<TinNhan>
@inject NguoiDungMauService Current
@{
    ViewData["Title"] = "Tin nhắn";
    var inClass = ViewBag.InClass is true;
    var canSend = ViewBag.CanSend is true;
    var me = await Current.HienTaiAsync();
    var people = await Current.DanhSachAsync();
    var conversations = (List<CuocHoiThoai>)ViewBag.Conversations;
    var c = (CuocHoiThoai?)ViewBag.Conversation;
    var attachments=(Dictionary<Guid,List<TepDinhKem>>)ViewBag.Attachments;
    var partner = c == null ? "" : people.FirstOrDefault(x => x.Id == (c.GiaSuId == me.Id ? c.BenHocId : c.GiaSuId))?.HoTen ?? "Người liên hệ";
}
<div id="chat-content" data-ajax-page="chat" data-chat-id="@c?.Id" data-chat-page="@ViewBag.Page" data-message-query="@ViewBag.MessageQuery" data-chat-feed="@Url.Action("DuLieu")">
<h1>@(inClass ? "Tin nhắn trong lớp" : "Tin nhắn riêng")</h1>
<div class="@(inClass ? "class-chat-layout" : "chat-layout")">
@if (!inClass)
{
    <aside class="card chat-sidebar">
        <form method="get" class="conversation-search"><label>Tìm người liên hệ<input class="form-control" name="q" value="@ViewBag.Query" placeholder="Nhập tên..."></label><button class="btn btn-outline-primary" aria-label="Tìm cuộc hội thoại">Tìm</button></form>
        <nav class="conversation-list" aria-label="Cuộc hội thoại">
        @foreach (var room in conversations)
        {
            var name = people.FirstOrDefault(x => x.Id == (room.GiaSuId == me.Id ? room.BenHocId : room.GiaSuId))?.HoTen ?? "Người liên hệ";
            <a class="@(room.Id == c?.Id ? "selected" : "")" asp-action="Index" asp-route-id="@room.Id"><span class="avatar" aria-hidden="true">@name[..1]</span><span><strong>@name</strong></span></a>
        }
        @if (conversations.Count == 0) { <p class="muted p-3">Chưa có cuộc hội thoại.</p> }
        </nav>
    </aside>
}
<section class="card chat-panel">
@if (c != null)
{
    <div class="chat-header"><div class="person"><span class="avatar" aria-hidden="true">@(inClass ? "L" : partner[..1])</span><div><h2>@(inClass ? "Trao đổi trong lớp" : partner)</h2><small>@(inClass ? "Không gian trao đổi của thành viên lớp" : "Cuộc trò chuyện riêng của bạn")</small></div></div>@if (c.LopHocId != null) { <a asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.LopHocId">Về lớp →</a> }</div>
    <form method="get" asp-action="@(inClass ? "Lop" : "Index")" class="inline chat-search"><input name="id" value="@c.Id" type="hidden"><input class="form-control" name="message" value="@ViewBag.MessageQuery" aria-label="Tìm nội dung tin nhắn" placeholder="Tìm trong cuộc trò chuyện"><button class="btn btn-outline-primary">Tìm</button></form>
    <div class="chat-stream" role="log" aria-label="Nội dung cuộc trò chuyện" aria-live="off">
        <div class="chat-history"><button type="button" class="btn quiet" data-chat-older hidden="@(Model.Count < 50)">Xem tin nhắn trước</button><span class="muted" data-chat-history-status role="status"></span></div>
        <div class="chat-messages">
        @foreach (var m in Model)
        {
            <article data-message-id="@m.Id" class="bubble @(m.NguoiGuiId == me.Id ? "mine" : "")"><small>@people.FirstOrDefault(x => x.Id == m.NguoiGuiId)?.HoTen</small>@if(!string.IsNullOrEmpty(m.NoiDung)){<p class="pre">@m.NoiDung</p>}<partial name="_Attachments" model="@(attachments.GetValueOrDefault(m.Id,[]))"/><time>@Rules.Date(m.GuiLuc)</time></article>
        }
        @if (Model.Count == 0) { <div class="chat-empty"><strong>@(string.IsNullOrWhiteSpace((string?)ViewBag.MessageQuery) ? "Bắt đầu cuộc trò chuyện" : "Không tìm thấy tin nhắn")</strong><p class="muted">@(string.IsNullOrWhiteSpace((string?)ViewBag.MessageQuery) ? "Gửi lời chào và trao đổi về việc học tại đây." : "Thử tìm bằng từ khóa khác.")</p></div> }
        </div>
    </div>
    <button type="button" class="btn btn-outline-primary new-messages" data-new-messages hidden>Tin nhắn mới ↓</button>

        <form method="post" asp-action="Gui" enctype="multipart/form-data" class="compose" data-chat-send hidden="@(!canSend)"><input name="MaHoiThoai" value="@c.Id" type="hidden"><input name="MaThaoTac" value="@Guid.NewGuid()" type="hidden"><label class="grow"><span class="visually-hidden">Nội dung tin nhắn</span><textarea class="form-control" name="NoiDung" maxlength="10000" rows="2" placeholder="Viết tin nhắn hoặc chọn tệp..."></textarea></label><button class="btn btn-primary">Gửi ↑</button><div class="chat-attachment-picker"><label>Đính kèm tệp / ảnh<input class="form-control" type="file" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.docx" data-chat-files></label><button class="btn quiet" type="button" data-clear-chat-files hidden>Bỏ tệp đã chọn</button><span class="chat-file-selection muted" data-chat-file-selection role="status"></span></div><small class="compose-hint">Tối đa 5 tệp/lần, 10 MB/tệp (10.000.000 byte) · PDF, JPG, PNG, DOCX. Enter để gửi · Shift + Enter xuống dòng.</small></form>
    <p class="chat-readonly muted p-3" hidden="@canSend">Bạn có thể đọc cuộc trò chuyện. Quyền gửi tin phụ thuộc quyền thành viên và trạng thái lớp.</p>
}
else
{
    <div class="empty">Chấp nhận liên hệ để bắt đầu trò chuyện riêng.</div>
}
</section></div></div>

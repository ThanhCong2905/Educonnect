@model List<EduConnect.Mvc.Areas.HocTap.Services.LienKetTaiKhoanRow>
@inject NguoiDungHienTaiService Current
@{ ViewData["Title"] = "Tài khoản liên kết"; var me = await Current.HienTaiAsync(); }
<div class="heading"><div><h1>Tài khoản liên kết</h1><p>Liên kết cần được hai bên đồng ý. Quyền tham gia được duyệt riêng ở từng lớp.</p></div></div>
@if (me.LoaiNguoi == "PhuHuynh")
{
    <form method="post" asp-action="GuiDeNghi" class="card">
        <h2>Liên kết với học sinh</h2>
        <label>Email học sinh <span class="required-mark">*</span><input class="form-control" type="email" name="email" required maxlength="256" autocomplete="off"></label>
        <div class="actions"><button class="btn btn-primary">Gửi đề nghị</button></div>
    </form>
}
<div class="cards">
@foreach (var row in Model)
{
    var link = row.LienKet;
    <article class="card">
        <h2>@row.HoTen</h2><p>@Rules.Label(row.VaiTro)</p>
        <span class="badge">@(link.TrangThai == "DaLienKet" ? "Đã liên kết" : link.TrangThai == "ChoXacNhan" ? "Chờ xác nhận" : link.TrangThai == "TuChoi" ? "Đã từ chối" : link.XacNhanLuc == null ? "Đã rút đề nghị" : "Đã hủy liên kết")</span>
        <p class="muted">@Rules.Date(link.GuiLuc)</p>
        @if (link.KetThucLuc == null)
        {
            <div class="actions link-actions">
            @if (link.HocSinhId == me.Id && link.TrangThai == "ChoXacNhan")
            {
                <form method="post" asp-action="PhanHoi"><input type="hidden" name="id" value="@link.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(link.RowVersion)"><button class="btn btn-primary" name="dongY" value="true">Đồng ý</button><button class="btn btn-outline-primary" name="dongY" value="false">Từ chối</button></form>
            }
            @if (link.TrangThai == "DaLienKet" || (link.TrangThai == "ChoXacNhan" && link.NguoiGuiId == me.Id))
            {
                var pending = link.TrangThai == "ChoXacNhan";
                <form method="post" asp-action="Huy" data-confirm="@(pending ? "Rút đề nghị liên kết đã gửi?" : "Hủy liên kết sẽ thu hồi quyền thành viên bổ sung liên quan. Bạn muốn tiếp tục?")">
                    <input type="hidden" name="id" value="@link.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(link.RowVersion)">
                    <button class="btn @(pending ? "btn-outline-primary" : "btn-outline-danger")">@(pending ? "Rút đề nghị" : "Hủy liên kết")</button>
                </form>
            }
            </div>
        }
    </article>
}
</div>
@if (Model.Count == 0) { <div class="empty">Chưa có đề nghị hoặc liên kết tài khoản.</div> }

@model EduConnect.Mvc.Areas.HocTap.ViewModels.GhiNhanBuoiHocViewModel
@using EduConnect.Mvc.Areas.HocTap.ViewModels
@inject NguoiDungHienTaiService Current
@{
    ViewData["Title"] = "Chi tiết buổi học";
    var s = (LichHoc)ViewBag.Schedule;
    var c = (LopHoc)ViewBag.Class;
    var b = (BuoiHoc?)ViewBag.Record;
    var me = await Current.HienTaiAsync();
    var canManage = me.Id == c.GiaSuId && c.TrangThai == "DangHoatDong";
    var canChange = canManage && s.TrangThai == "DaLenLich" && s.BatDauLuc > DateTimeOffset.UtcNow && b?.TrangThai == "DuKien";
    var canRest = canManage && s.TrangThai == "DaLenLich" && b?.TrangThai is "DuKien" or "DangDienRa";
    var editing = b?.GhiNhanLuc == null || !ViewData.ModelState.IsValid;
}
<div class="lesson-detail-header">
    <div><h1>@s.TieuDe</h1><p>@Rules.Date(s.BatDauLuc) – @s.KetThucLuc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</p></div>
    <div class="actions">
        <a class="btn btn-outline-primary" asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.Id" asp-route-tab="schedule" asp-route-week="@s.BatDauLuc.ToOffset(TimeSpan.FromHours(7)).ToString("yyyy-MM-dd")">Về lịch học</a>
        @if (canChange || canRest)
        {
            <div class="dropdown">
                <button class="btn btn-outline-primary" data-bs-toggle="dropdown" type="button" aria-label="Thao tác buổi học" aria-expanded="false">•••</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @if (canChange) { <li><a data-modal class="dropdown-item" asp-action="Sua" asp-route-id="@s.Id">Điều chỉnh lịch</a></li> }
                    @if (canRest) { <li><a data-modal class="dropdown-item" asp-action="Nghi" asp-route-id="@s.Id">Thông báo nghỉ</a></li> }
                </ul>
            </div>
        }
    </div>
</div>
<div class="lesson-workspace">
<article class="card lesson-summary">
    @{var lessonStatus = SuKienLichViewModel.TrangThaiBuoi(s, b, DateTimeOffset.UtcNow);}
    <span class="badge rounded-pill align-self-start event-@(new SuKienLichViewModel { Lich = s, TrangThai = lessonStatus }.Kieu)">@lessonStatus</span>
    <h2>Thông tin buổi học</h2>
    <dl class="lesson-facts"><div><dt>Lớp học</dt><dd>@c.TenLop</dd></div><div><dt>Người học</dt><dd>@c.TenNguoiHoc</dd></div><div><dt>Hình thức</dt><dd>@Rules.Label(c.HinhThucHoc)</dd></div></dl>
    @if (s.LichGocId != null)
    {
        <div class="mt-3"><a class="btn btn-outline-primary" asp-action="Buoi" asp-route-id="@s.LichGocId">@(s.LaBuoiBu ? "Xem buổi nghỉ gốc" : "Xem lịch gốc")</a></div>
    }
    @if (b?.GhiNhanLuc != null)
    {
        <h2 class="mt-3">Nội dung buổi học</h2><p class="pre">@b.NoiDungGiangDay</p>
        <div class="attendance-summary"><span class="state-tag" data-state="@b.TrangThaiThamDuGiaSu">Gia sư · @Rules.Label(b.TrangThaiThamDuGiaSu)</span><span class="state-tag" data-state="@b.TrangThaiThamDuBenHoc">Bên học · @Rules.Label(b.TrangThaiThamDuBenHoc)</span></div>
        @if(!string.IsNullOrWhiteSpace(b.NhanXet)){<h3>@(b.KetQuaBuoiHoc=="KhongDienRa"?"Lý do không diễn ra":"Nhận xét")</h3><p class="pre">@b.NhanXet</p>}<small>Cập nhật @Rules.Date(b.CapNhatLuc)</small>
    }

</article>
@if (canManage && s.TrangThai == "DaLenLich" && s.KetThucLuc <= DateTimeOffset.UtcNow)
{
    <section class="card lesson-record" data-record-editor data-editing="@editing.ToString().ToLowerInvariant()">
        <div class="record-editor-heading"><div><h2>Ghi nhận buổi học</h2>@if(b?.GhiNhanLuc == null){<p>Cập nhật kết quả và tình hình tham dự.</p>}</div>
        @if(b?.GhiNhanLuc != null){<button class="btn btn-outline-primary" type="button" data-record-edit aria-expanded="@editing.ToString().ToLowerInvariant()" aria-controls="lesson-record-fields" hidden="@editing">Chỉnh sửa</button>}</div>
        <div id="lesson-record-fields" data-record-fields hidden="@(!editing)">
        <form data-lesson-record asp-action="GhiNhan" method="post" class="form-wide">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <input asp-for="LichHocId" type="hidden"><input asp-for="RowVersion" type="hidden">
            <fieldset class="record-edit-fields" disabled="@(!editing)">
            <fieldset class="lesson-outcome"><legend>Kết quả buổi học</legend>
                <label><input type="radio" asp-for="KetQuaBuoiHoc" value="DaDienRa">Đã diễn ra</label>
                <label><input type="radio" asp-for="KetQuaBuoiHoc" value="KhongDienRa">Không diễn ra</label>
            </fieldset>
            <div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid">
                @foreach (var item in new[] { ("TrangThaiGiaSu", "Gia sư", Model.TrangThaiGiaSu), ("TrangThaiBenHoc", "Bên học", Model.TrangThaiBenHoc) })
                {
                    <label>@item.Item2<select class="form-select" name="@item.Item1">
                        @foreach (var att in new[] { ("CoMat", "Có mặt"), ("VangCoBaoTruoc", "Vắng có báo trước"), ("VangKhongBaoTruoc", "Vắng không báo trước") })
                        { <option value="@att.Item1" selected="@(item.Item3 == att.Item1)">@att.Item2</option> }
                    </select></label>
                }
            </div>
            <label>Nội dung buổi học<textarea class="form-control" asp-for="NoiDung" maxlength="10000" rows="4"></textarea><span asp-validation-for="NoiDung"></span></label>
            <label><span data-record-comment-label>Nhận xét</span><textarea class="form-control" asp-for="NhanXet" maxlength="2000" rows="3"></textarea><span asp-validation-for="NhanXet"></span></label>
            <label class="check" data-record-rest><input asp-for="CanHocBu" type="checkbox">Cần học bù</label>
            <div class="record-editor-actions">@if(b?.GhiNhanLuc != null){<button type="button" class="btn btn-outline-primary" data-record-cancel>Hủy chỉnh sửa</button>}<button class="btn btn-primary">Lưu ghi nhận</button></div>
            </fieldset>
        </form>
        </div>
        <noscript><p>Bật JavaScript để chỉnh sửa ghi nhận.</p></noscript>
    </section>
}
</div>
@if (b != null) { @await Html.PartialAsync("_BuoiHoatDong", b) }
@if (ViewBag.ScheduleHistory is List<LichSuDieuChinhLich> changes && changes.Count > 0)
{
    <details class="card lesson-history"><summary><span>Lịch sử đổi lịch</span><span class="history-count">@changes.Count lần</span></summary><div class="lesson-history-list">
        @foreach (var change in changes)
        {
            <article class="lesson-history-entry"><header><h3>Điều chỉnh lịch học</h3><time datetime="@change.ThayDoiLuc.ToString("O")">@Rules.Date(change.ThayDoiLuc)</time></header><div class="schedule-change"><div><span>Lịch trước</span><strong>@Rules.Date(change.BatDauCu)</strong><small>Đến @Rules.Date(change.KetThucCu)</small></div><div><span>Lịch sau</span><strong>@Rules.Date(change.BatDauMoi)</strong><small>Đến @Rules.Date(change.KetThucMoi)</small></div></div>@if(!string.IsNullOrWhiteSpace(change.LyDo)){<p class="history-note pre">@change.LyDo</p>}</article>
        }
    </div></details>
}
@if (((List<LichSuGhiNhanBuoiHoc>)ViewBag.History).Count > 0)
{
    <details class="card lesson-history"><summary><span>Lịch sử ghi nhận</span><span class="history-count">@(((List<LichSuGhiNhanBuoiHoc>)ViewBag.History).Count) phiên bản</span></summary><div class="lesson-history-list">
        @foreach (var old in (List<LichSuGhiNhanBuoiHoc>)ViewBag.History)
        {
            <article class="lesson-history-entry"><header><div><h3>Phiên bản @old.PhienBan</h3><time datetime="@old.ThayDoiLuc.ToString("O")">@Rules.Date(old.ThayDoiLuc)</time></div><span class="state-tag" data-state="@old.KetQuaBuoiHoc">@(old.KetQuaBuoiHoc == "DaDienRa" ? "Đã diễn ra" : "Không diễn ra")</span></header>
            <div class="attendance-summary"><span class="state-tag" data-state="@old.TrangThaiThamDuGiaSu">Gia sư · @Rules.Label(old.TrangThaiThamDuGiaSu)</span><span class="state-tag" data-state="@old.TrangThaiThamDuBenHoc">Bên học · @Rules.Label(old.TrangThaiThamDuBenHoc)</span></div>
            @if(!string.IsNullOrWhiteSpace(old.NoiDungGiangDay)){<div class="history-content"><h4>Nội dung buổi học</h4><p class="pre">@old.NoiDungGiangDay</p></div>}
            @if(!string.IsNullOrWhiteSpace(old.NhanXet)){<div class="history-content"><h4>@(old.KetQuaBuoiHoc=="KhongDienRa"?"Lý do không diễn ra":"Nhận xét")</h4><p class="pre">@old.NhanXet</p></div>}</article>
        }
    </div></details>
}

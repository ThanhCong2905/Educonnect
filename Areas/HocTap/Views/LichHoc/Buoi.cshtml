@model EduConnect.Mvc.Areas.HocTap.ViewModels.GhiNhanBuoiHocViewModel
@inject NguoiDungHienTaiService Current
@{ViewData["Title"]="Chi tiết buổi học";var s=(LichHoc)ViewBag.Schedule;var c=(LopHoc)ViewBag.Class;var b=(BuoiHoc?)ViewBag.Record;var me=await Current.HienTaiAsync();}
<h1>@s.TieuDe</h1><p>@Rules.Date(s.BatDauLuc) – @Rules.Date(s.KetThucLuc)</p><a class="btn btn-outline-primary" asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@c.Id" asp-route-tab="lessons">← Danh sách buổi học</a><article class="card"><span class="badge rounded-pill">@(b?.TrangThai=="DaNghi"?"Đã nghỉ":b?.TrangThai=="DaHoc"?"Đã học":b?.TrangThai=="DangDienRa"?"Đang diễn ra":b?.TrangThai=="DaHuy"?"Đã hủy":"Dự kiến")</span>@if(b?.GhiNhanLuc!=null){<h2>Nội dung giảng dạy</h2><p class="pre">@b.NoiDungGiangDay</p><h3>Nhận xét / lý do</h3><p class="pre">@b.NhanXet</p><small>Phiên bản @b.PhienBan · @Rules.Date(b.CapNhatLuc)</small>}else{<p>Chưa có ghi nhận sau buổi học.</p>}</article>
@if(me.Id==c.GiaSuId&&c.TrangThai=="DangHoatDong"&&s.TrangThai=="DaLenLich"&&s.KetThucLuc<=DateTimeOffset.UtcNow){<form asp-action="GhiNhan" method="post" class="card form-wide"><div asp-validation-summary="All" class="validation"></div><input asp-for="LichHocId" type="hidden"><input asp-for="RowVersion" type="hidden"><h2>@(b?.GhiNhanLuc==null?"Ghi nhận buổi học":"Sửa ghi nhận")</h2><label>Kết quả<select class="form-select" asp-for="KetQuaBuoiHoc"><option value="DaDienRa">Đã diễn ra</option><option value="KhongDienRa">Không diễn ra</option></select></label><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid">@foreach(var item in new[]{("TrangThaiGiaSu","Gia sư",Model.TrangThaiGiaSu),("TrangThaiBenHoc","Bên học",Model.TrangThaiBenHoc)}){<label>@item.Item2<select class="form-select" name="@item.Item1">@foreach(var att in new[]{("CoMat","Có mặt"),("VangCoBaoTruoc","Vắng có báo trước"),("VangKhongBaoTruoc","Vắng không báo trước")}){<option value="@att.Item1" selected="@(item.Item3==att.Item1)">@att.Item2</option>}</select></label>}</div><label>Nội dung giảng dạy<textarea class="form-control" asp-for="NoiDung" maxlength="10000"></textarea></label><label>Nhận xét / lý do không diễn ra<textarea class="form-control" asp-for="NhanXet" required maxlength="2000"></textarea></label><label class="check"><input asp-for="CanHocBu" type="checkbox">Cần học bù nếu buổi không diễn ra</label><button class="btn btn-primary">Lưu ghi nhận</button></form>}
@if(b!=null){ @await Html.PartialAsync("_BuoiHoatDong", b) }
@if (ViewBag.ScheduleHistory is List<LichSuDieuChinhLich> changes && changes.Count > 0)
{
    <details class="card"><summary>Lịch sử đổi lịch</summary>
    <ul>
    @foreach (var change in changes)
    {
        <li><strong>@Rules.Date(change.ThayDoiLuc)</strong><p>Giờ cũ: @Rules.Date(change.BatDauCu) – @Rules.Date(change.KetThucCu)</p><p>Giờ mới: @Rules.Date(change.BatDauMoi) – @Rules.Date(change.KetThucMoi)</p><p>@change.LyDo</p></li>
    }
    </ul></details>
}
@if (((List<LichSuGhiNhanBuoiHoc>)ViewBag.History).Count > 0) { <h2>Lịch sử sửa ghi nhận</h2> }
@foreach(var old in (List<LichSuGhiNhanBuoiHoc>)ViewBag.History){<details class="card"><summary>Phiên bản @old.PhienBan · @Rules.Date(old.ThayDoiLuc)</summary><p>@(old.KetQuaBuoiHoc=="DaDienRa"?"Đã diễn ra":"Không diễn ra")</p><p class="pre">@old.NoiDungGiangDay</p><p class="pre">@old.NhanXet</p></details>}

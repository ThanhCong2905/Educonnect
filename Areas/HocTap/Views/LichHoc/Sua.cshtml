@model EduConnect.Mvc.Areas.HocTap.ViewModels.SuaLichInput
@{ViewData["Title"]="Điều chỉnh lịch học";}
<h1>Điều chỉnh lịch học</h1><form method="post" class="card form-wide"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"><input asp-for="RowVersion" type="hidden"><label>Tên buổi học<input class="form-control" asp-for="Lich.TieuDe" required maxlength="256"></label><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Bắt đầu<input class="form-control" asp-for="Lich.BatDauLuc" type="datetime-local" required></label><label>Kết thúc<input class="form-control" asp-for="Lich.KetThucLuc" type="datetime-local" required></label></div><div class="actions"><button class="btn btn-primary" name="TrangThai" value="DaDieuChinh">Lưu điều chỉnh</button><button class="btn btn-primary" name="TrangThai" value="DaHuy">Hủy lịch học</button></div></form>

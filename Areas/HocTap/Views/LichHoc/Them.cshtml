@model EduConnect.Mvc.Areas.HocTap.ViewModels.LichHangLoatInput
@{ViewData["Title"]="Thêm lịch học";var today=DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).Date;}
<h1>Thêm lịch học</h1><form method="post" class="card form-wide" data-calendar-form><div asp-validation-summary="All" class="validation"></div><input asp-for="LopHocId" type="hidden"><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Tên buổi học<input class="form-control" id="batch-title" required value="Buổi học" maxlength="256"></label><label>Tháng<input class="form-control" type="month" id="batch-month" value="@today.ToString("yyyy-MM")"></label><label>Giờ bắt đầu<input class="form-control" id="batch-start" required type="time" value="19:00"></label><label>Giờ kết thúc<input class="form-control" id="batch-end" required type="time" value="20:30"></label></div><fieldset><legend>Chọn nhanh theo thứ</legend><div class="weekday-options">@foreach(var d in new[]{1,2,3,4,5,6,0}){<label class="check"><input class="form-check-input" type="checkbox" data-weekday value="@d">@(d==0?"CN":"T"+(d+1))</label>}</div><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Từ ngày<input class="form-control" type="date" id="range-from" value="@today.AddDays(1).ToString("yyyy-MM-dd")"></label><label>Đến ngày<input class="form-control" type="date" id="range-to" value="@today.AddDays(14).ToString("yyyy-MM-dd")"></label></div><button type="button" id="apply-weekdays" class="btn btn-outline-primary secondary">Thêm các ngày theo thứ đã chọn</button><p id="calendar-feedback" role="status"></p></fieldset><p class="calendar-hint">Chọn ngày để thêm, chọn lại để bỏ. Ngày đã qua không thể chọn.</p><div id="calendar" class="calendar" aria-label="Chọn ngày"></div><button type="button" class="btn btn-outline-primary secondary" id="apply-times">Áp dụng giờ chung cho ngày đã chọn</button><div class="schedule-heading"><h2>Buổi học đã chọn <span data-schedule-count>0</span></h2><button type="button" class="btn quiet" data-clear-schedule>Bỏ chọn tất cả</button></div><p class="muted" data-schedule-empty>Chọn ngày trên lịch để thêm buổi học. Bạn có thể chỉnh riêng từng buổi bên dưới.</p><div data-schedule-list>@for(int i=0;i<Model.Buoi.Count;i++){<div class="schedule-row"><label>Tên buổi<input class="form-control" name="Buoi[@i].TieuDe" value="@Model.Buoi[i].TieuDe" required maxlength="256"></label><label>Bắt đầu<input class="form-control" type="datetime-local" name="Buoi[@i].BatDauLuc" value="@Model.Buoi[i].BatDauLuc.ToString("yyyy-MM-ddTHH:mm")" required></label><label>Kết thúc<input class="form-control" type="datetime-local" name="Buoi[@i].KetThucLuc" value="@Model.Buoi[i].KetThucLuc.ToString("yyyy-MM-ddTHH:mm")" required></label><button class="btn quiet" type="button" data-remove-row aria-label="Xóa buổi">Xóa</button></div>}</div><div class="actions"><button class="btn btn-primary">Lưu lịch học</button></div></form>

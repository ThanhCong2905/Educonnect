@model SearchPage
@inject NguoiDungMauService Current
@{ViewData["Title"]="Tìm kiếm";ViewData["Compare"]=true;var f=Model.Filter;var tutor=(await Current.HienTaiAsync()).LoaiNguoi=="GiaSu";}
<div id="search-content" data-ajax-page="search"><h1>@(tutor?"Tìm nhu cầu học":"Tìm gia sư")</h1><p>@(tutor?"Chọn nhu cầu học để trao đổi và đề xuất lớp.":"Mỗi gia sư có một hồ sơ, nhiều môn và mức phí riêng.")</p>
<form method="get" id="search-filters"><div class="searchbox search-keyword"><input class="form-control" name="TuKhoa" value="@f.TuKhoa" aria-label="Từ khóa" placeholder="Tên, môn học hoặc chuyên môn"><button class="btn btn-primary">Tìm kiếm</button></div>
<div class="card search-filter-panel"><div class="search-basic-grid"><label>Môn học<select class="form-select" name="MonHocId"><option value="">Tất cả môn</option>@foreach(var s in (List<MonHoc>)ViewBag.Subjects){<option value="@s.Id" selected="@(f.MonHocId==s.Id)">@s.TenMon</option>}</select></label><label>@(tutor?"Khối lớp":"Phạm vi dạy")<input class="form-control" name="KhoiLop" value="@f.KhoiLop" placeholder="Lớp 10"></label><label>Hình thức<select class="form-select" name="HinhThucHoc"><option value="">Tất cả</option><option value="TrucTuyen" selected="@(f.HinhThucHoc=="TrucTuyen")">Trực tuyến</option><option value="TrucTiep" selected="@(f.HinhThucHoc=="TrucTiep")">Trực tiếp</option></select></label><label>Khu vực<input class="form-control" name="KhuVuc" value="@f.KhuVuc"></label></div>
<details class="search-advanced" open="@(f.HocPhiToiDa.HasValue||f.TrinhDo!=null||f.ThuTrongTuan.HasValue)"><summary>Bộ lọc nâng cao</summary><div class="search-advanced-grid"><label>Học phí tối đa (VND)<input class="form-control" type="number" name="HocPhiToiDa" min="0" step="0.01" value="@f.HocPhiToiDa"></label><label>Đơn vị học phí<select class="form-select" name="DonViHocPhi"><option value="VND/Gio" selected="@(f.DonViHocPhi=="VND/Gio")">VND / giờ</option><option value="VND/Buoi" selected="@(f.DonViHocPhi=="VND/Buoi")">VND / buổi</option></select></label>
@if(!tutor){<label>Trình độ<input class="form-control" name="TrinhDo" value="@f.TrinhDo"></label>}
else{<label>Ngày trong tuần<select class="form-select" name="ThuTrongTuan"><option value="">Tất cả</option>@for(int d=0;d<7;d++){<option value="@d" selected="@(f.ThuTrongTuan==d)">@(d==0?"Chủ nhật":"Thứ "+(d+1))</option>}</select></label><label>Giờ bắt đầu<input class="form-control" type="time" name="GioBatDau" value="@f.GioBatDau?.ToString("HH:mm")"></label><label>Giờ kết thúc<input class="form-control" type="time" name="GioKetThuc" value="@f.GioKetThuc?.ToString("HH:mm")"></label>}
</div></details><div class="actions"><button class="btn btn-primary">Áp dụng bộ lọc</button><a asp-action="Index">Xóa bộ lọc</a></div></div></form>
<div class="search-results-toolbar"><h2>@Model.Total @(tutor?"nhu cầu":"gia sư")</h2><label>Sắp xếp<select class="form-select" name="SapXep" form="search-filters" data-search-sort>@foreach(var s in new[]{("MoiNhat","Mới nhất"),("Ten","Tên"),("HocPhiTang","Học phí tăng"),("HocPhiGiam","Học phí giảm")}){<option value="@s.Item1" selected="@(f.SapXep==s.Item1)">@s.Item2</option>}</select></label></div>
@if(!tutor&&(f.SapXep is "HocPhiTang" or "HocPhiGiam")){<p class="muted">Sắp xếp theo mức phí thấp nhất trong các môn phù hợp, cùng đơn vị đã chọn.</p>}
<partial name="_ActiveFilters" model="Model.Filter"/><partial name="_CompareBar"/><div class="cards">@foreach(var n in Model.Items){<partial name="_Candidate" model="n"/>}</div>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có kết quả phù hợp</h2><a asp-action="Index">Xóa bộ lọc để tìm thêm</a></div>}
<nav class="pagination" aria-label="Phân trang">@if(f.Trang>1){<a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang-1)">← Trước</a>}<span>Trang @f.Trang / @Math.Max(1,(int)Math.Ceiling(Model.Total/9d))</span>@if(f.Trang*9<Model.Total){<a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang+1)">Sau →</a>}</nav></div>

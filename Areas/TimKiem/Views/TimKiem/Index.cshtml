@model SearchPage
@{var f=Model.Filter;var tutor=f.LoaiDoiTuong=="NhuCau";ViewData["Title"]=tutor?"Tìm nhu cầu học":"Tìm gia sư";ViewData["Compare"]=true;var searchAction=tutor?"NhuCau":"GiaSu";}
@{
    var sortingOptions = new List<(string Value, string Label)> { ("MoiNhat", "Mới nhất"), ("Ten", "Tên"), ("HocPhiTang", "Học phí tăng"), ("HocPhiGiam", "Học phí giảm") };
    if (!tutor) sortingOptions.AddRange([("DanhGia", "Đánh giá cao nhất"), ("HocVien", "Nhiều bên học nhất")]);
}
<div id="search-content" data-ajax-page="search" data-search-kind="@f.LoaiDoiTuong">
@if (User.Identity?.IsAuthenticated != true)
{
<nav class="actions search-kind-tabs" aria-label="Loại tìm kiếm">
    <a class="btn @(!tutor?"btn-primary":"btn-outline-primary")" href="/TimKiem/TimKiem/GiaSu" aria-current="@(!tutor?"page":null)">Tìm gia sư</a>
    <a class="btn @(tutor?"btn-primary":"btn-outline-primary")" href="/TimKiem/TimKiem/NhuCau" aria-current="@(tutor?"page":null)">Tìm nhu cầu học</a>
</nav>
}
<h1>@(tutor?"Tìm nhu cầu học":"Tìm gia sư")</h1>
<form method="get" asp-action="@searchAction" id="search-filters"><input type="hidden" name="LoaiDoiTuong" value="@f.LoaiDoiTuong"><div class="searchbox search-keyword"><input class="form-control" name="TuKhoa" maxlength="100" value="@f.TuKhoa" aria-label="Từ khóa" placeholder="Tên hoặc môn học"><button class="btn btn-primary">Tìm kiếm</button></div>
<details class="card search-filter-panel" open="@(f.MonHocId.HasValue || !string.IsNullOrEmpty(f.KhoiLop) || !string.IsNullOrEmpty(f.HinhThucHoc) || !string.IsNullOrEmpty(f.KhuVuc) || f.HocPhiToiDa.HasValue || f.TrinhDo != null || f.ThuTrongTuan.HasValue)"><summary>Bộ lọc tìm kiếm</summary><div class="search-filter-body"><div class="search-basic-grid"><label>Môn học<select class="form-select" name="MonHocId"><option value="">Tất cả môn</option>@foreach(var s in ((List<MonHoc>)ViewBag.Subjects).OrderBy(subject => MonHocCatalog.ThuTuHienThi(subject.TenMon))){<option value="@s.Id" selected="@(f.MonHocId==s.Id)">@s.TenMon</option>}</select></label><label>@(tutor?"Khối lớp":"Phạm vi dạy")<select class="form-select" name="KhoiLop"><option value="">Tất cả lớp</option>@for(var grade=1;grade<=12;grade++){<option value="Lớp @grade" selected="@(f.KhoiLop==$"Lớp {grade}")">Lớp @grade</option>}</select></label><label>Hình thức<select class="form-select" name="HinhThucHoc"><option value="">Tất cả</option><option value="TrucTuyen" selected="@(f.HinhThucHoc=="TrucTuyen")">Trực tuyến</option><option value="TrucTiep" selected="@(f.HinhThucHoc=="TrucTiep")">Trực tiếp</option></select></label><partial name="_KhuVucPicker" model="new EduConnect.Mvc.ViewModels.KhuVucPickerViewModel(f.KhuVuc, f.PhuongXa)" /></div>
<details class="search-advanced" open="@(f.HocPhiToiDa.HasValue||f.TrinhDo!=null||f.ThuTrongTuan.HasValue)"><summary>Bộ lọc nâng cao</summary><div class="search-advanced-grid"><label>Học phí tối đa (VND)<input class="form-control" type="number" name="HocPhiToiDa" min="0" step="1" value="@f.HocPhiToiDa"></label><label>Đơn vị học phí<select class="form-select" name="DonViHocPhi"><option value="VND/Gio" selected="@(f.DonViHocPhi=="VND/Gio")">VND / giờ</option><option value="VND/Buoi" selected="@(f.DonViHocPhi=="VND/Buoi")">VND / buổi</option></select></label>
@if(!tutor){<label>Trình độ<select class="form-select" name="TrinhDo"><option value="">Tất cả trình độ</option>@foreach(var degree in EduConnect.Mvc.Areas.NhuCau.ViewModels.HoSoLuaChon.TrinhDo){<option value="@degree" selected="@(f.TrinhDo==degree)">@degree</option>}</select></label>}
else{<label>Ngày trong tuần<select class="form-select" name="ThuTrongTuan"><option value="">Tất cả</option>@for(int d=0;d<7;d++){<option value="@d" selected="@(f.ThuTrongTuan==d)">@(d==0?"Chủ nhật":"Thứ "+(d+1))</option>}</select></label><label>Giờ bắt đầu<input class="form-control" type="time" name="GioBatDau" value="@f.GioBatDau?.ToString("HH:mm")"></label><label>Giờ kết thúc<input class="form-control" type="time" name="GioKetThuc" value="@f.GioKetThuc?.ToString("HH:mm")"></label>}
</div></details><div class="actions"><a class="btn btn-outline-primary" asp-action="@searchAction">Xóa bộ lọc</a></div></div></details></form>
<div class="search-results-toolbar"><h2>@Model.Total @(tutor?"nhu cầu":"gia sư")</h2><label>Sắp xếp<select class="form-select" name="SapXep" form="search-filters" data-search-sort>@foreach(var s in sortingOptions){<option value="@s.Value" selected="@(f.SapXep==s.Value)">@s.Label</option>}</select></label></div>
@if(!tutor&&(f.SapXep is "HocPhiTang" or "HocPhiGiam")){<p class="muted">Sắp xếp theo mức phí thấp nhất trong các môn phù hợp, cùng đơn vị đã chọn.</p>}
<partial name="_ActiveFilters" model="Model.Filter"/><partial name="_CompareBar"/><div class="cards">@foreach(var n in Model.Items){<partial name="_Candidate" model="n"/>}</div>
@if(Model.Items.Count==0){<div class="empty"><h2>Chưa có kết quả phù hợp</h2><a class="btn btn-outline-primary" asp-action="@searchAction">Xóa bộ lọc để tìm thêm</a></div>}
<nav class="pagination" aria-label="Phân trang">@if(f.Trang>1){<a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang-1)">← Trước</a>}<span>Trang @f.Trang / @Math.Max(1,(int)Math.Ceiling(Model.Total/9d))</span>@if(f.Trang*9<Model.Total){<a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang+1)">Sau →</a>}</nav></div>

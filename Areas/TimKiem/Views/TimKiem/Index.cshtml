@model SearchPage
@{
    var f = Model.Filter;
    var needs = f.LoaiDoiTuong == "NhuCau";
    var searchAction = needs ? "NhuCau" : "GiaSu";
    ViewData["Title"] = needs ? "Tìm nhu cầu học" : "Tìm gia sư";
    ViewData["Compare"] = true;
    var sorting = new List<(string Value, string Label)> { ("MoiNhat", "Mới nhất"), ("Ten", "Tên"), ("HocPhiTang", "Học phí tăng"), ("HocPhiGiam", "Học phí giảm") };
    if (User.IsInRole("GiaSu") || User.IsInRole("HocSinh") || User.IsInRole("PhuHuynh")) sorting.Insert(0, ("PhuHop", "Phù hợp nhất"));
    if (!needs || User.IsInRole("GiaSu")) sorting.Add(("DanhGia", "Đánh giá cao nhất"));
    if (!needs) sorting.Add(("HocVien", "Nhiều bên học nhất"));
}
<div id="search-content" class="search-page" data-ajax-page="search" data-search-kind="@f.LoaiDoiTuong">
    <noscript><style>.search-filter-drawer{visibility:visible!important;position:static!important;transform:none!important;width:100%!important;height:auto!important}.search-filter-drawer form{overflow:visible!important}.search-filter-toggle,.filter-show-results,.search-filter-drawer .btn-close{display:none!important}.search-filter-footer{display:flex!important}</style></noscript>
    <div class="search-page-heading">
        <h1>@ViewData["Title"]</h1>
        <div class="searchbox search-keyword">
            <svg class="search-keyword-icon" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
            <input class="form-control" type="search" name="TuKhoa" form="search-filters" maxlength="100" value="@f.TuKhoa" aria-label="Từ khóa" placeholder="@(needs ? "Tìm môn học, mục tiêu hoặc người đăng" : "Tìm theo tên gia sư hoặc môn học")">
            <button class="btn btn-primary" form="search-filters">Tìm kiếm</button>
        </div>
    </div>
    <div class="search-layout">
        <aside class="offcanvas-lg offcanvas-end search-filter-drawer" id="search-filter-drawer" tabindex="-1" aria-labelledby="search-filter-title">
            <div class="offcanvas-header"><h2 class="offcanvas-title" id="search-filter-title">Bộ lọc</h2><button class="btn-close" type="button" data-bs-dismiss="offcanvas" data-bs-target="#search-filter-drawer" aria-label="Đóng bộ lọc"></button></div>
            <form method="get" asp-action="@searchAction" id="search-filters" data-subject-scope data-search-scope data-search-autoload>
                <input type="hidden" name="LoaiDoiTuong" value="@f.LoaiDoiTuong">
                <div class="search-filter-scroll"><partial name="_SearchFilters" model="Model" /></div>
                <div class="search-filter-footer">
                    <a class="btn btn-outline-primary" asp-action="@searchAction" data-search-clear>Xóa bộ lọc</a>
                    <button class="btn btn-primary filter-show-results" type="button" data-bs-dismiss="offcanvas" data-bs-target="#search-filter-drawer">Xem <span data-search-total>@Model.Total</span> kết quả</button>
                    <noscript><button class="btn btn-primary" type="submit">Áp dụng bộ lọc</button></noscript>
                </div>
            </form>
        </aside>
        <section class="search-results" aria-label="Kết quả tìm kiếm">
            <div class="search-results-toolbar">
                <h2><strong>@Model.Total</strong> @(needs ? "nhu cầu" : "gia sư")</h2>
                <div class="search-result-controls">
                    <a class="btn btn-outline-primary search-reset" asp-action="@searchAction">Xóa bộ lọc</a>
                    <button class="btn btn-outline-primary search-filter-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#search-filter-drawer" aria-controls="search-filter-drawer"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 4h18l-7 8v7l-4 2v-9z" /></svg>Bộ lọc</button>
                    <label><span class="visually-hidden">Sắp xếp</span><select class="form-select" name="SapXep" form="search-filters" data-search-sort>
                        @foreach (var option in sorting) { <option value="@option.Value" selected="@(f.SapXep == option.Value)">@option.Label</option> }
                    </select></label>
                </div>
            </div>
            @if (!needs && f.SapXep is "HocPhiTang" or "HocPhiGiam") { <p class="search-price-note">Theo mức phí thấp nhất trong các môn phù hợp, cùng đơn vị đã chọn.</p> }
            <partial name="_ActiveFilters" model="f" />
            <partial name="_CompareBar" />
            <div class="cards">@foreach (var candidate in Model.Items) { <partial name="_Candidate" model="candidate" /> }</div>
            @if (Model.Items.Count == 0) { <div class="empty"><h2>Chưa có kết quả phù hợp</h2><p>Thử bỏ bớt tiêu chí để xem thêm lựa chọn.</p><a class="btn btn-outline-primary" asp-action="@searchAction">Xóa bộ lọc</a></div> }
            <nav class="pagination" aria-label="Phân trang">
                @if (f.Trang > 1) { <a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang - 1)">← Trước</a> }
                <span>Trang @f.Trang / @Math.Max(1, (int)Math.Ceiling(Model.Total / 9d))</span>
                @if (f.Trang * 9 < Model.Total) { <a href="@Context.Request.Path@Context.Request.QueryString" data-page="@(f.Trang + 1)">Sau →</a> }
            </nav>
        </section>
    </div>
</div>

@model UngVienViewModel
@{
    var preview = ViewBag.Preview is true;
    var tutor = Model.LoaiNguoi == "GiaSu";
    ViewData["Title"] = tutor ? "Hồ sơ gia sư" : "Chi tiết nhu cầu";
    var related = (ViewBag.Related as List<UngVienViewModel> ?? []).Where(item => item.Id != Model.Id).ToList();
}
@if (preview)
{
    <div class="alert alert-info">Bản xem trước của bạn. Người khác chỉ xem được khi hồ sơ đã duyệt và đang hiển thị.</div>
}
<div class="heading profile-hero detail-hero">
    <div>
        <p class="eyebrow">@(tutor ? "Hồ sơ gia sư" : "Nhu cầu tìm gia sư")</p>
        <h1>@(tutor ? Model.HoTen : string.IsNullOrWhiteSpace(Model.TenMon) ? "Nhu cầu học" : Model.TenMon)</h1>
        @if (tutor)
        {
            <p class="detail-meta">@string.Join(" · ", new[] { Model.TrinhDo, Model.ChuyenMon }.Where(value => !string.IsNullOrWhiteSpace(value)))</p>
        }
        else
        {
            <div class="detail-meta">
                <span>Đăng bởi <strong>@Model.HoTen</strong></span>
                <span>@Rules.Label(Model.LoaiNguoi)</span>
                @if (Model.TaoLuc != default)
                {
                    <span>Ngày đăng @Model.TaoLuc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</span>
                }
            </div>
        }
    </div>
</div>
<div class="split profile-layout">
    <section class="detail-content" aria-label="@(tutor ? "Thông tin gia sư" : "Thông tin nhu cầu học")">
        @if (tutor)
        {
            <article class="card detail-section">
                <h2>Thông tin giảng dạy</h2>
                <dl class="detail-facts">
                    <div><dt>Kinh nghiệm</dt><dd>@(string.IsNullOrWhiteSpace(Model.KinhNghiem) ? "Chưa cập nhật" : Model.KinhNghiem)</dd></div>
                    <div><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.KhuVuc))
                    {
                        <div><dt>Khu vực</dt><dd>@Model.KhuVuc</dd></div>
                    }
                </dl>
            </article>
            <article class="card detail-section">
                <h2>Giới thiệu</h2>
                <p class="pre detail-description">@Model.MoTa</p>
            </article>
            <article class="card detail-section public-profile-subjects">
                <h2>Môn dạy và học phí</h2>
                @foreach (var subject in Model.MonTheoHoSo)
                {
                    <div class="subject-fee">
                        <div><h3>@subject.TenMon</h3><p>@subject.PhamViDay</p></div>
                        <strong class="price">@Rules.Fee(subject.HocPhi, subject.DonVi)</strong>
                    </div>
                }
                <p class="muted">Học phí lớp được hai bên thống nhất trong đề xuất.</p>
            </article>
        }
        else
        {
            <article class="card detail-section">
                <h2>Mục tiêu học tập</h2>
                <p class="pre detail-description">@(string.IsNullOrWhiteSpace(Model.MucTieu) ? "Người đăng chưa bổ sung mục tiêu học tập." : Model.MucTieu)</p>
            </article>
            <article class="card detail-section">
                <h2>Điều kiện học</h2>
                <dl class="detail-facts">
                    <div><dt>Khối lớp</dt><dd>@(string.IsNullOrWhiteSpace(Model.KhoiLop) ? "Chưa cập nhật" : int.TryParse(Model.KhoiLop, out _) ? "Lớp " + Model.KhoiLop : Model.KhoiLop)</dd></div>
                    <div><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd></div>
                    <div><dt>Học phí dự kiến</dt><dd class="detail-fee">@Rules.Fee(Model.HocPhiDuKien, Model.DonViHocPhi)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.KhuVuc))
                    {
                        <div><dt>Khu vực</dt><dd>@Model.KhuVuc</dd></div>
                    }
                </dl>
            </article>
            <article class="card detail-section">
                <h2>Thời gian có thể học</h2>
                @if (Model.Slots.Count > 0)
                {
                    <table class="table need-schedule">
                        <caption class="visually-hidden">Các khung giờ rảnh do người đăng cung cấp</caption>
                        <thead><tr><th scope="col">Ngày</th><th scope="col">Bắt đầu</th><th scope="col">Kết thúc</th></tr></thead>
                        <tbody>
                            @foreach (var slot in Model.Slots.OrderBy(item => (item.ThuTrongTuan + 6) % 7).ThenBy(item => item.GioBatDau))
                            {
                                <tr><th scope="row">@(slot.ThuTrongTuan == 0 ? "Chủ nhật" : "Thứ " + (slot.ThuTrongTuan + 1))</th><td>@slot.GioBatDau.ToString("HH:mm")</td><td>@slot.GioKetThuc.ToString("HH:mm")</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="muted">Người đăng chưa bổ sung khung giờ học.</p>
                }
            </article>
        }
    </section>
    @if (!preview)
    {
        <partial name="_ProfileContact" model="Model" />
    }
    else
    {
        <aside class="card profile-contact"><h2>Hồ sơ công khai</h2><a class="btn btn-outline-primary" href="/NhuCau/HoSoGiaSu/Sua">Về quản lý hồ sơ</a></aside>
    }
</div>
@if (!tutor && related.Count > 0)
{
    <section class="related-needs">
        <h2>Nhu cầu khác của @Model.HoTen</h2>
        <div class="cards">
            @foreach (var item in related) { <partial name="_Candidate" model="item" /> }
        </div>
    </section>
}

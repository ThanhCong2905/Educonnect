@model UngVienViewModel
@{ViewData["Title"]="Hồ sơ chi tiết";var preview=ViewBag.Preview is true;}
@if(preview){<div class="alert alert-info">Bản xem trước của bạn. Người khác chỉ xem được khi hồ sơ đã duyệt và đang hiển thị.</div>}
<div class="heading profile-hero"><div><p class="eyebrow">@Rules.Label(Model.LoaiNguoi)</p><h1>@Model.HoTen</h1><p>@Model.TrinhDo · @Model.ChuyenMon</p></div></div>
<div class="split profile-layout"><section>
@if(Model.LoaiNguoi=="GiaSu"){
<article class="card"><h2>Thông tin giảng dạy</h2><dl><dt>Kinh nghiệm</dt><dd>@Model.KinhNghiem</dd><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd><dt>Khu vực</dt><dd>@Model.KhuVuc</dd></dl></article>
<article class="card"><h2>Giới thiệu</h2><p class="pre">@Model.MoTa</p></article>
<article class="card public-profile-subjects"><h2>Môn dạy & mức phí tham khảo</h2>@foreach(var d in Model.MonTheoHoSo){<div class="subject-fee"><div><h3>@d.TenMon</h3><p>@d.PhamViDay</p></div><strong class="price">@Rules.Fee(d.HocPhi,d.DonVi)</strong></div>}<p class="muted">Mức phí lớp học được hai bên thống nhất trong đề xuất lớp.</p></article>
}else{<article class="card"><h2>Nhu cầu học</h2><partial name="_Candidate" model="Model"/></article>}
</section>@if(!preview){<partial name="_ProfileContact" model="Model"/>}else{<aside class="card"><h2>Hồ sơ công khai</h2><a class="btn btn-outline-primary" href="/NhuCau/HoSoGiaSu/Sua">Về quản lý hồ sơ</a></aside>}</div>
@if(Model.LoaiNguoi!="GiaSu"){<section class="related-needs"><h2>Các nhu cầu công khai liên quan</h2><div class="cards">@foreach(var n in ((List<UngVienViewModel>)ViewBag.Related).Where(n=>n.Id!=Model.Id)){<partial name="_Candidate" model="n"/>}</div></section>}

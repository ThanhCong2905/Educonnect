@model UngVienViewModel
@{
    var preview = ViewBag.Preview is true;
    var tutor = Model.LoaiNguoi == "GiaSu";
    ViewData["Title"] = tutor ? "Hồ sơ gia sư" : "Chi tiết nhu cầu";
    var related = (ViewBag.Related as List<UngVienViewModel> ?? []).Where(item => item.Id != Model.Id).ToList();
    var authenticated = User.Identity?.IsAuthenticated == true;
    var priceReferences = ViewBag.PriceReferences as List<HocPhiThamChieuViewModel> ?? [];
    var canSeeReviews = tutor || User.IsInRole("GiaSu") ||
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.ChuSoHuuId.ToString() ||
        User.HasClaim("EduConnect.AdminPermission", "XuLyBaoCao");
}
@if (preview)
{
    <div class="alert alert-info">Bản xem trước của bạn. Người khác chỉ xem được khi hồ sơ đã duyệt và đang hiển thị.</div>
}
<div class="heading profile-hero detail-hero">
    <div class="person">
        <partial name="_AnhDaiDien" model="new EduConnect.Mvc.ViewModels.AnhDaiDienViewModel(Model.HoTen, Model.AnhDaiDienUrl, false)" />
        <div>
        <p class="eyebrow">@(tutor ? "Hồ sơ gia sư" : "Nhu cầu tìm gia sư")</p>
        <h1>@(tutor ? Model.HoTen : string.IsNullOrWhiteSpace(Model.TenMon) ? "Nhu cầu học" : Model.TenMon)</h1>
        @if (tutor)
        {
            <p class="detail-meta">@Model.TrinhDo <span class="profile-approved">@(preview ? "Bản xem trước" : "Hồ sơ đã duyệt")</span></p>
        }
        else
        {
            <div class="detail-meta">
                <span>Đăng bởi <strong>@Model.HoTen</strong></span>
                <span>@Rules.Label(Model.LoaiNguoi)</span>
                @if (Model.TaoLuc != default)
                {
                    <span>Ngày đăng @Model.TaoLuc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</span>
                }
            </div>
        }
    </div></div>
</div>
@if (tutor)
{
    <dl class="profile-summary" aria-label="Thông tin tóm tắt">
        <div><dt>Đánh giá</dt><dd><partial name="_DiemDanhGiaThe" model="Model" /></dd></div>
        <div><dt>Bên học đã kết nối</dt><dd>@Model.SoBenHoc <small>tài khoản</small></dd></div>
        <div><dt>Kinh nghiệm giảng dạy</dt><dd>@(string.IsNullOrWhiteSpace(Model.KinhNghiem) ? "Chưa cập nhật" : Model.KinhNghiem)</dd></div>
    </dl>
}
@if(tutor && !preview)
{
    <nav class="profile-section-nav" aria-label="Nội dung hồ sơ"><a href="#profile-intro">Giới thiệu</a><a href="#profile-fees">Môn dạy & học phí</a><a href="#profile-reviews">Đánh giá</a>@if(ViewBag.RelatedTutors is List<GiaSuLienQuanViewModel> alternatives && alternatives.Count > 0){<a href="#tutor-alternatives">Gợi ý gia sư tương tự</a>}</nav>
}
<div class="split profile-layout">
    <section class="detail-content" aria-label="@(tutor ? "Thông tin gia sư" : "Thông tin nhu cầu học")">
        @if (tutor)
        {
            <article class="card detail-section" id="profile-intro">
                <h2>Giới thiệu</h2>
                @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                {
                    <p class="pre detail-description">@Model.MoTa</p>
                }
                <dl class="detail-facts">
                    <div><dt>Trình độ</dt><dd>@Model.TrinhDo</dd></div>
                    <div><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.KhuVuc))
                    {
                        <div><dt>Khu vực</dt><dd>@string.Join(", ", new[] { Model.PhuongXa, Model.KhuVuc }.Where(value => !string.IsNullOrWhiteSpace(value)))</dd></div>
                    }
                </dl>
            </article>
            <article class="card detail-section public-profile-subjects" id="profile-fees">
                <h2>Môn dạy và học phí</h2>
                @foreach (var subject in Model.MonTheoHoSo)
                {
                    <div class="subject-fee">
                        <div><h3>@subject.TenMon</h3><p>@subject.PhamViDay</p></div>
                        <div class="subject-price-context"><strong class="price">@Rules.Fee(subject.HocPhi, subject.DonVi)</strong>
                        @if(!preview){<partial name="_HocPhiThamChieu" model="new DoiChieuHocPhiViewModel(priceReferences.FirstOrDefault(reference => reference.MonHocId == subject.MonHocId && reference.DonVi == subject.DonVi), subject.HocPhi, subject.DonVi)" />}</div>
                    </div>
                }
                <p class="muted">Học phí lớp được hai bên thống nhất trong đề xuất.</p>
            </article>
        }
        else
        {
            <article class="card detail-section">
                <h2>Mục tiêu học tập</h2>
                <p class="pre detail-description">@(string.IsNullOrWhiteSpace(Model.MucTieu) ? "Người đăng chưa bổ sung mục tiêu học tập." : Model.MucTieu)</p>
            </article>
            <article class="card detail-section">
                <h2>Điều kiện học</h2>
                <dl class="detail-facts">
                    <div><dt>Khối lớp</dt><dd>@(string.IsNullOrWhiteSpace(Model.KhoiLop) ? "Chưa cập nhật" : int.TryParse(Model.KhoiLop, out _) ? "Lớp " + Model.KhoiLop : Model.KhoiLop)</dd></div>
                    @if (Model.PhanKhoaHoc != 0)
                    {
                        <div><dt>Phần kiến thức</dt><dd>@(Model.PhanKhoaHoc == 7 ? "Toàn bộ môn" : PhamViMonHoc.MoTaPhan(Model.PhanKhoaHoc))</dd></div>
                    }
                    <div><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd></div>
                    <div><dt>Học phí dự kiến</dt><dd class="detail-fee">@Rules.Fee(Model.HocPhiDuKien, Model.DonViHocPhi)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.KhuVuc))
                    {
                        <div><dt>Khu vực</dt><dd>@string.Join(", ", new[] { Model.PhuongXa, Model.KhuVuc }.Where(value => !string.IsNullOrWhiteSpace(value)))</dd></div>
                    }
                </dl>
            </article>
            <article class="card detail-section">
                <h2>Thời gian có thể học</h2>
                @if (Model.Slots.Count > 0)
                {
                    <table class="table need-schedule">
                        <caption class="visually-hidden">Các khung giờ rảnh do người đăng cung cấp</caption>
                        <thead><tr><th scope="col">Ngày</th><th scope="col">Bắt đầu</th><th scope="col">Kết thúc</th></tr></thead>
                        <tbody>
                            @foreach (var slot in Model.Slots.OrderBy(item => (item.ThuTrongTuan + 6) % 7).ThenBy(item => item.GioBatDau))
                            {
                                <tr><th scope="row">@(slot.ThuTrongTuan == 0 ? "Chủ nhật" : "Thứ " + (slot.ThuTrongTuan + 1))</th><td>@slot.GioBatDau.ToString("HH:mm")</td><td>@slot.GioKetThuc.ToString("HH:mm")</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="muted">Người đăng chưa bổ sung khung giờ học.</p>
                }
            </article>
        }
        @if (!preview && canSeeReviews)
        {
            <section class="card detail-section profile-reviews" id="profile-reviews" aria-label="Đánh giá">
                <h2>@(tutor ? "Đánh giá" : "Đánh giá người đăng")</h2>
                <partial name="_DanhGiaTomTat" model="Model.ChuSoHuuId" />
            </section>
        }
    </section>
    @if (!preview)
    {
        <div class="profile-side">
            <partial name="_ProfileContact" model="Model" />
            @if (authenticated && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.ChuSoHuuId.ToString())
            {
                <a class="report-icon profile-report" aria-label="Báo cáo vi phạm" title="Báo cáo vi phạm" data-modal href="/QuanTri/BaoCaoViPham/Gui?loaiDoiTuong=@(tutor ? "HoSoGiaSu" : "NhuCauHoc")&doiTuongId=@Model.Id"></a>
            }
        </div>
    }
    else
    {
        <aside class="card profile-contact"><h2>Hồ sơ công khai</h2><a class="btn btn-outline-primary" href="/NhuCau/HoSoGiaSu/Sua">Về quản lý hồ sơ</a></aside>
    }
</div>
@if(tutor && !preview && ViewBag.RelatedTutors is List<GiaSuLienQuanViewModel> relatedTutors && relatedTutors.Count > 0)
{
    ViewData["SourceProfileId"] = Model.Id;
    <partial name="_GiaSuLienQuan" model="relatedTutors" />
}
@if (!tutor && related.Count > 0)
{
    <section class="related-needs">
        <h2>Nhu cầu khác của @Model.HoTen</h2>
        <div class="cards">
            @foreach (var item in related) { <partial name="_Candidate" model="item" /> }
        </div>
    </section>
}

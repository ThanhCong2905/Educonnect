@model UngVienViewModel
@inject NguoiDungMauService Current
@{ViewData["Title"]="Hồ sơ chi tiết";var me=await Current.HienTaiAsync();var contact=(YeuCauLienHe?)ViewBag.Contact;}
<div class="heading profile-hero"><div><p class="eyebrow">@Rules.Label(Model.LoaiNguoi)</p><h1>@Model.HoTen</h1><p>@Model.ChuyenMon</p><p>@Model.TrinhDo · @Model.KinhNghiem</p></div></div><div class="split profile-layout"><section>@if(Model.LoaiNguoi=="GiaSu"){<article class="card profile-overview"><p class="eyebrow">THÔNG TIN GIA SƯ</p><h2>Chuyên môn & kinh nghiệm</h2><dl class="profile-facts"><dt>Họ tên</dt><dd>@Model.HoTen</dd><dt>Trình độ</dt><dd>@(string.IsNullOrWhiteSpace(Model.TrinhDo)?"Chưa cập nhật":Model.TrinhDo)</dd><dt>Chuyên môn</dt><dd>@(string.IsNullOrWhiteSpace(Model.ChuyenMon)?"Chưa cập nhật":Model.ChuyenMon)</dd><dt>Kinh nghiệm</dt><dd>@(string.IsNullOrWhiteSpace(Model.KinhNghiem)?"Chưa cập nhật":Model.KinhNghiem)</dd><dt>Khu vực giảng dạy</dt><dd>@(string.IsNullOrWhiteSpace(Model.KhuVucGiaSu)?"Chưa cập nhật":Model.KhuVucGiaSu)</dd></dl><h3>Môn học & phạm vi dạy</h3><div class="profile-subjects">@foreach(var subject in Model.MonDay){<span class="badge rounded-pill">@subject</span>}</div></article>}
<article class="card"><h2>Giới thiệu</h2><p class="pre">@(Model.MoTa??Model.MucTieu)</p></article><article class="card"><h2>Thông tin nhận lớp</h2><partial name="_Candidate" model="Model"/></article></section><partial name="_ProfileContact" model="Model"/></div><section class="related-needs"><div class="heading"><div><h2>Các nhu cầu công khai của @Model.HoTen</h2></div></div><div class="cards">@foreach(var n in ((List<UngVienViewModel>)ViewBag.Related).Where(n=>n.Id!=Model.Id)){<partial name="_Candidate" model="n"/>}</div>@if(!((List<UngVienViewModel>)ViewBag.Related).Any(n=>n.Id!=Model.Id)){<p class="muted">Chưa có nhu cầu công khai nào khác.</p>}</section>

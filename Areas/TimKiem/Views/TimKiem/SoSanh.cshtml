@model List<UngVienViewModel>
@{ViewData["Title"]="So sánh đối tượng";}
<h1>So sánh lựa chọn</h1><div class="table-responsive table-wrap"><table class="table table-hover align-middle"><thead><tr><th>Tiêu chí</th>@foreach(var n in Model){<th>@n.HoTen</th>}</tr></thead><tbody>@foreach(var criterion in new[]{"Môn học","Khối lớp","Hình thức","Khu vực","Học phí","Lịch rảnh","Mục tiêu"}){<tr><th>@criterion</th>@foreach(var n in Model){<td>@(criterion switch{"Môn học"=>n.TenMon,"Khối lớp"=>n.KhoiLop,"Hình thức"=>Rules.Label(n.HinhThucHoc),"Khu vực"=>n.KhuVuc,"Học phí"=>Rules.Fee(n.HocPhiDuKien,n.DonViHocPhi),"Lịch rảnh"=>string.Join(" · ",n.Slots.Select(s=>$"{(s.ThuTrongTuan==0?"CN":"T"+(s.ThuTrongTuan+1))} {s.GioBatDau:HH:mm}–{s.GioKetThuc:HH:mm}")),_=>n.MucTieu})</td>}</tr>}<tr><th>Chi tiết</th>@foreach(var n in Model){<td><a class="btn btn-outline-primary secondary" asp-action="ChiTiet" asp-route-id="@n.Id">Xem hồ sơ</a></td>}</tr></tbody></table></div>

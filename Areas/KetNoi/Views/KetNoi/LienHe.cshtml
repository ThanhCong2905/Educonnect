@inject NguoiDungHienTaiService Current
@{
 ViewData["Title"]="Liên hệ";
 var me=await Current.HienTaiAsync();
 var people=await Current.DanhSachAsync();
 var contacts=(List<YeuCauLienHe>)ViewBag.Contacts;
 var needs=(List<NhuCauHoc>)ViewBag.Needs;
 var subjects=(List<MonHoc>)ViewBag.Subjects;
 var chats=(Dictionary<Guid,Guid>)ViewBag.Chats;
 var requests=(List<YeuCauKetNoiLopHoc>)ViewBag.Requests;
 var classes=(Dictionary<Guid,LopHoc>)ViewBag.ConnectedClasses;
}
<section id="connection-content">
<partial name="_ConnectionSnapshot"/><h1>Liên hệ & kết nối</h1>

<partial name="_KetNoiTabs"/>
<div class="connection-heading"><div><h2>Yêu cầu liên hệ <span class="muted">(<span data-connection-count>@contacts.Count</span>)</span></h2><p>Lời mời và các cuộc trao đổi của bạn.</p></div></div>
<div class="connection-cards" data-connection-list>
@foreach(var contact in contacts){
 var other=people.FirstOrDefault(x=>x.Id==(contact.GiaSuId==me.Id?contact.BenHocId:contact.GiaSuId));
 var sent=contact.NguoiGuiId==me.Id;
 var connected=classes.GetValueOrDefault(contact.Id);
 var pending=requests.FirstOrDefault(r=>r.LienHeId==contact.Id&&(r.TrangThai is "ChoGiaSu" or "ChoBenHoc")&&r.HetHanLuc>DateTimeOffset.UtcNow);
 <article class="card connection-card" id="@contact.Id" data-connection-card data-live-version="@Convert.ToBase64String(contact.RowVersion)" data-live-state="@contact.TrangThai" data-live-actionable="@(connected?.Id.ToString() ?? pending?.Id.ToString() ?? "new")">
  <div class="contact-card-top">
   <div class="contact-statuses">
    <span class="state-tag" data-state="@contact.TrangThai">@(contact.TrangThai == "ChapNhan" ? "Đã chấp nhận liên hệ" : Rules.Label(contact.TrangThai))</span>
    @if(connected!=null){<span class="state-tag" data-state="DaLienKet">Đã kết nối</span>}
   </div>
   <small>@(sent?"Bạn đã gửi":"Lời mời nhận được")</small>
  </div>
  <div class="person"><span class="avatar" aria-hidden="true">@(other?.HoTen.FirstOrDefault().ToString()??"?")</span><div><h3>@other?.HoTen</h3><small>@Rules.Label(other?.LoaiNguoi)</small></div></div>
  <p class="contact-message pre">@contact.LoiNhan</p>
  <small class="contact-date">Gửi lúc @Rules.Date(contact.GuiLuc)</small>
  <div class="contact-card-footer">
  @if(contact.TrangThai=="ChoPhanHoi"){
   <p class="muted">@(sent?"Đang chờ bên kia phản hồi.":"Chấp nhận lời mời để mở cuộc trò chuyện.")</p>
   <form method="post" asp-action="PhanHoiLienHe" class="actions">
    <input name="id" value="@contact.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(contact.RowVersion)" type="hidden">
    @if(sent){<button class="btn btn-outline-primary" name="action" data-confirm="Bạn muốn rút lời mời liên hệ này?" value="DaRut">Rút lời mời</button>}
    else{<button class="btn btn-primary" name="action" value="ChapNhan">Chấp nhận</button><button class="btn btn-outline-primary" name="action" data-confirm="Bạn muốn từ chối lời mời liên hệ này?" value="TuChoi">Từ chối</button>}
   </form>
  }else if(contact.TrangThai=="ChapNhan"){
   
   <div class="actions">
    @if(chats.TryGetValue(contact.Id,out var chat)){<a class="btn btn-outline-primary" href="/HocTap/TinNhan/Index?id=@chat">Nhắn tin</a>}
    @if(connected!=null){<a class="btn btn-primary" asp-area="HocTap" asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@connected.Id">Vào lớp học</a>}
    else if(pending!=null){<a class="btn btn-outline-primary" asp-action="ChiTiet" asp-route-id="@pending.Id">Xem yêu cầu đang chờ</a>}
    else if(me.LoaiNguoi=="GiaSu"){<a data-modal class="btn btn-primary" asp-action="DeXuat" asp-route-contact="@contact.Id">Đề xuất lớp học</a>}else{<button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#connection-request-modal" data-contact-id="@contact.Id" data-contact-name="@other?.HoTen">Gửi nhu cầu học</button>}
   </div>
  }else{<p class="muted">@(contact.TrangThai=="DaRut"?"Lời mời đã được rút.":"Lời mời này đã được xử lý.")</p>}
  </div>
 </article>
}
@if(contacts.Count==0){<div class="empty"><h3>Chưa có liên hệ</h3><p>Tìm người phù hợp và gửi lời mời để bắt đầu trao đổi.</p><a class="btn btn-primary" href="/TimKiem/TimKiem/Index">Tìm kiếm</a></div>}
</div>
@if(me.LoaiNguoi!="GiaSu"){
<div class="modal fade request-composer" id="connection-request-modal" tabindex="-1" aria-labelledby="connection-request-title" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 id="connection-request-title" class="modal-title fs-5">Gửi yêu cầu kết nối</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
  <div class="modal-body">
   <div class="request-recipient"><span class="recipient-icon"><img src="/images/ui/person-badge.svg" alt=""></span><div><small>Gửi đến gia sư</small><strong data-contact-recipient></strong></div></div>
   <form method="post" asp-action="GuiYeuCau">
    <input name="LienHeId" type="hidden">
    <label>Nhu cầu học<select class="form-select" name="NhuCauId" data-request-need required><option value="">Chọn nhu cầu của bạn</option>@foreach(var need in needs.Where(n=>n.TrangThai=="DangMo")){<option value="@need.Id" data-goal="@need.MucTieu">@string.Join(", ", subjects.Where(s=>need.CacMonHocId.Contains(s.Id)).Select(s=>s.TenMon)) · @need.KhoiLop · @Rules.Date(need.TaoLuc)</option>}</select></label>
    <div class="request-preview" data-request-preview hidden><strong>Mục tiêu học tập</strong><p data-request-goal></p></div>
    <label>Lời nhắn<textarea class="form-control" name="LoiNhan" required maxlength="256" rows="3" placeholder="Mình muốn học theo nhu cầu này. Bạn xem giúp mình nhé."></textarea></label>
    <p class="contact-help">Gia sư sẽ gửi lại điều kiện lớp học để bạn xác nhận.</p>
    <div class="actions"><button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Để sau</button><button class="btn btn-primary">Gửi yêu cầu</button></div>
   </form>
  </div>
 </div></div>
</div>}

</section>

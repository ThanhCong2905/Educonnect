@inject NguoiDungMauService Current
@{ViewData["Title"]="Kết nối";var me=await Current.HienTaiAsync();var people=await Current.DanhSachAsync();var cs=(List<YeuCauLienHe>)ViewBag.Contacts;var rs=(List<YeuCauKetNoiLopHoc>)ViewBag.Requests;var needs=(List<NhuCauHoc>)ViewBag.Needs;}
<h1>Liên hệ & kết nối</h1><p>Theo dõi yêu cầu kết nối và xác nhận điều kiện lớp học.</p><partial name="_KetNoiTabs"/><h2>Yêu cầu kết nối</h2><div class="stack">@foreach(var r in rs){<article class="card" id="@r.Id"><span class="badge rounded-pill">@Rules.Label(r.TrangThai)</span><h3>@(r.TenLopDuKien??"Yêu cầu kết nối")</h3><p>@r.LoiNhan</p><small>Hạn xử lý: @Rules.Date(r.HetHanLuc)</small><div class="actions"><a class="btn btn-outline-primary secondary" asp-action="ChiTiet" asp-route-id="@r.Id">Xem chi tiết</a>@if(me.Id==r.GiaSuId&&(r.TrangThai=="ChoGiaSu"||r.TrangThai=="ChoBenHoc")&&r.HetHanLuc>DateTimeOffset.UtcNow){<a data-modal class="btn btn-primary" asp-action="DeXuat" asp-route-contact="@r.LienHeId" asp-route-id="@r.Id">@(r.TrangThai=="ChoGiaSu"?"Gửi đề xuất lớp":"Sửa và gửi xác nhận lại")</a>}</div></article>}@if(rs.Count==0){<div class="empty">Chưa có yêu cầu kết nối.</div>}</div>
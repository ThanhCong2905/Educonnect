@inject NguoiDungHienTaiService Current
@{ViewData["Title"]="Kết nối";var me=await Current.HienTaiAsync();var people=await Current.DanhSachAsync();var cs=(List<YeuCauLienHe>)ViewBag.Contacts;var rs=(List<YeuCauKetNoiLopHoc>)ViewBag.Requests;var needs=(List<NhuCauHoc>)ViewBag.Needs;}
<section id="connection-content"><partial name="_ConnectionSnapshot"/><h1>Liên hệ & kết nối</h1><partial name="_KetNoiTabs"/><h2>Đề xuất lớp học</h2><div class="stack" data-connection-list>@foreach(var r in rs){<article class="card" id="@r.Id" data-connection-card data-live-version="@Convert.ToBase64String(r.RowVersion)" data-live-state="@r.TrangThai" data-live-actionable="@((r.TrangThai is "ChoGiaSu" or "ChoBenHoc") && r.HetHanLuc > DateTimeOffset.UtcNow ? "true" : "false")"><span class="badge rounded-pill">@Rules.Label(r.TrangThai)</span><h3>@(r.TenLopDuKien??"Đề xuất lớp học")</h3><p>@r.LoiNhan</p><small>Hạn xử lý: @Rules.Date(r.HetHanLuc)</small><div class="actions"><a class="btn btn-outline-primary secondary" asp-action="ChiTiet" asp-route-id="@r.Id">Xem chi tiết</a>@if((r.NguoiDeXuatId==me.Id||r.NguoiDeXuatId==null&&me.Id==r.GiaSuId)&&(r.TrangThai=="ChoGiaSu"||r.TrangThai=="ChoBenHoc")&&r.HetHanLuc>DateTimeOffset.UtcNow){<a data-modal class="btn btn-primary" asp-action="DeXuat" asp-route-contact="@r.LienHeId" asp-route-id="@r.Id">@(r.TrangThai=="ChoGiaSu"?"Gửi đề xuất lớp":"Sửa và gửi xác nhận lại")</a>}</div></article>}@if(rs.Count==0){<div class="empty">Chưa có đề xuất lớp học.</div>}</div>
</section>

@model YeuCauKetNoiLopHoc
@inject NguoiDungHienTaiService Current
@{ViewData["Title"]="Chi tiết yêu cầu kết nối";var me=await Current.HienTaiAsync();var people=await Current.DanhSachAsync();var senderId=Model.NguoiDeXuatId??Model.NguoiGuiId;var senderName=people.FirstOrDefault(person=>person.Id==senderId)?.HoTen;var active=(Model.TrangThai=="ChoGiaSu"||Model.TrangThai=="ChoBenHoc")&&Model.HetHanLuc>DateTimeOffset.UtcNow;}
<h1>@(Model.TenLopDuKien??"Yêu cầu kết nối")</h1><article class="card form-wide"><span class="badge rounded-pill">@Rules.Label(Model.TrangThai)</span><p class="muted">Người gửi · @senderName</p><p>@Model.LoiNhan</p>@if(Model.TrangThai == "NhuCauDaKetNoi")
{
    <p class="muted">Nhu cầu này đã có lớp học. Đề nghị đã kết thúc.</p>
}
@if(Model.NguoiDeXuatId == null)
{
    @if(active){<p>Gia sư xem nhu cầu và chuẩn bị điều kiện lớp để bên học xác nhận.</p>}
    @if(ViewBag.RequestNeed is NhuCauHoc need)
    {
        <section class="soft"><h2>Nhu cầu đã gửi</h2><p>@need.KhoiLop · @Rules.Label(need.HinhThucHoc)</p><p>@need.MucTieu</p></section>
    }
    @if(Model.TrangThai != "NhuCauDaKetNoi"){<p class="muted">Hạn phản hồi: @Rules.Date(Model.HetHanLuc)</p>}
}
else
{
<dl><dt>Người học</dt><dd>@Model.TenNguoiHoc</dd><dt>Mục tiêu</dt><dd>@Model.MucTieu</dd><dt>Học phí</dt><dd>@Rules.Fee(Model.HocPhi,Model.DonViHocPhi)</dd><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd><dt>Địa điểm</dt><dd>@Model.DiaDiem</dd><dt>Số buổi / tuần</dt><dd>@Model.SoBuoiTuan</dd><dt>Thời lượng</dt><dd>@Model.ThoiLuongPhut phút</dd><dt>Ngày bắt đầu</dt><dd>@(Model.BatDauHocLuc==null?"Chưa có":Rules.Date(Model.BatDauHocLuc.Value))</dd>@if(Model.TrangThai != "NhuCauDaKetNoi"){<dt>Hạn xác nhận</dt><dd>@Rules.Date(Model.HetHanLuc)</dd>}</dl><h3>Lịch dự kiến</h3>@foreach(var s in (List<KhungGioDeXuat>)ViewBag.Slots){<p>@(s.ThuTrongTuan==0?"Chủ nhật":"Thứ "+(s.ThuTrongTuan+1)) · @s.GioBatDau – @s.GioKetThuc</p>}
}
@if(active){<div class="actions">@if(me.Id==Model.GiaSuId){<a data-modal class="btn btn-primary" asp-action="DeXuat" asp-route-contact="@Model.LienHeId" asp-route-id="@Model.Id">Chuẩn bị đề xuất lớp</a>}@if(Model.NguoiDeXuatId==Model.GiaSuId&&Model.BenHocId==me.Id){<form method="post" asp-action="ChapNhan"><input name="id" value="@Model.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden"><button class="btn btn-primary">Xác nhận điều kiện và tạo lớp</button></form>}<form method="post" asp-action="PhanHoi"><input name="id" value="@Model.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden">@{var sender=Model.NguoiDeXuatId??Model.NguoiGuiId;}<button class="btn btn-outline-primary" name="action" data-confirm="@(sender==me.Id?"Bạn muốn rút đề xuất này?":"Bạn muốn từ chối đề xuất này?")" value="@(sender==me.Id?"DaRut":"TuChoi")">@(sender==me.Id?"Rút yêu cầu":"Từ chối")</button></form></div>}</article>
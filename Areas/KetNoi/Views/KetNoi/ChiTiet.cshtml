@model YeuCauKetNoiLopHoc
@inject NguoiDungMauService Current
@{ViewData["Title"]="Chi tiết yêu cầu kết nối";var me=await Current.HienTaiAsync();var active=(Model.TrangThai=="ChoGiaSu"||Model.TrangThai=="ChoBenHoc")&&Model.HetHanLuc>DateTimeOffset.UtcNow;}
<h1>@(Model.TenLopDuKien??"Yêu cầu kết nối")</h1><article class="card form-wide"><span class="badge rounded-pill">@Rules.Label(Model.TrangThai)</span><p>@Model.LoiNhan</p><dl><dt>Mục tiêu</dt><dd>@Model.MucTieu</dd><dt>Học phí</dt><dd>@Rules.Fee(Model.HocPhi,Model.DonViHocPhi)</dd><dt>Hình thức</dt><dd>@Rules.Label(Model.HinhThucHoc)</dd><dt>Địa điểm</dt><dd>@Model.DiaDiem</dd><dt>Số buổi / tuần</dt><dd>@Model.SoBuoiTuan</dd><dt>Thời lượng</dt><dd>@Model.ThoiLuongPhut phút</dd><dt>Ngày bắt đầu</dt><dd>@(Model.BatDauHocLuc==null?"Chưa có":Rules.Date(Model.BatDauHocLuc.Value))</dd><dt>Hạn xác nhận</dt><dd>@Rules.Date(Model.HetHanLuc)</dd></dl><h3>Lịch dự kiến</h3>@foreach(var s in (List<KhungGioDeXuat>)ViewBag.Slots){<p>@(s.ThuTrongTuan==0?"Chủ nhật":"Thứ "+(s.ThuTrongTuan+1)) · @s.GioBatDau – @s.GioKetThuc</p>}@if(active){<div class="actions">@if(Model.TrangThai=="ChoBenHoc"&&me.Id==Model.BenHocId){<form method="post" asp-action="ChapNhan"><input name="id" value="@Model.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden"><button class="btn btn-primary">Xác nhận điều kiện và tạo lớp</button></form>}<form method="post" asp-action="PhanHoi"><input name="id" value="@Model.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden">@{var sender=Model.TrangThai=="ChoBenHoc"?Model.GiaSuId:Model.NguoiGuiId;}<button class="btn btn-primary" name="action" value="@(sender==me.Id?"DaRut":"TuChoi")">@(sender==me.Id?"Rút yêu cầu":"Từ chối")</button></form></div>}</article>
@model EduConnect.Mvc.Areas.KetNoi.ViewModels.DeXuatLopViewModel

@{ViewData["Title"]="Đề xuất lớp học";}
<h1>Đề xuất lớp học</h1><p>Bên học phải xác nhận lại mỗi khi điều kiện đề xuất thay đổi.</p><form method="post" class="card form-wide"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"><input asp-for="LienHeId" type="hidden"><input asp-for="RowVersion" type="hidden"><label>Tên lớp<input class="form-control" asp-for="TenLop" required maxlength="256"></label><label>Mục tiêu<textarea class="form-control" asp-for="MucTieu" required maxlength="256"></textarea></label><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Môn học<select class="form-select" asp-for="MonHocId">@foreach(var s in (List<MonHoc>)ViewBag.Subjects){<option value="@s.Id">@s.TenMon</option>}</select></label><label>Nhu cầu bên học<input asp-for="NhuCauId" type="hidden"><span>@(Model.NhuCauId==null?"Chưa gắn nhu cầu; phụ huynh cần gửi yêu cầu kèm nhu cầu trước.":"Đã gắn nhu cầu học")</span></label><label>Số buổi / tuần<input class="form-control" asp-for="SoBuoiTuan" type="number" min="1" max="7"></label><label>Thời lượng / buổi (phút)<input class="form-control" asp-for="ThoiLuongPhut" type="number" min="1" max="480"></label><label>Ngày bắt đầu<input class="form-control" asp-for="BatDauHocLuc" type="datetime-local"></label><label>Hình thức<select class="form-select" asp-for="HinhThucHoc" data-mode><option value="TrucTuyen">Trực tuyến</option><option value="TrucTiep">Trực tiếp</option></select></label><label data-inperson>Địa điểm<input class="form-control" asp-for="DiaDiem" maxlength="256"></label><label>Học phí<input class="form-control" asp-for="HocPhi" type="number" min="0" step="0.01"></label><label>Đơn vị<select class="form-select" asp-for="DonViHocPhi"><option value="VND/Gio">VND / giờ</option><option value="VND/Buoi">VND / buổi</option></select></label></div><fieldset><legend>Lịch dự kiến hằng tuần</legend><partial name="_Slots" model="Model.LichRanh"/></fieldset><div class="alert alert-info notice">Số khung giờ phải bằng số buổi/tuần. Mỗi khung phải đúng thời lượng một buổi.</div><button class="btn btn-primary">Gửi đề xuất để xác nhận</button></form>


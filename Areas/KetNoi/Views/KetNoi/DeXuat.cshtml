@model EduConnect.Mvc.Areas.KetNoi.ViewModels.DeXuatLopViewModel

@{ViewData["Title"]="Đề xuất lớp học";}
<h1>Đề xuất lớp học</h1><p>Bên nhận xem lại điều kiện trước khi xác nhận tạo lớp.</p><form method="post" class="card form-wide" data-class-proposal><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"><input asp-for="LienHeId" type="hidden"><input asp-for="RowVersion" type="hidden"><label>Tên lớp<input class="form-control" asp-for="TenLop" required maxlength="256"></label><label>Mục tiêu<textarea class="form-control" asp-for="MucTieu" required maxlength="2000"></textarea></label><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Môn học<select class="form-select" asp-for="MonHocId">@foreach(var s in (List<MonHoc>)ViewBag.Subjects){<option value="@s.Id">@s.TenMon</option>}</select></label><label>Nhu cầu bên học<select class="form-select" asp-for="NhuCauId" data-proposal-need><option value="">Chưa gắn nhu cầu</option>@foreach(var need in (List<NhuCauHoc>)ViewBag.ProposalNeeds){<option value="@need.Id" selected="@(Model.NhuCauId==need.Id)" data-goal="@need.MucTieu" data-sessions="@need.SoBuoiTuan" data-mode="@need.HinhThucHoc" data-address="@need.DiaChiChiTiet">@need.KhoiLop · @need.MucTieu</option>}</select></label><label>Số buổi / tuần<input class="form-control" asp-for="SoBuoiTuan" type="number" min="1" max="7"></label><label>Thời lượng / buổi (phút)<input class="form-control" asp-for="ThoiLuongPhut" type="number" min="1" max="480"></label><label>Ngày bắt đầu<input class="form-control" asp-for="BatDauHocLuc" type="datetime-local"></label><label>Hình thức<select class="form-select" asp-for="HinhThucHoc" data-mode><option value="TrucTuyen">Trực tuyến</option><option value="TrucTiep">Trực tiếp</option></select></label><label data-inperson>Địa điểm<input class="form-control" asp-for="DiaDiem" maxlength="500"></label><label>Học phí<input class="form-control" asp-for="HocPhi" type="number" min="0" step="1"></label><label>Đơn vị<select class="form-select" asp-for="DonViHocPhi"><option value="VND/Gio">VND / giờ</option><option value="VND/Buoi">VND / buổi</option></select></label></div><fieldset><legend>Lịch dự kiến hằng tuần</legend><partial name="_Slots" model="Model.LichRanh"/></fieldset><div class="alert alert-info notice">Số khung giờ phải bằng số buổi/tuần. Mỗi khung phải đúng thời lượng một buổi.</div><label>Lời nhắn<textarea class="form-control" asp-for="LoiNhan" maxlength="2000"></textarea><span asp-validation-for="LoiNhan"></span></label><button class="btn btn-primary">Gửi đề xuất để xác nhận</button></form>


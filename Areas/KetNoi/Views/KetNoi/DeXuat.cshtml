@model EduConnect.Mvc.Areas.KetNoi.ViewModels.DeXuatLopViewModel

@{ViewData["Title"]="Đề xuất lớp học";}

<div class="proposal-intro"><h1>Đề xuất lớp học</h1><p>Thống nhất thông tin và lịch học trước khi bên học xác nhận.</p></div>

<form method="post" class="card form-wide proposal-form" data-class-proposal>
<div asp-validation-summary="All" class="validation"></div>
<input asp-for="Id" type="hidden"><input asp-for="LienHeId" type="hidden"><input asp-for="RowVersion" type="hidden">
<fieldset>
<legend>Thông tin lớp học</legend>

<div class="proposal-fields"><label>Tên người học<input class="form-control" asp-for="TenNguoiHoc" required maxlength="256"><span asp-validation-for="TenNguoiHoc"></span></label>

<label>Tên lớp<input class="form-control" asp-for="TenLop" required maxlength="256"><span asp-validation-for="TenLop"></span></label>

<label class="full-width">Mục tiêu<textarea class="form-control" asp-for="MucTieu" required maxlength="2000" rows="3"></textarea><span asp-validation-for="MucTieu"></span></label></div>
</fieldset>

<fieldset>
<legend>Điều kiện học</legend>

<div class="proposal-fields">
<label>Môn học<select class="form-select" asp-for="MonHocId">@foreach(var s in (List<MonHoc>)ViewBag.Subjects){<option value="@s.Id">@s.TenMon</option>}</select><span asp-validation-for="MonHocId"></span></label>

<label>Nhu cầu bên học<select class="form-select" asp-for="NhuCauId" data-proposal-need><option value="">Chưa gắn nhu cầu</option>@foreach(var need in (List<NhuCauHoc>)ViewBag.ProposalNeeds){<option value="@need.Id" selected="@(Model.NhuCauId==need.Id)" data-learner="@need.TenNguoiHoc" data-subject="@need.MonHocId" data-goal="@need.MucTieu" data-sessions="@need.SoBuoiTuan" data-mode="@need.HinhThucHoc" data-address="@need.DiaChiChiTiet">@need.KhoiLop · @need.MucTieu</option>}</select><span asp-validation-for="NhuCauId"></span></label>

<label>Số buổi / tuần<input class="form-control" asp-for="SoBuoiTuan" type="number" min="1" max="7"><span asp-validation-for="SoBuoiTuan"></span></label>

<label>Thời lượng / buổi (phút)<input class="form-control" asp-for="ThoiLuongPhut" type="number" min="1" max="480"><span asp-validation-for="ThoiLuongPhut"></span></label>

<label>Ngày bắt đầu<input class="form-control" asp-for="BatDauHocLuc" type="datetime-local"><span asp-validation-for="BatDauHocLuc"></span></label>

<label>Hình thức<select class="form-select" asp-for="HinhThucHoc" data-mode><option value="">Chọn hình thức học</option><option value="TrucTuyen">Trực tuyến</option><option value="TrucTiep">Trực tiếp</option></select><span asp-validation-for="HinhThucHoc"></span></label>

<label data-inperson>Địa điểm<input class="form-control" asp-for="DiaDiem" maxlength="500"><span asp-validation-for="DiaDiem"></span></label>

<label>Học phí<input class="form-control" asp-for="HocPhi" type="number" min="0" step="1"><span asp-validation-for="HocPhi"></span></label>

<label>Đơn vị<select class="form-select" asp-for="DonViHocPhi"><option value="VND/Gio">VND / giờ</option><option value="VND/Buoi">VND / buổi</option></select><span asp-validation-for="DonViHocPhi"></span></label>
</div>
</fieldset>

<fieldset>
<legend>Lịch dự kiến hằng tuần</legend>

<partial name="_Slots" model="Model.LichRanh"/><p class="proposal-hint">Chọn đủ số buổi mỗi tuần, mỗi khung giờ đúng thời lượng đã nhập.</p></fieldset>


<div class="actions"><button class="btn btn-primary">Gửi bên học xác nhận</button><a class="btn btn-outline-primary" asp-action="Index" data-page-back>Quay lại</a></div>
</form>

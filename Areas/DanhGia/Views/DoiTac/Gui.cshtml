@model DanhGiaDoiTacViewModel
@{ViewData["Title"]="Đánh giá người dùng";}
<h1>Đánh giá người dùng</h1>
<form method="post" class="card review-form"><div asp-validation-summary="All" class="validation" role="alert"></div>
    <input asp-for="MaLop" type="hidden">
    <label asp-for="SoSao">Trải nghiệm học cùng người dùng <span class="required-mark" aria-hidden="true">*</span></label>
    <fieldset class="rating-choice"><legend class="visually-hidden">Số sao đánh giá</legend>
    @for(var star=1;star<=5;star++)
    {
        <label><input type="radio" asp-for="SoSao" value="@star" required><span aria-hidden="true">★</span><small>@star sao</small></label>
    }
    </fieldset><span asp-validation-for="SoSao"></span>
    <label asp-for="NhanXet" class="mt-3">Nhận xét <span class="required-mark" aria-hidden="true">*</span></label><textarea asp-for="NhanXet" class="form-control" rows="5" minlength="10" maxlength="2000" required></textarea><span asp-validation-for="NhanXet"></span>
    <label class="mt-3"><input asp-for="XacNhanRiengTu" required> Tôi đã kiểm tra nhận xét và bỏ thông tin riêng tư.</label><span asp-validation-for="XacNhanRiengTu"></span>
    <p class="muted">Mỗi bên được gửi một đánh giá cho lớp đã kết thúc. Vui lòng kiểm tra trước khi gửi.</p>
    <div class="form-footer"><button class="btn btn-primary">Gửi đánh giá</button></div>
</form>

@model DanhGiaDoiTacViewModel
@{ViewData["Title"]="Đánh giá người dùng";}
<h1>Đánh giá người dùng</h1>
<form method="post" class="card"><div asp-validation-summary="All" class="validation" role="alert"></div>
    <input asp-for="MaLop" type="hidden"><input asp-for="RowVersion" type="hidden">
    <label asp-for="SoSao">Trải nghiệm học cùng người dùng <span class="required-mark" aria-hidden="true">*</span></label>
    <select asp-for="SoSao" class="form-select"><option value="5">5 · Rất tốt</option><option value="4">4 · Tốt</option><option value="3">3 · Bình thường</option><option value="2">2 · Chưa tốt</option><option value="1">1 · Rất chưa tốt</option></select>
    <label asp-for="NhanXet" class="mt-3">Nhận xét <span class="required-mark" aria-hidden="true">*</span></label><textarea asp-for="NhanXet" class="form-control" rows="5" minlength="10" maxlength="2000" required></textarea><span asp-validation-for="NhanXet"></span>
    <label class="mt-3"><input asp-for="XacNhanRiengTu" required> Tôi đã kiểm tra nhận xét và bỏ thông tin riêng tư.</label>
    <p class="muted">Bạn có thể sửa trong 7 ngày kể từ lần gửi đầu tiên.</p>
    <button class="btn btn-primary align-self-start">Lưu đánh giá</button>
</form>

@model TepDinhKem
@{
    var fileField = (string)ViewData["FileField"]!;
    var idField = (string)ViewData["IdField"]!;
    var currentId = ViewData["CurrentId"] as Guid?;
    var title = (string)ViewData["EvidenceTitle"]!;
}
<div class="profile-evidence-upload" data-current-evidence="@currentId">
    <input type="hidden" name="@idField" value="@currentId">
    <label>
        @title
        <span class="evidence-file-control">
            <input class="visually-hidden" type="file" name="@fileField" accept=".pdf,.jpg,.jpeg,.png,.docx" aria-label="@title">
            <span class="btn btn-outline-primary">Chọn tệp</span>
            <span data-evidence-filename>Chưa chọn tệp mới</span>
        </span>
        @Html.ValidationMessage(fileField)
        @Html.ValidationMessage(idField)
    </label>
    @if (Model != null)
    {
        <div class="profile-evidence-current" data-saved-evidence>
            @if (TepService.XemTrucTiepDuoc(Model.LoaiNoiDung))
            {
                <a asp-action="BangCap" asp-route-id="@Model.Id" asp-route-xem="true" data-file-preview="@Model.LoaiNoiDung"
                   data-file-name="@Model.TenGoc" target="_blank" rel="noopener">@Model.TenGoc</a>
            }
            else
            {
                <a asp-action="BangCap" asp-route-id="@Model.Id">@Model.TenGoc</a>
            }
            @if (Model.TrangThaiQuet == "ChoQuet")
            {
                <small class="muted">Chưa quét mã độc</small>
            }
            <button type="button" class="upload-remove saved-evidence-remove" data-remove-saved-evidence aria-label="Bỏ tệp @Model.TenGoc" title="Bỏ tệp đã lưu khi lưu hồ sơ">×</button>
        </div>
    }
</div>

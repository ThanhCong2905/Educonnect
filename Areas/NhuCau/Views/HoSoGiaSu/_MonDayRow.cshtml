@model EduConnect.Mvc.Areas.NhuCau.ViewModels.MonDayInput
@{
    var i = (string)ViewData["RowIndex"]!;
    var subjects = ((List<MonHoc>)ViewBag.Subjects)
        .OrderBy(subject => MonHocCatalog.ThuTuHienThi(subject.TenMon));
    var submittedGrades = Model.LopDay.Count > 0 || ViewData.ModelState.ContainsKey($"MonDay[{i}].LopDay");
    var savedGrades = EduConnect.Mvc.Areas.NhuCau.ViewModels.HoSoLuaChon.LopDay(Model.PhamViDay);
}
<div class="subject-fee-row" data-subject-row>
<label>Môn dạy<select class="form-select" name="MonDay[@i].MonHocId" data-subject-select>@foreach(var s in subjects){<option value="@s.Id" selected="@(Model.MonHocId==s.Id)">@s.TenMon</option>}<option value="0" selected="@(Model.MonHocId==0)">Khác</option></select></label>
<label data-custom-subject hidden="@(Model.MonHocId!=0)">Tên môn khác<input class="form-control" name="MonDay[@i].TenMonKhac" value="@Model.TenMonKhac" maxlength="100" disabled="@(Model.MonHocId!=0)"></label>

<label>Phí đề xuất (VND)<input class="form-control" name="MonDay[@i].HocPhiDeXuat" value="@Model.HocPhiDeXuat?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" step="1"></label>
<label>Đơn vị<select class="form-select" name="MonDay[@i].DonViHocPhi"><option value="">Chọn đơn vị</option><option value="VND/Gio" selected="@(Model.DonViHocPhi=="VND/Gio")">VND / giờ</option><option value="VND/Buoi" selected="@(Model.DonViHocPhi=="VND/Buoi")">VND / buổi</option></select></label>
<button type="button" class="btn quiet" data-remove-subject aria-label="Bỏ môn dạy">Bỏ môn</button>
<fieldset class="grade-picker">
    <legend>Phạm vi dạy</legend>
    <div class="grade-options">
        @for (var grade = 1; grade <= 12; grade++)
        {
            <label class="grade-option">
                <input class="form-check-input" type="checkbox" name="MonDay[@i].LopDay" value="@grade" checked="@(submittedGrades ? Model.LopDay.Contains(grade) : savedGrades.Contains($"Lớp {grade}"))">
                <span>Lớp @grade</span>
            </label>
        }
    </div>
    <input type="hidden" name="MonDay[@i].PhamViDay" value="@Model.PhamViDay">
</fieldset>
<div class="subject-evidence">
    @await Html.PartialAsync("_MinhChung", ((List<TepDinhKem>)ViewBag.Certificates).FirstOrDefault(file => file.Id == Model.MinhChungId), new ViewDataDictionary(ViewData)
    {
        ["FileField"] = $"MonDay[{i}].TepMinhChung",
        ["IdField"] = $"MonDay[{i}].MinhChungId",
        ["CurrentId"] = Model.MinhChungId,
        ["EvidenceTitle"] = "Minh chứng môn dạy"
    })
</div>
</div>

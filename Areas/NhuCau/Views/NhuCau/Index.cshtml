@inject TaiKhoanService Account
@model List<NhuCauHoc>
@inject NguoiDungHienTaiService Current
@{ViewData["Title"]="Nhu cầu của tôi";var subjects=(List<MonHoc>)ViewBag.Subjects;var linked=(HashSet<Guid>)ViewBag.Linked; var slots=(List<KhungGioRanh>)ViewBag.Slots; var me=await Current.HienTaiAsync();var account=await Account.LayHoSoAsync(Context);}
<div class="heading"><div><h1>Quản lý nhu cầu</h1><p>Điều kiện và lịch rảnh cho kết nối phù hợp.</p></div><a data-modal class="btn btn-primary" asp-action="Tao">+ Tạo nhu cầu</a></div>
<div class="stats stats-four"><article><small>Tổng nhu cầu</small><strong>@Model.Count</strong></article>@foreach(var state in new[]{"BanNhap","DangMo","DaDong"}){<article><small>@Rules.Label(state)</small><strong>@Model.Count(x=>x.TrangThai==state)</strong></article>}</div>
<div class="cards">
@foreach (var need in Model)
{
    var card = new UngVienViewModel
    {
        Id = need.Id,
        ChuSoHuuId = me.Id,
          AnhDaiDienUrl = account.AnhDaiDienUrl,
        HoTen = me.HoTen,
        LoaiNguoi = me.LoaiNguoi,
        TenMon = string.Join(", ", subjects.Where(subject => need.CacMonHocId.Contains(subject.Id)).OrderBy(subject => subject.Id).Select(subject => subject.TenMon)),
        KhoiLop = need.KhoiLop,
        MucTieu = need.MucTieu,
        HinhThucHoc = need.HinhThucHoc,
        KhuVuc = need.KhuVuc,
        HocPhiDuKien = need.HocPhiDuKien,
        DonViHocPhi = need.DonViHocPhi,
        Slots = slots.Where(slot => slot.NhuCauId == need.Id).Select(slot => new SlotInput
        {
            ThuTrongTuan = slot.ThuTrongTuan,
            GioBatDau = slot.GioBatDau,
            GioKetThuc = slot.GioKetThuc
        }).ToList()
    };
    <partial name="_Candidate" model="card" view-data='new ViewDataDictionary(ViewData) { ["ManagedNeed"] = need, ["NeedLinked"] = linked.Contains(need.Id), ["Compare"] = false }' />
}
</div>
@if(Model.Count==0){<div class="empty"><h2>Bắt đầu từ nhu cầu của bạn</h2><p>Chia sẻ môn học, mục tiêu và lịch rảnh để tìm người phù hợp.</p><a data-modal class="btn btn-primary" asp-action="Tao">Tạo nhu cầu đầu tiên</a></div>}

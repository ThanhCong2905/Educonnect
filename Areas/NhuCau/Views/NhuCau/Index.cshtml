@inject TaiKhoanService Account
@model List<NhuCauHoc>
@inject NguoiDungHienTaiService Current
@{ViewData["Title"]="Nhu cầu của tôi";var subjects=(List<MonHoc>)ViewBag.Subjects;var linked=(HashSet<Guid>)ViewBag.Linked; var slots=(List<KhungGioRanh>)ViewBag.Slots; var me=await Current.HienTaiAsync();var account=await Account.LayHoSoAsync(Context);}
<div class="heading"><h1>Quản lý nhu cầu</h1>@if (Model.Count > 0) { <a data-modal class="btn btn-primary" asp-action="Tao">+ Tạo nhu cầu</a> }</div>
@{ var selectedState = ViewData["SelectedNeedState"] as string ?? "DangMo"; var visibleNeeds = Model.Where(need => need.TrangThai == selectedState).ToList(); }
<p class="muted">@Model.Count(need => need.TrangThai == "DangMo")/3 nhu cầu đang mở</p>
<nav class="need-state-tabs" aria-label="Trạng thái nhu cầu">
    @foreach (var state in new[] { "DangMo", "DaDong", "BanNhap" })
    {
        <a asp-action="Index" asp-route-state="@state" aria-current="@(state == selectedState ? "page" : null)">@Rules.Label(state)<span>@Model.Count(need => need.TrangThai == state)</span></a>
    }
</nav>
<div class="cards">
@foreach (var need in visibleNeeds)
{
    var moderation = ((Dictionary<Guid, EduConnect.Mvc.Areas.NhuCau.ViewModels.NhuCauKiemDuyetViewModel>)ViewBag.Moderation).GetValueOrDefault(need.Id);
    var card = new UngVienViewModel
    {
        Id = need.Id,
        ChuSoHuuId = me.Id,
          AnhDaiDienUrl = account.AnhDaiDienUrl,
        HoTen = me.HoTen,
        LoaiNguoi = me.LoaiNguoi,
        TenMon = string.Join(", ", subjects.Where(subject => need.CacMonHocId.Contains(subject.Id)).OrderBy(subject => subject.Id).Select(subject => subject.TenMon)),
        KhoiLop = need.KhoiLop,
        PhanKhoaHoc = need.PhanKhoaHoc,
        MucTieu = need.MucTieu,
        HinhThucHoc = need.HinhThucHoc,
        KhuVuc = need.KhuVuc,
        PhuongXa = need.PhuongXa,
        HocPhiDuKien = need.HocPhiDuKien,
        DonViHocPhi = need.DonViHocPhi,
        Slots = slots.Where(slot => slot.NhuCauId == need.Id).Select(slot => new SlotInput
        {
            ThuTrongTuan = slot.ThuTrongTuan,
            GioBatDau = slot.GioBatDau,
            GioKetThuc = slot.GioKetThuc
        }).ToList()
    };
    <partial name="_Candidate" model="card" view-data='new ViewDataDictionary(ViewData) { ["ManagedNeed"] = need, ["NeedLinked"] = linked.Contains(need.Id), ["ModerationInfo"] = moderation, ["Compare"] = false }' />
}
</div>
@if (Model.Count > 0 && visibleNeeds.Count == 0) { <div class="empty"><h2>Chưa có nhu cầu @Rules.Label(selectedState).ToLowerInvariant()</h2>@if(selectedState == "DangMo"){<a data-modal class="btn btn-primary" asp-action="Tao">Tạo nhu cầu</a>}</div> }
@if(Model.Count==0){<div class="empty"><h2>Bắt đầu từ nhu cầu của bạn</h2><p>Chia sẻ môn học, mục tiêu và lịch rảnh để tìm người phù hợp.</p><a data-modal class="btn btn-primary" asp-action="Tao">Tạo nhu cầu đầu tiên</a></div>}

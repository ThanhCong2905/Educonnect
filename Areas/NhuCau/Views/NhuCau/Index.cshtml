@model List<NhuCauHoc>
@{ViewData["Title"]="Nhu cầu của tôi";var subjects=(List<MonHoc>)ViewBag.Subjects;var linked=(HashSet<Guid>)ViewBag.Linked;}
<div class="heading"><div><h1>Quản lý nhu cầu</h1><p>Điều kiện và lịch rảnh cho kết nối phù hợp.</p></div><a data-modal class="btn btn-primary" asp-action="Sua">+ Tạo nhu cầu</a></div>
<div class="stats stats-four"><article><small>Tổng nhu cầu</small><strong>@Model.Count</strong></article>@foreach(var state in new[]{"BanNhap","DangMo","DaDong"}){<article><small>@Rules.Label(state)</small><strong>@Model.Count(x=>x.TrangThai==state)</strong></article>}</div>
<div class="cards">@foreach(var n in Model){<article class="card"><div class="card-statuses"><span class="badge rounded-pill">@Rules.Label(n.TrangThai)</span>@if(linked.Contains(n.Id)){<span class="badge rounded-pill badge-linked">Đã kết nối</span>}</div><h2>@subjects.FirstOrDefault(x=>x.Id==n.MonHocId)?.TenMon · @(int.TryParse(n.KhoiLop,out _)?"Lớp "+n.KhoiLop:n.KhoiLop)</h2><p>@n.MucTieu</p><strong class="price">@Rules.Fee(n.HocPhiDuKien,n.DonViHocPhi)</strong><p>@Rules.Label(n.HinhThucHoc)</p>@if(n.TenNguoiHoc!=null){<p>Người học: @n.TenNguoiHoc · @n.TuoiNguoiHoc tuổi</p>}<div class="actions"><a data-modal class="btn btn-outline-primary secondary" asp-action="Sua" asp-route-id="@n.Id">Chỉnh sửa</a>@if(n.TrangThai!="BanNhap"){<form asp-action="TrangThai" method="post"><input type="hidden" name="id" value="@n.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(n.RowVersion)"><button class="btn @(n.TrangThai=="DaDong"?"btn-primary":"btn-outline-primary")" name="state" value="@(n.TrangThai=="DaDong"?"DangMo":"DaDong")">@(n.TrangThai=="DaDong"?"Mở lại":"Đóng nhu cầu")</button></form>}</div></article>}</div>@if(Model.Count==0){<div class="empty"><h2>Bắt đầu từ nhu cầu của bạn</h2><p>Chia sẻ môn học, mục tiêu và lịch rảnh để tìm người phù hợp.</p><a data-modal class="btn btn-primary" asp-action="Sua">Tạo nhu cầu đầu tiên</a></div>}

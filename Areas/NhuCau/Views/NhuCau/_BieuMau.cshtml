@model EduConnect.Mvc.Areas.NhuCau.ViewModels.NhuCauInput
@inject NguoiDungHienTaiService Current
@{var me=await Current.HienTaiAsync();}
@if(ViewBag.ModerationInfo is EduConnect.Mvc.Areas.NhuCau.ViewModels.NhuCauKiemDuyetViewModel moderation)
{
    <section class="bg-light rounded-3 p-3 mb-3"><strong>@(moderation.DangAn?"Nhu cầu đang ẩn khỏi tìm kiếm":"Nhận xét từ quản trị")</strong><p class="pre mb-0 mt-2">@moderation.LyDo</p>@if(moderation.DangAn){<p class="mb-0 mt-2">Sau khi lưu, chọn Đề nghị xem lại ở danh sách nhu cầu để quản trị kiểm tra nội dung đã sửa.</p>}</section>
}
<form asp-action="@(Model.Id == null ? "TaoNhuCauHoc" : "CapNhat")" asp-route-maNhuCau="@Model.Id" method="post" class="card form-wide need-form" data-confirm-fee><div asp-validation-summary="All" class="validation" role="alert"></div><input name="MaNhuCau" value="@Model.Id" type="hidden"><input asp-for="RowVersion" type="hidden"><label>Môn học<select class="form-select" asp-for="MonHocId" required><option value="">Chọn môn học</option>@foreach(var subject in ((List<MonHoc>)ViewBag.Subjects).OrderBy(s => MonHocCatalog.ThuTuHienThi(s.TenMon))){<option value="@subject.Id">@subject.TenMon</option>}</select><span asp-validation-for="MonHocId"></span></label><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Khối lớp<select class="form-select" asp-for="KhoiLop"><option value="">Chọn khối lớp</option>@for(var grade=1;grade<=12;grade++){<option value="Lớp @grade">Lớp @grade</option>}</select><span asp-validation-for="KhoiLop"></span></label><label>Học lực<select class="form-select" asp-for="HocLuc"><option value="">Chọn học lực</option>@foreach(var level in new[]{"Yếu","Trung bình","Khá","Giỏi"}){<option value="@level">@level</option>}</select><span asp-validation-for="HocLuc"></span></label><label>Số buổi mỗi tuần<input class="form-control" asp-for="SoBuoiTuan" required type="number" min="1" max="7"><span asp-validation-for="SoBuoiTuan"></span></label><label>Hình thức<select class="form-select" asp-for="HinhThucHoc" data-mode><option value="TrucTuyen">Trực tuyến</option><option value="TrucTiep">Trực tiếp</option></select></label><div class="need-area-picker" data-inperson><partial name="_KhuVucPicker" model="new EduConnect.Mvc.ViewModels.KhuVucPickerViewModel(Model.KhuVuc, Model.PhuongXa)" /></div><label data-inperson>Địa chỉ chi tiết <small>(không bắt buộc)</small><input class="form-control" asp-for="DiaChiChiTiet" maxlength="500"></label><label>Mức học phí (VND)<input class="form-control" asp-for="HocPhiDuKien" type="number" min="0" step="1"></label><label>Đơn vị học phí<select class="form-select" asp-for="DonViHocPhi"><option value="">Chưa xác định</option><option value="VND/Gio">VND / giờ</option><option value="VND/Buoi">VND / buổi</option></select></label></div><label>Mục tiêu<textarea class="form-control" asp-for="MucTieu" required maxlength="2000"></textarea><span asp-validation-for="MucTieu"></span></label>
<input asp-for="MaThaoTac" type="hidden">
@if(me.LoaiNguoi=="PhuHuynh"){<fieldset><legend>Người học</legend><p class="muted">Thông tin này không hiển thị công khai.</p><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Tên người học<input class="form-control" asp-for="TenNguoiHoc" maxlength="256"></label><label>Tuổi<input class="form-control" asp-for="TuoiNguoiHoc" type="number" min="1" max="120"></label></div></fieldset>}
<fieldset><legend>Lịch rảnh hằng tuần</legend><partial name="_Slots" model="Model.LichRanh"/><span asp-validation-for="LichRanh"></span></fieldset><div class="actions"><button class="btn btn-primary" name="BanNhap" value="false">@(Model.Id==null?"Đăng nhu cầu":"Cập nhật nhu cầu")</button>@if(Model.Id==null){<button class="btn btn-outline-primary secondary" name="BanNhap" value="true" formnovalidate>Lưu bản nháp</button>}<a class="btn btn-outline-primary" asp-action="Index">Quay lại</a></div></form>

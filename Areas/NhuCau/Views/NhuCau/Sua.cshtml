@model EduConnect.Mvc.Areas.NhuCau.ViewModels.NhuCauInput
@inject NguoiDungMauService Current
@{ViewData["Title"]=Model.Id==null?"Tạo nhu cầu":"Chỉnh sửa nhu cầu";var me=await Current.HienTaiAsync();}
<h1>@ViewData["Title"]</h1>
<form asp-action="Luu" method="post" class="card form-wide"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"><input asp-for="RowVersion" type="hidden"><partial name="_MonHocPicker" model="Model.MonHocIds" view-data='new ViewDataDictionary(ViewData) { ["ChonMonKhac"] = Model.ChonMonKhac, ["TenMonKhac"] = Model.TenMonKhac }'/><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Khối lớp<input class="form-control" asp-for="KhoiLop" maxlength="256"></label><label>Học lực<input class="form-control" asp-for="HocLuc" maxlength="256"></label><label>Số buổi mỗi tuần<input class="form-control" asp-for="SoBuoiTuan" required type="number" min="1" max="7"><span asp-validation-for="SoBuoiTuan"></span></label><label>Hình thức<select class="form-select" asp-for="HinhThucHoc" data-mode><option value="TrucTuyen">Trực tuyến</option><option value="TrucTiep">Trực tiếp</option></select></label><label data-inperson>Khu vực<input class="form-control" asp-for="KhuVuc" maxlength="256"></label><label data-inperson>Địa chỉ chi tiết<input class="form-control" asp-for="DiaChiChiTiet" maxlength="256"></label><label>Mức học phí (VND)<input class="form-control" asp-for="HocPhiDuKien" type="number" min="0" step="0.01"></label><label>Đơn vị học phí<select class="form-select" asp-for="DonViHocPhi"><option value="">Chưa xác định</option><option value="VND/Gio">VND / giờ</option><option value="VND/Buoi">VND / buổi</option></select></label></div><label>Mục tiêu<textarea class="form-control" asp-for="MucTieu" required maxlength="256"></textarea><span asp-validation-for="MucTieu"></span></label>
@if(me.LoaiNguoi=="PhuHuynh"){<fieldset><legend>Người học</legend><p class="muted">Thông tin này không hiển thị công khai.</p><div class="row row-cols-1 row-cols-md-2 g-3 edu-form-grid"><label>Tên người học<input class="form-control" asp-for="TenNguoiHoc" maxlength="256"></label><label>Tuổi<input class="form-control" asp-for="TuoiNguoiHoc" type="number" min="1" max="120"></label></div></fieldset>}
<fieldset><legend>Lịch rảnh hằng tuần</legend><partial name="_Slots" model="Model.LichRanh"/></fieldset><div class="actions"><button class="btn btn-primary" name="BanNhap" value="false">Đăng nhu cầu</button><button class="btn btn-outline-primary secondary" name="BanNhap" value="true" formnovalidate>Lưu bản nháp</button><a asp-action="Index">Quay lại</a></div></form>

@model EduConnect.Mvc.Areas.NhuCau.ViewModels.HoSoInput
@{ViewData["Title"]="Duyệt hồ sơ";var subjects=(List<MonHoc>)ViewBag.Subjects;var files=(List<TepDinhKem>)ViewBag.Certificates;}
<div class="heading"><h1>@Model.HoTen</h1><span class="badge @(Model.TrangThaiDuyet=="DaDuyet"?"badge-success":Model.TrangThaiDuyet is "ChoDuyet" or "CanChinhSua" or "TuChoi"?"badge-warning":"")">@Rules.Label(Model.TrangThaiDuyet)</span></div>
<article class="card"><dl><dt>Trình độ</dt><dd>@Model.TrinhDo</dd><dt>Chuyên môn</dt><dd>@Model.ChuyenMon</dd><dt>Kinh nghiệm</dt><dd>@Model.KinhNghiem</dd><dt>Khu vực</dt><dd>@Model.KhuVuc</dd><dt>Hình thức</dt><dd>@(Model.DayTrucTuyen?"Trực tuyến ":"") @(Model.DayTrucTiep?"Trực tiếp":"")</dd></dl><h2>Giới thiệu</h2><p class="pre">@Model.MoTa</p><h2>Môn dạy</h2>@foreach(var d in Model.MonDay){<p>@subjects.FirstOrDefault(x=>x.Id==d.MonHocId)?.TenMon · @d.PhamViDay · @Rules.Fee(d.HocPhiDeXuat,d.DonViHocPhi)</p>}<h2>Minh chứng riêng tư</h2>@foreach(var f in files){<a class="file" href="/NhuCau/HoSoGiaSu/BangCap/@f.Id">@f.TenGoc</a>}@if(files.Count==0){<p>Chưa có minh chứng đính kèm.</p>}</article>
@if(Model.TrangThaiDuyet=="ChoDuyet"){<form method="post" asp-action="Duyet" class="card"><input name="id" value="@ViewBag.Id" type="hidden"><input name="rowVersion" value="@Model.RowVersion" type="hidden"><label>Lý do yêu cầu chỉnh sửa<textarea class="form-control" name="reason" maxlength="2000" placeholder="Bắt buộc khi yêu cầu chỉnh sửa"></textarea></label><div class="actions"><button class="btn btn-primary" name="approve" value="true">Duyệt toàn bộ hồ sơ</button><button class="btn btn-outline-primary" name="approve" value="false">Yêu cầu chỉnh sửa</button></div></form>}

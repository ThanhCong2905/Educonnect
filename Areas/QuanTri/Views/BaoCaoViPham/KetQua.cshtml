@model KetQuaKiemDuyetViewModel
@{ViewData["Title"]="Kết quả xử lý";}
<h1>Kết quả xử lý</h1>
<article class="card">
    <span class="badge rounded-pill">@Rules.Label(Model.TrangThai)</span>
    <h2>@Rules.Label(Model.KetQua)</h2>
    <p class="pre">@Model.KetLuan</p>
    @if(Model.TrangThai=="DaXuLy")
    {
        <details><summary>Đề nghị xem lại</summary>
            <form method="post" asp-action="BoSung" class="mt-3">
                <input name="id" value="@Model.BaoCaoId" type="hidden">
                <input name="rowVersion" value="@Model.RowVersion" type="hidden">
                <input name="xemLai" value="true" type="hidden">
                <label>Căn cứ đề nghị xem lại <span class="required-mark" aria-hidden="true">*</span><textarea class="form-control" name="text" maxlength="2000" required rows="4"></textarea></label>
                <button class="btn btn-outline-primary mt-3">Gửi đề nghị</button>
            </form>
        </details>
    }
    <a class="mt-3" asp-action="KiemDuyet">Các biện pháp liên quan</a>
</article>

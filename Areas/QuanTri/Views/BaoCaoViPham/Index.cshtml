@model Page<BaoCaoViPham>
@{ViewData["Title"]=ViewBag.QuanTri is true?"Xử lý báo cáo":"Báo cáo của tôi";var admin=ViewBag.QuanTri is true;}
<h1>@ViewData["Title"]</h1>
<form method="get" class="card"><input name="quanTri" value="@admin.ToString().ToLowerInvariant()" type="hidden"><div class="row g-3 align-items-end"><div class="col-md-6"><label>Tìm báo cáo<input class="form-control" name="q" value="@Context.Request.Query["q"]" maxlength="100"></label></div><div class="col-md-4"><label>Trạng thái<select class="form-select" name="state"><option value="">Tất cả</option>@foreach(var s in new[]{"ChoXuLy","DangXuLy","DaXuLy"}){<option value="@s" selected="@(Context.Request.Query["state"]==s)">@Rules.Label(s)</option>}</select></label></div><div class="col-md-2"><button class="btn btn-primary">Tìm kiếm</button></div></div></form>
<div class="stack">@foreach(var r in Model.Items){<a class="card" asp-action="ChiTiet" asp-route-maBaoCao="@r.Id"><div class="heading"><span class="badge rounded-pill">@Rules.Label(r.TrangThai)</span><small>@Rules.Date(r.GuiLuc)</small></div><h2>@r.LyDo</h2><p class="muted">@Rules.Label(r.LoaiDoiTuong) @(r.KetQua==null?"":"· "+Rules.Label(r.KetQua))</p></a>}</div>
@if(Model.Items.Count==0){<div class="empty">Chưa có báo cáo phù hợp.</div>}
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.Trang,Model.Total)"/>

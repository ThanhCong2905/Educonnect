@model Page<BienPhapQuanTri>
@{ViewData["Title"]="Biện pháp kiểm duyệt";}
<h1>Biện pháp kiểm duyệt</h1>
<form method="get" class="card"><div class="actions"><label>Loại đối tượng<select name="loai" class="form-select"><option value="">Tất cả</option>@foreach(var t in new[]{"TaiKhoan","HoSoGiaSu","NhuCauHoc","TinNhan","DanhGiaDoiTac","LopHoc"}){<option value="@t" selected="@(Context.Request.Query["loai"]==t)">@Rules.Label(t)</option>}</select></label><label>Hiệu lực<select name="conHieuLuc" class="form-select"><option value="true">Đang hiệu lực</option><option value="false" selected="@(Context.Request.Query["conHieuLuc"]=="false")">Toàn bộ</option></select></label><button class="btn btn-primary">Lọc</button></div></form>
@foreach(var b in Model.Items){<article class="card mb-3"><div class="heading"><h2>@Rules.Label(b.LoaiDoiTuong)</h2><span class="badge rounded-pill">@(b.GoLuc==null?"Đang hiệu lực":"Đã gỡ")</span></div><p>@b.LyDo</p><small>@Rules.Date(b.ApDungLuc)</small>@if(b.BaoCaoId!=null){<a href="/QuanTri/BaoCaoViPham/ChiTiet?maBaoCao=@b.BaoCaoId">Báo cáo liên quan</a>}@if(b.GoLuc==null&&b.NguonBienPhapId==null){<details class="mt-3"><summary>Gỡ biện pháp</summary><form method="post" asp-action="GoBienPhap" class="mt-2"><input name="id" value="@b.Id" type="hidden"><input name="rowVersion" value="@Convert.ToBase64String(b.RowVersion)" type="hidden"><label>Lý do <span class="required-mark" aria-hidden="true">*</span><input name="reason" maxlength="2000" class="form-control" required></label><button class="btn btn-outline-primary mt-3">Xác nhận gỡ</button></form></details>}</article>}
@if(Model.Items.Count==0){<div class="empty">Chưa có biện pháp phù hợp.</div>}
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.Trang,Model.Total)"/>

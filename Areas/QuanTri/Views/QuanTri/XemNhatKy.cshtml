@model Page<NhatKyQuanTriRow>
@{ViewData["Title"]="Nhật ký quản trị";}
<h1>Nhật ký quản trị</h1>
<form method="get" class="card"><div class="row g-3 align-items-end"><div class="col-md-5"><label>Hành động hoặc đối tượng<input name="q" class="form-control" maxlength="100" value="@Context.Request.Query["q"]"></label></div><div class="col-md-3"><label>Từ ngày<input type="date" name="tuNgay" class="form-control" value="@Context.Request.Query["tuNgay"]"></label></div><div class="col-md-3"><label>Đến ngày<input type="date" name="denNgay" class="form-control" value="@Context.Request.Query["denNgay"]"></label></div><div class="col-md-1"><button class="btn btn-primary">Lọc</button></div></div></form>
<div class="table-responsive card"><table class="table"><thead><tr><th>Thời điểm</th><th>Người thực hiện</th><th>Hành động</th><th>Loại đối tượng</th><th>Kết quả</th><th>Mã tham chiếu</th></tr></thead><tbody>@foreach(var row in Model.Items){var n=row.BanGhi;<tr><td>@Rules.Date(n.ThoiDiem)</td><td>@row.HoTen</td><td>@Rules.Label(n.HanhDong)@if(n.ChiTiet!=null){<details class="mt-2"><summary>Chi tiết thay đổi</summary><p class="pre mt-2">@n.ChiTiet</p></details>}</td><td>@n.LoaiDoiTuong</td><td>@Rules.Label(n.KetQua)</td><td><small>@n.MaLienKetYeuCau</small></td></tr>}</tbody></table></div>
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.Trang,Model.Total)"/>

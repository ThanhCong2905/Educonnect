@model Page<NhatKyQuanTriRow>
@{ViewData["Title"]="Nhật ký quản trị";}
<h1>Nhật ký quản trị</h1>
<nav class="actions mb-3" aria-label="Loại nhật ký"><a class="btn btn-outline-primary" asp-action="NhatKyAnToan">An toàn AAA</a><span class="btn btn-primary" aria-current="page">Thao tác quản trị</span></nav>
<form method="get" class="card"><div class="row g-3 align-items-end"><div class="col-md-5"><label>Hành động hoặc đối tượng<input name="q" class="form-control" maxlength="100" value="@Context.Request.Query["q"]"></label></div><div class="col-md-3"><label>Từ ngày<input type="date" name="tuNgay" class="form-control" value="@Context.Request.Query["tuNgay"]"></label></div><div class="col-md-3"><label>Đến ngày<input type="date" name="denNgay" class="form-control" value="@Context.Request.Query["denNgay"]"></label></div><div class="col-md-1"><button class="btn btn-primary">Lọc</button></div></div></form>
@if (Model.Items.Count == 0)
{
    <p class="empty">Không tìm thấy thao tác quản trị.</p>
}
else
{
    <div class="table-responsive card">
        <table class="table table-striped admin-log">
            <thead><tr><th>Thời điểm</th><th>Người thực hiện</th><th>Thao tác</th><th>Kết quả</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Items)
            {
                var item = row.BanGhi;
                <tr>
                    <td data-label="Thời điểm"><time datetime="@item.ThoiDiem.ToString("O")">@Rules.Date(item.ThoiDiem)</time></td>
                    <td data-label="Người thực hiện">@row.HoTen</td>
                    <td data-label="Thao tác"><strong>@Rules.Label(item.HanhDong)</strong>
                        <details>
                            <summary>Xem chi tiết</summary>
                            <p>Đối tượng · @item.LoaiDoiTuong</p>
                            @if (!string.IsNullOrWhiteSpace(item.ChiTiet)) { <p class="pre">@item.ChiTiet</p> }
                            <small>Mã tham chiếu · @item.MaLienKetYeuCau</small>
                        </details>
                    </td>
                    <td data-label="Kết quả"><span class="admin-state" data-state="@item.KetQua">@Rules.Label(item.KetQua)</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.Trang,Model.Total)"/>

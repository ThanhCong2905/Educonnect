@model TaiKhoanQuanTriPage
@{ViewData["Title"]="Quản lý tài khoản";}
<h1>Quản lý tài khoản</h1>
<form method="get" class="card"><div class="row g-3 align-items-end"><div class="col-md-5"><label>Tên hoặc email<input name="q" maxlength="100" value="@Context.Request.Query["q"]" class="form-control"></label></div><div class="col-md-3"><label>Vai trò<select name="role" class="form-select"><option value="">Tất cả</option>@foreach(var r in new[]{"HocSinh","PhuHuynh","GiaSu","QuanTri"}){<option value="@r" selected="@(Context.Request.Query["role"]==r)">@Rules.Label(r)</option>}</select></label></div><div class="col-md-2"><label>Trạng thái<select name="state" class="form-select"><option value="">Tất cả</option><option value="HoatDong" selected="@(Context.Request.Query["state"]=="HoatDong")">Hoạt động</option><option value="BiKhoa" selected="@(Context.Request.Query["state"]=="BiKhoa")">Bị khóa</option></select></label></div><div class="col-md-2"><button class="btn btn-primary">Tìm kiếm</button></div></div></form>
<div class="table-responsive card"><table class="table align-middle"><thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var u in Model.DanhSach.Items){<tr><td><strong>@u.HoTen</strong><small class="d-block muted">@u.Email</small></td><td>@Rules.Label(Model.VaiTro.GetValueOrDefault(u.Id))</td><td>@Rules.Label(u.TrangThai)</td><td><a asp-action="ChiTiet" asp-route-id="@u.Id">Chi tiết</a></td></tr>}</tbody></table></div>
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.DanhSach.Trang,Model.DanhSach.Total)"/>

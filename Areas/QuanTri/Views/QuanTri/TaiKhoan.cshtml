@model TaiKhoanQuanTriPage
@{ViewData["Title"]="Quản lý tài khoản";}
<div class="heading admin-heading"><div><h1>Quản lý tài khoản</h1><p class="muted mb-0">@Model.DanhSach.Total tài khoản</p></div></div>
<form method="get" class="card"><div class="row g-3 align-items-end"><div class="col-md-5"><label>Tên hoặc email<input name="q" maxlength="100" value="@Context.Request.Query["q"]" class="form-control"></label></div><div class="col-md-3"><label>Vai trò<select name="role" class="form-select"><option value="">Tất cả</option>@foreach(var r in new[]{"HocSinh","PhuHuynh","GiaSu","QuanTri"}){<option value="@r" selected="@(Context.Request.Query["role"]==r)">@Rules.Label(r)</option>}</select></label></div><div class="col-md-2"><label>Trạng thái<select name="state" class="form-select"><option value="">Tất cả</option><option value="HoatDong" selected="@(Context.Request.Query["state"]=="HoatDong")">Hoạt động</option><option value="BiKhoa" selected="@(Context.Request.Query["state"]=="BiKhoa")">Bị khóa</option></select></label></div><div class="col-md-2"><button class="btn btn-primary">Tìm kiếm</button></div></div></form>
@if (Model.DanhSach.Items.Count == 0)
{
    <div class="empty"><h2>Không tìm thấy tài khoản</h2><a class="btn btn-outline-primary" asp-action="TaiKhoan">Xóa bộ lọc</a></div>
}
else
{
    <div class="card admin-account-list"><table class="table align-middle mb-0"><thead><tr><th scope="col">Tài khoản</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>
    @foreach (var u in Model.DanhSach.Items)
    {
        var avatar = new EduConnect.Mvc.ViewModels.AnhDaiDienViewModel(u.HoTen, string.IsNullOrWhiteSpace(u.AnhDaiDien) ? null : $"/TaiKhoan/Anh/{u.Id}", false);
        <tr><td><div class="admin-account-person"><partial name="_AnhDaiDien" model="avatar" /><div><strong>@u.HoTen</strong><small class="muted">@u.Email</small></div></div></td>
        <td data-label="Vai trò">@Rules.Label(Model.VaiTro.GetValueOrDefault(u.Id))</td><td data-label="Trạng thái"><span class="admin-state" data-state="@u.TrangThai">@Rules.Label(u.TrangThai)</span></td><td><a class="btn btn-outline-primary btn-sm" asp-action="ChiTiet" asp-route-id="@u.Id" aria-label="Xem tài khoản @u.HoTen">Chi tiết</a></td></tr>
    }
    </tbody></table></div>
}
<partial name="_PhanTrang" model="new PhanTrangViewModel(Model.DanhSach.Trang,Model.DanhSach.Total)"/>

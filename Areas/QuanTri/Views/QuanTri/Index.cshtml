@model QuanTriDashboard
@inject QuyenQuanTriService Rights
@{
    ViewData["Title"] = "Tổng quan quản trị";
    var review = await Rights.CoQuyenAsync("DuyetHoSo");
    var reports = await Rights.CoQuyenAsync("XuLyBaoCao");
    var accounts = await Rights.CoQuyenAsync("QuanLyTaiKhoan");
    var audit = await Rights.CoQuyenAsync("XemNhatKy");
    var states = new[] { "ChoDuyet", "CanChinhSua", "DaDuyet", "TuChoi" };
    var maximum = Math.Max(1, states.Max(state => Model.HoSoTheoTrangThai.GetValueOrDefault(state)));
}
<div class="admin-dashboard">
    <div class="heading admin-overview-heading"><div><span class="admin-eyebrow">Quản trị EduConnect</span><h1>Tổng quan</h1></div><time datetime="@DateTimeOffset.UtcNow.ToString("O")">@DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</time></div>
    <div class="admin-metrics">
        @if (review)
        {
            <a class="admin-metric" asp-controller="HoSo" asp-action="Index">
                <span class="admin-metric-icon"><img src="/images/ui/person-badge.svg" alt=""></span>
                <span>Hồ sơ chờ duyệt</span><strong>@Model.HoSoChoDuyet</strong>
            </a>
        }
        @if (reports)
        {
            <a class="admin-metric" asp-controller="BaoCaoViPham" asp-action="Index" asp-route-quanTri="true" asp-route-state="ChuaXuLy">
                <span class="admin-metric-icon metric-amber"><img src="/images/ui/flag.svg" alt=""></span>
                <span>Báo cáo chưa xử lý</span><strong>@Model.BaoCaoChoXuLy</strong>
            </a>
        }
        @if (accounts)
        {
            <a class="admin-metric" asp-action="TaiKhoan" asp-route-state="BiKhoa">
                <span class="admin-metric-icon metric-lavender"><img src="/images/ui/shield-check.svg" alt=""></span>
                <span>Tài khoản bị khóa</span><strong>@Model.TaiKhoanBiKhoa</strong>
            </a>
            <div class="admin-metric">
                <span class="admin-metric-icon metric-mint"><img src="/images/ui/collection.svg" alt=""></span>
                <span>Lớp đang tạm dừng</span><strong>@Model.LopTamDung</strong>
            </div>
        }
    </div>
    @if (!review && !reports && !accounts && !audit)
    {
        <p class="empty">Các mục quản trị được hiển thị theo quyền của tài khoản.</p>
    }
    @if (review || reports)
    {
        <section class="admin-workspace" aria-labelledby="admin-work-title">
            <div class="heading"><h2 id="admin-work-title">Hàng chờ xử lý</h2><span class="muted">Yêu cầu cũ hiển thị trước</span></div>
            <div class="admin-work-queues">
                @if (review)
                {
                    <section class="card admin-queue" aria-labelledby="profile-queue-title">
                        <div class="admin-panel-heading"><h3 id="profile-queue-title">Duyệt hồ sơ <span class="admin-count">@Model.HoSoChoDuyet</span></h3><a class="btn btn-outline-primary btn-sm" asp-controller="HoSo" asp-action="Index">Xem tất cả</a></div>
                        @if (Model.HoSoCanDuyet.Count == 0) { <div class="admin-queue-empty"><img src="/images/ui/person-badge.svg" alt=""><strong>Không có hồ sơ chờ duyệt</strong></div> }
                        else
                        {
                            <ol class="admin-work-list">
                                @foreach (var item in Model.HoSoCanDuyet)
                                {
                                    <li><a class="admin-work-link" asp-controller="HoSo" asp-action="ChiTiet" asp-route-id="@item.Id"><span class="admin-work-icon" aria-hidden="true"><img src="/images/ui/person-badge.svg" alt=""></span><span class="admin-work-copy"><strong>@item.HoTen</strong><span>@item.TrinhDo</span><time datetime="@item.GuiLuc?.ToString("O")">@Rules.Date(item.GuiLuc)</time></span><span class="admin-work-arrow" aria-hidden="true">→</span></a></li>
                                }
                            </ol>
                        }
                    </section>
                }
                @if (reports)
                {
                    <section class="card admin-queue" aria-labelledby="report-queue-title">
                        <div class="admin-panel-heading"><h3 id="report-queue-title">Báo cáo <span class="admin-count">@Model.BaoCaoChoXuLy</span></h3><a class="btn btn-outline-primary btn-sm" asp-controller="BaoCaoViPham" asp-action="Index" asp-route-quanTri="true" asp-route-state="ToiDangXuLy">Tôi phụ trách</a></div>
                        @if (Model.BaoCaoCanXuLy.Count == 0) { <div class="admin-queue-empty"><img src="/images/ui/flag.svg" alt=""><strong>Không có báo cáo đang chờ</strong></div> }
                        else
                        {
                            <ol class="admin-work-list">
                                @foreach (var item in Model.BaoCaoCanXuLy)
                                {
                                    <li><a class="admin-work-link" asp-controller="BaoCaoViPham" asp-action="ChiTiet" asp-route-maBaoCao="@item.Id"><span class="admin-work-copy"><strong>@item.LyDo</strong><span>Người gửi: @item.NguoiGui</span><span>Phụ trách: @(item.PhuTrach ?? "Chưa tiếp nhận")</span><time datetime="@item.GuiLuc.ToString("O")">@Rules.Date(item.GuiLuc)</time></span><span class="admin-work-end"><span class="admin-state" data-state="@item.TrangThai">@Rules.Label(item.TrangThai)</span><span class="admin-work-arrow" aria-hidden="true">→</span></span></a></li>
                                }
                            </ol>
                        }
                    </section>
                }
            </div>
        </section>
    }
    @if (reports) { <partial name="_NhuCauCanXemXet" model="Model.CanXemXet" /> }
    @if (accounts || reports) { <div class="heading admin-section-heading"><h2>Thống kê</h2><span class="muted">6 tháng gần nhất</span></div> }
    <div class="admin-charts">
        @if (accounts) { <partial name="_DangKyTheoThang" model="Model.DangKy" /> }
        @if (reports) { <partial name="_PhanLoaiBaoCao" model="Model.PhanLoaiBaoCao" /> }
    </div>
    <div class="admin-panels">
        @if (review)
        {
            <section class="card admin-panel">
                <h2>Hồ sơ theo trạng thái</h2>
                <ul class="admin-bars">
                    @foreach (var state in states)
                    {
                        var count = Model.HoSoTheoTrangThai.GetValueOrDefault(state);
                        <li data-state="@state"><a asp-controller="HoSo" asp-action="Index" asp-route-state="@state">@Rules.Label(state)</a>
                            <meter min="0" max="@maximum" value="@count" aria-label="@Rules.Label(state)"></meter><strong>@count</strong></li>
                    }
                </ul>
            </section>
        }
        @if (audit)
        {
            <section class="card admin-panel">
                <div class="admin-panel-heading"><h2>Hoạt động gần đây</h2><a class="btn btn-outline-primary" asp-action="XemNhatKy">Xem nhật ký</a></div>
                @if (Model.GanDay.Count == 0)
                {
                    <p class="admin-empty">Chưa có thao tác quản trị.</p>
                }
                else
                {
                    <ol class="admin-events">
                        @foreach (var row in Model.GanDay)
                        {
                            var entry = row.BanGhi;
                            <li><span class="admin-event-icon" aria-hidden="true"><img src="/images/ui/clock-history.svg" alt=""></span>
                                <div><strong>@Rules.Label(entry.HanhDong)</strong><p>@row.HoTen · <time datetime="@entry.ThoiDiem.ToString("O")">@Rules.Date(entry.ThoiDiem)</time></p></div>
                                <span class="admin-state" data-state="@entry.KetQua">@Rules.Label(entry.KetQua)</span>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </div>
</div>
